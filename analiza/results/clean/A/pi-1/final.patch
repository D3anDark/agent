diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..d7e47e6
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,35 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (path === undefined) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort(
+  ([nameA, totalA], [nameB, totalB]) => totalB - totalA || compareNames(nameA, nameB),
+);
+let grandTotal = 0;
+const lines: string[] = [];
+for (const [category, total] of entries) {
+  grandTotal += total;
+  lines.push(`${category}\t${formatCents(total)}`);
+}
+lines.push(`TOTAL\t${formatCents(grandTotal)}`);
+console.log(lines.join("\n"));
+if (skipped > 0) console.error(`skipped: ${skipped}`);
+
+function compareNames(a: string, b: string): number {
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
