+const AMOUNT = /^(-?)(\d+|\d{1,3}(?:,\d{3})+)(?:\.(\d{1,2}))?$/;
+
 export function parseAmount(raw: string): number {
-  const value = parseFloat(raw);
-  return Math.floor(value * 100);
+  const m = AMOUNT.exec(raw);
+  if (!m) throw new Error(`invalid amount: ${raw}`);
+  const cents = Number(m[2].replaceAll(",", "")) * 100 + Number((m[3] ?? "").padEnd(2, "0"));
+  return m[1] && cents !== 0 ? -cents : cents;
 }
 
 export function formatCents(cents: number): string {
-  return (cents / 100).toFixed(2);
+  const abs = Math.abs(cents);
+  const frac = String(abs % 100).padStart(2, "0");
+  return `${cents < 0 ? "-" : ""}${Math.floor(abs / 100)}.${frac}`;
 }
