+/**
+ * RFC 4180 CSV parser. Accepts LF or CRLF line endings and an optional trailing
+ * line break. Completely empty lines are omitted from the result.
+ */
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let quoted = false; // current record contained any quoted field
+  let i = 0;
+  const n = text.length;
+
+  const endRow = () => {
+    row.push(field);
+    const blank = row.length === 1 && row[0] === "" && !quoted;
+    if (!blank) rows.push(row);
+    row = [];
+    field = "";
+    quoted = false;
+  };
+
+  while (i < n) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i += 2;
+          continue;
+        }
+        inQuotes = false;
+        i++;
+        continue;
+      }
+      field += ch;
+      i++;
+      continue;
+    }
+    if (ch === '"' && field === "") {
+      inQuotes = true;
+      quoted = true;
+      i++;
+      continue;
+    }
+    if (ch === ",") {
+      row.push(field);
+      field = "";
+      i++;
+      continue;
+    }
+    if (ch === "\r" && text[i + 1] === "\n") {
+      endRow();
+      i += 2;
+      continue;
+    }
+    if (ch === "\n") {
+      endRow();
+      i++;
+      continue;
+    }
+    field += ch;
+    i++;
+  }
+  if (field !== "" || row.length > 0 || quoted) endRow();
+  return rows;
 }
diff --git a/src/money.ts b/src/money.ts
index 033b120..c28a3f5 100644
--- a/src/money.ts
+++ b/src/money.ts
@@ -1,8 +1,22 @@
+const AMOUNT_RE = /^(-?)(\d+|\d{1,3}(?:,\d{3})+)(?:\.(\d{1,2}))?$/;
+
+/** Parse an amount string into exact integer cents. Throws on invalid input. */
 export function parseAmount(raw: string): number {
-  const value = parseFloat(raw);
-  return Math.floor(value * 100);
+  if (typeof raw !== "string") throw new Error(`invalid amount: ${raw}`);
+  const m = AMOUNT_RE.exec(raw);
+  if (!m) throw new Error(`invalid amount: ${raw}`);
+  const [, sign, intPart, frac = ""] = m;
+  const cents = BigInt(intPart.replace(/,/g, "")) * 100n + BigInt(frac.padEnd(2, "0") || "0");
+  const value = Number(cents);
+  if (!Number.isSafeInteger(value)) throw new Error(`amount out of range: ${raw}`);
+  return sign === "-" && value !== 0 ? -value : value;
 }
 
+/** Format integer cents as a decimal string with exactly 2 fraction digits. */
 export function formatCents(cents: number): string {
-  return (cents / 100).toFixed(2);
+  const neg = cents < 0;
+  const abs = BigInt(Math.abs(Math.trunc(cents)));
+  const whole = abs / 100n;
+  const frac = (abs % 100n).toString().padStart(2, "0");
+  return `${neg ? "-" : ""}${whole}.${frac}`;
 }
