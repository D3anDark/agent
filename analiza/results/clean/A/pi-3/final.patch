diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..2cc00cc
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,30 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (path === undefined) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let csvText: string;
+try {
+  csvText = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(csvText);
+const lines = [...totals].sort(([nameA, totalA], [nameB, totalB]) => {
+  if (totalA !== totalB) return totalB - totalA;
+  if (nameA === nameB) return 0;
+  return nameA < nameB ? -1 : 1;
+});
+let grandTotal = 0;
+for (const [category, total] of lines) {
+  console.log(`${category}\t${formatCents(total)}`);
+  grandTotal += total;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
