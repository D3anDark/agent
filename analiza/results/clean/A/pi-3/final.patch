index 897c73d..1a88c97 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,46 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let i = 0;
+
+  const endRow = () => {
+    row.push(field);
+    const isBlankLine = row.length === 1 && row[0] === "";
+    if (!isBlankLine) rows.push(row);
+    row = [];
+    field = "";
+  };
+
+  while (i < text.length) {
+    const char = text[i];
+    if (inQuotes) {
+      if (char === '"' && text[i + 1] === '"') {
+        field += '"';
+        i += 2;
+        continue;
+      }
+      if (char === '"') inQuotes = false;
+      else field += char;
+      i++;
+      continue;
+    }
+    if (char === '"') {
+      inQuotes = true;
+    } else if (char === ",") {
+      row.push(field);
+      field = "";
+    } else if (char === "\n") {
+      endRow();
+    } else if (char === "\r" && text[i + 1] === "\n") {
+      endRow();
+      i++;
+    } else {
+      field += char;
+    }
+    i++;
+  }
+  if (field !== "" || row.length > 0) endRow();
+  return rows;
 }
