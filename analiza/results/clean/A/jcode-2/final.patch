diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..5f59298
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,33 @@
+import { readFileSync } from "node:fs";
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (path === undefined) {
+  process.stderr.write("usage: bun src/cli.ts <file.csv>\n");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = readFileSync(path, "utf8");
+} catch {
+  process.stderr.write(`error: cannot read ${path}\n`);
+  process.exit(1);
+}
+if (text.charCodeAt(0) === 0xfeff) text = text.slice(1);
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals.entries()].sort((a, b) =>
+  b[1] !== a[1] ? b[1] - a[1] : a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0,
+);
+let grand = 0;
+let out = "";
+for (const [category, total] of entries) {
+  grand += total;
+  out += `${category}\t${formatCents(total)}\n`;
+}
+out += `TOTAL\t${formatCents(grand)}\n`;
+process.stdout.write(out);
+if (skipped > 0) process.stderr.write(`skipped: ${skipped}\n`);
+process.exit(0);
