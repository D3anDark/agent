+/**
+ * RFC 4180 CSV parser. Accepts LF or CRLF line endings, quoted fields with
+ * embedded commas, line breaks and escaped quotes (""). Completely empty lines
+ * (including a trailing line break at end of file) produce no record.
+ */
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let sawQuote = false; // current record contained a quoted field
+  let i = 0;
+  const n = text.length;
+
+  const endRecord = () => {
+    row.push(field);
+    // Skip blank lines: a single empty, unquoted field.
+    if (!(row.length === 1 && row[0] === "" && !sawQuote)) rows.push(row);
+    row = [];
+    field = "";
+    sawQuote = false;
+  };
+
+  while (i < n) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i += 2;
+          continue;
+        }
+        inQuotes = false;
+        i++;
+        continue;
+      }
+      field += ch;
+      i++;
+      continue;
+    }
+    if (ch === '"') {
+      inQuotes = true;
+      sawQuote = true;
+      i++;
+    } else if (ch === ",") {
+      row.push(field);
+      field = "";
+      i++;
+    } else if (ch === "\r" && text[i + 1] === "\n") {
+      endRecord();
+      i += 2;
+    } else if (ch === "\n") {
+      endRecord();
+      i++;
+    } else {
+      field += ch;
+      i++;
+    }
+  }
+  if (field !== "" || row.length > 0 || sawQuote) endRecord();
+  return rows;
 }
diff --git a/src/money.ts b/src/money.ts
