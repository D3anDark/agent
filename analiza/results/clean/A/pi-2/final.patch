diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..659976f
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,35 @@
+import { readFileSync } from "node:fs";
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (path === undefined) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = readFileSync(path, "utf8");
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const sorted = [...totals].sort(([nameA, totalA], [nameB, totalB]) => {
+  if (totalA !== totalB) return totalB - totalA;
+  if (nameA === nameB) return 0;
+  return nameA < nameB ? -1 : 1;
+});
+
+let grandTotal = 0;
+const lines: string[] = [];
+for (const [category, total] of sorted) {
+  lines.push(`${category}\t${formatCents(total)}`);
+  grandTotal += total;
+}
+lines.push(`TOTAL\t${formatCents(grandTotal)}`);
+console.log(lines.join("\n"));
+
+if (skipped > 0) console.error(`skipped: ${skipped}`);
