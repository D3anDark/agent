diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..4f7f4f2
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,25 @@
+import { readFileSync } from "node:fs";
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+let text: string;
+try {
+  text = readFileSync(path, "utf8");
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0));
+let grand = 0;
+const out = entries.map(([cat, cents]) => {
+  grand += cents;
+  return `${cat}\t${formatCents(cents)}\n`;
+});
+process.stdout.write(out.join("") + `TOTAL\t${formatCents(grand)}\n`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
