+// Port of node-semver v7 range semantics (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_INTEGER = Number.MAX_SAFE_INTEGER;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+const LETTERDASHNUMBER = "[a-zA-Z0-9-]";
+
+function makeSafe(value: string): string {
+  const reps: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    [LETTERDASHNUMBER, MAX_SAFE_BUILD_LENGTH],
+  ];
+  for (const [token, max] of reps) {
+    value = value
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return value;
+}
+
+const NUMERICIDENTIFIER = "0|[1-9]\\d*";
+const NUMERICIDENTIFIERLOOSE = "\\d+";
+const NONNUMERICIDENTIFIER = `\\d*[a-zA-Z-]${LETTERDASHNUMBER}*`;
+const MAINVERSION = `(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})`;
+const MAINVERSIONLOOSE = `(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASEIDENTIFIER = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIER})`;
+const PRERELEASEIDENTIFIERLOOSE = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASEIDENTIFIER}(?:\\.${PRERELEASEIDENTIFIER})*))`;
+const PRERELEASELOOSE = `(?:-?(${PRERELEASEIDENTIFIERLOOSE}(?:\\.${PRERELEASEIDENTIFIERLOOSE})*))`;
+const BUILDIDENTIFIER = `${LETTERDASHNUMBER}+`;
+const BUILD = `(?:\\+(${BUILDIDENTIFIER}(?:\\.${BUILDIDENTIFIER})*))`;
+const FULLPLAIN = `v?${MAINVERSION}${PRERELEASE}?${BUILD}?`;
+const FULL = `^${FULLPLAIN}$`;
+const LOOSEPLAIN = `[v=\\s]*${MAINVERSIONLOOSE}${PRERELEASELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGEIDENTIFIER = `${NUMERICIDENTIFIER}|x|X|\\*`;
+const XRANGEPLAIN =
+  `[v=\\s]*(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:${PRERELEASE})?${BUILD}?` +
+  `)?)?`;
+const XRANGE = `^${GTLT}\\s*${XRANGEPLAIN}$`;
+const LONETILDE = "(?:~>?)";
+const TILDETRIM = `(\\s*)${LONETILDE}\\s+`;
+const TILDE = `^${LONETILDE}${XRANGEPLAIN}$`;
+const LONECARET = "(?:\\^)";
+const CARETTRIM = `(\\s*)${LONECARET}\\s+`;
+const CARET = `^${LONECARET}${XRANGEPLAIN}$`;
+const COMPARATOR = `^${GTLT}\\s*(${FULLPLAIN})$|^$`;
+const COMPARATORTRIM = `(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`;
+const HYPHENRANGE = `^\\s*(${XRANGEPLAIN})` + `\\s+-\\s+` + `(${XRANGEPLAIN})` + `\\s*$`;
+const STAR = "(<|>)?=?\\s*\\*";
+const GTE0 = "^\\s*>=\\s*0\\.0\\.0\\s*$";
+
+const re = (src: string, flags?: string) => new RegExp(makeSafe(src), flags);
+const RE = {
+  FULL: re(FULL),
+  BUILD: re(BUILD),
+  XRANGE: re(XRANGE),
+  TILDETRIM: re(TILDETRIM, "g"),
+  TILDE: re(TILDE),
+  CARETTRIM: re(CARETTRIM, "g"),
+  CARET: re(CARET),
+  COMPARATOR: re(COMPARATOR),
+  COMPARATORTRIM: re(COMPARATORTRIM, "g"),
+  HYPHENRANGE: re(HYPHENRANGE),
+  STAR: re(STAR),
+  GTE0: re(GTE0),
+};
+
+const numeric = /^[0-9]+$/;
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const anum = numeric.test(String(a));
+  const bnum = numeric.test(String(b));
+  if (anum && bnum) {
+    a = +a;
+    b = +b;
+  }
+  return a === b ? 0 : anum && !bnum ? -1 : bnum && !anum ? 1 : a < b ? -1 : 1;
+}
+
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: (string | number)[];
+
+  constructor(version: string) {
+    if (typeof version !== "string") throw new TypeError("Invalid version");
+    if (version.length > MAX_LENGTH) throw new TypeError("Version too long");
+    const m = version.trim().match(RE.FULL);
+    if (!m) throw new TypeError(`Invalid Version: ${version}`);
+    this.major = +m[1];
+    this.minor = +m[2];
+    this.patch = +m[3];
+    for (const n of [this.major, this.minor, this.patch]) {
+      if (n > MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version number");
+    }
+    this.prerelease = m[4]
+      ? m[4].split(".").map((id) => {
+          if (/^[0-9]+$/.test(id)) {
+            const num = +id;
+            if (num >= 0 && num < MAX_SAFE_INTEGER) return num;
+          }
+          return id;
+        })
+      : [];
+  }
+
+  compare(other: SemVer): number {
+    return this.compareMain(other) || this.comparePre(other);
+  }
+
+  compareMain(o: SemVer): number {
+    return (
+      compareIdentifiers(this.major, o.major) ||
+      compareIdentifiers(this.minor, o.minor) ||
+      compareIdentifiers(this.patch, o.patch)
+    );
+  }
+
+  comparePre(o: SemVer): number {
+    if (this.prerelease.length && !o.prerelease.length) return -1;
+    if (!this.prerelease.length && o.prerelease.length) return 1;
+    if (!this.prerelease.length && !o.prerelease.length) return 0;
+    let i = 0;
+    for (;;) {
+      const a = this.prerelease[i];
+      const b = o.prerelease[i];
+      if (a === undefined && b === undefined) return 0;
+      if (b === undefined) return 1;
+      if (a === undefined) return -1;
+      if (a !== b) return compareIdentifiers(a, b);
+      i++;
+    }
+  }
+}
+
+const ANY = Symbol("ANY");
+
+class Comparator {
+  operator: string;
+  semver: SemVer | typeof ANY;
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(RE.COMPARATOR);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined ? m[1] : "";
+    if (this.operator === "=") this.operator = "";
+    this.semver = m[2] ? new SemVer(m[2]) : ANY;
+    this.value = this.semver === ANY ? "" : this.operator + m[2];
+  }
+
+  test(v: SemVer): boolean {
+    if (this.semver === ANY) return true;
+    const c = v.compare(this.semver);
+    switch (this.operator) {
+      case "":
+        return c === 0;
+      case "<":
+        return c < 0;
+      case "<=":
+        return c <= 0;
+      case ">":
+        return c > 0;
+      case ">=":
+        return c >= 0;
+      default:
+        throw new TypeError(`Invalid operator: ${this.operator}`);
+    }
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function isNullSet(c: Comparator): boolean {
+  return c.value === "<0.0.0-0";
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(RE.CARET, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lo} <${M}.${m}.${+p + 1}-0`;
+      return `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(RE.TILDE, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(
+    RE.XRANGE,
+    (ret: string, gtlt: string, M: string, m: string | number, p: string | number) => {
+      const xM = isX(M);
+      const xm = xM || isX(m as string);
+      const xp = xm || isX(p as string);
+      const anyX = xp;
+      if (gtlt === "=" && anyX) gtlt = "";
+      let pr = "";
+      if (xM) {
+        ret = gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      } else if (gtlt && anyX) {
+        let Mn: string | number = M;
+        if (xm) m = 0;
+        p = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            Mn = +M + 1;
+            m = 0;
+            p = 0;
+          } else {
+            m = +m + 1;
+            p = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) Mn = +M + 1;
+          else m = +m + 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        ret = `${gtlt + Mn}.${m}.${p}${pr}`;
+      } else if (xm) {
+        ret = `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      } else if (xp) {
+        ret = `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      }
+      return ret;
+    },
+  );
+}
+
+function parseComparator(comp: string): string {
+  comp = comp.replace(RE.BUILD, "");
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  comp = comp.trim().replace(RE.STAR, "");
+  return comp;
+}
+
+function hyphenReplace(
+  _0: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseRange(range: string): Comparator[] {
+  range = range.trim();
+  range = range.replace(RE.HYPHENRANGE, hyphenReplace as any);
+  range = range.replace(RE.COMPARATORTRIM, "$1$2$3");
+  range = range.replace(RE.TILDETRIM, "$1~");
+  range = range.replace(RE.CARETTRIM, "$1^");
+  const rangeList = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(RE.GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const c of rangeList.map((s) => new Comparator(s))) {
+    if (isNullSet(c)) return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+class Range {
+  set: Comparator[][];
+
+  constructor(range: string) {
+    if (typeof range !== "string") throw new TypeError("Invalid range");
+    const raw = range.trim().split(/\s+/).join(" ");
+    this.set = raw
+      .split("||")
+      .map((r) => parseRange(r.trim()))
+      .filter((c) => c.length);
+    if (!this.set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  }
+
+  test(version: string): boolean {
+    if (!version) return false;
+    let v: SemVer;
+    try {
+      v = new SemVer(version);
+    } catch {
+      return false;
+    }
+    return this.set.some((s) => testSet(s, v));
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  for (const c of set) if (!c.test(version)) return false;
+  if (version.prerelease.length) {
+    for (const c of set) {
+      if (c.semver === ANY) continue;
+      const a = c.semver;
+      if (
+        a.prerelease.length > 0 &&
+        a.major === version.major &&
+        a.minor === version.minor &&
+        a.patch === version.patch
+      )
+        return true;
+    }
+    return false;
+  }
+  return true;
+}
+
