+import { expect, test } from "bun:test";
+import { maxSatisfying, satisfies } from "./semver";
+
+// Expected values checked against node-semver 7.
+test("range grammar edge cases", () => {
+  expect(satisfies("2.3.4", "1.2 - 2.3.4")).toBe(true);
+  expect(satisfies("2.3.5", "1.2 - 2.3.4")).toBe(false);
+  expect(satisfies("0.0.4", "^0.0.3")).toBe(false);
+  expect(satisfies("0.9.0", "^0.x")).toBe(true);
+  expect(satisfies("1.3.0", "~1.2")).toBe(false);
+  expect(satisfies("1.2.3-alpha.10", ">1.2.3-alpha.3")).toBe(true);
+  expect(satisfies("1.2.3", ">*")).toBe(false);
+  expect(satisfies("1.2.3", "foo")).toBe(false);
+  expect(satisfies("01.2.3", "*")).toBe(false);
+  expect(maxSatisfying(["1.2.3"], "1.2.3.4")).toBeNull();
+});
