+// Port of node-semver v7 range semantics (default options: not loose, no includePrerelease).
+const MAX_LENGTH = 256;
+const NUM = "0|[1-9]\\d*";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAINLOOSE = `(\\d+)\\.(\\d+)\\.(\\d+)`;
+const PREID = `(?:${NUM}|${NONNUM})`;
+const PREIDLOOSE = `(?:\\d+|${NONNUM})`;
+const PRE = `(?:-(${PREID}(?:\\.${PREID})*))`;
+const PRELOOSE = `(?:-?(${PREIDLOOSE}(?:\\.${PREIDLOOSE})*))`;
+const BUILD = `(?:\\+([a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*))`;
+const FULLPLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAINLOOSE}${PRELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XRID})(?:\\.(${XRID})(?:\\.(${XRID})(?:${PRE})?${BUILD}?)?)?`;
+
+const FULL = new RegExp(`^${FULLPLAIN}$`);
+const XRANGE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const TILDETRIM = new RegExp(`(\\s*)(?:~>?)\\s+`, "g");
+const TILDE = new RegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const CARETTRIM = new RegExp(`(\\s*)(?:\\^)\\s+`, "g");
+const CARET = new RegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const COMPARATOR = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const COMPARATORTRIM = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const HYPHENRANGE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const STAR = /(<|>)?=?\s*\*/;
+const GTE0 = /^\s*>=\s*0\.0\.0\s*$/;
+
+type Id = string | number;
+interface SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+}
+
+function parseVersion(v: string): SemVer {
+  if (v.length > MAX_LENGTH) throw new TypeError("too long");
+  const m = v.trim().match(FULL);
+  if (!m) throw new TypeError(`Invalid Version: ${v}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map(Number);
+  for (const n of [major, minor, patch]) if (n > Number.MAX_SAFE_INTEGER) throw new TypeError("too big");
+  const prerelease: Id[] = m[4]
+    ? m[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const n = +id;
+          if (n >= 0 && n < Number.MAX_SAFE_INTEGER) return n;
+        }
+        return id;
+      })
+    : [];
+  const version = `${major}.${minor}.${patch}` + (prerelease.length ? `-${prerelease.join(".")}` : "");
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIds(a: Id, b: Id): number {
+  const an = typeof a === "number" || /^[0-9]+$/.test(a);
+  const bn = typeof b === "number" || /^[0-9]+$/.test(b);
+  if (an && bn) {
+    a = +a;
+    b = +b;
+  }
+  return a === b ? 0 : an && !bn ? -1 : bn && !an ? 1 : a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main = compareIds(a.major, b.major) || compareIds(a.minor, b.minor) || compareIds(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    const c = compareIds(x, y);
+    if (c) return c;
+  }
+}
+
+interface Comparator {
+  operator: string;
+  semver: SemVer | null; // null = ANY
+  value: string;
+}
+
+function parseComparator(comp: string): Comparator {
+  comp = comp.trim().split(/\s+/).join(" ");
+  const m = comp.match(COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  let operator = m[1] ?? "";
+  if (operator === "=") operator = "";
+  const semver = m[2] ? parseVersion(m[2]) : null;
+  return { operator, semver, value: semver ? operator + semver.version : "" };
+}
+
+function testComparator(c: Comparator, v: SemVer): boolean {
+  if (!c.semver) return true;
+  const r = compare(v, c.semver);
+  switch (c.operator) {
+    case "":
+      return r === 0;
+    case ">":
+      return r > 0;
+    case ">=":
+      return r >= 0;
+    case "<":
+      return r < 0;
+    case "<=":
+      return r <= 0;
+  }
+  throw new TypeError(`Invalid operator: ${c.operator}`);
+}
+
+const isX = (id?: string) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return M === "0" ? `>=${M}.${m}.0 <${M}.${+m + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    const from = `>=${M}.${m}.${p}${pr ? `-${pr}` : ""}`;
+    if (M === "0") return m === "0" ? `${from} <${M}.${m}.${+p + 1}-0` : `${from} <${M}.${+m + 1}.0-0`;
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p}${pr ? `-${pr}` : ""} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(XRANGE, (ret, gtlt: string, M, m, p) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    let pr = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      if (xm) m = 0;
+      p = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          M = +M + 1;
+          m = 0;
+        } else m = +m + 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) M = +M + 1;
+        else m = +m + 1;
+      }
+      if (gtlt === "<") pr = "-0";
+      return `${gtlt + M}.${m}.${p}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+function hyphenReplace(_: string, from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function expand(comp: string): string {
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(STAR, "");
+}
+
+function parseSet(range: string): Comparator[] {
+  range = range.replace(HYPHENRANGE, hyphenReplace as any);
+  range = range.replace(COMPARATORTRIM, "$1$2$3");
+  range = range.replace(TILDETRIM, "$1~");
+  range = range.replace(CARETTRIM, "$1^");
+  const list = range.split(" ").map(expand).join(" ").split(/\s+/).map((c) => c.trim().replace(GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const c of list.map(parseComparator)) {
+    if (c.value === "<0.0.0-0") return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let set = raw.split("||").map((r) => parseSet(r.trim())).filter((c) => c.length);
+  if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (set.length > 1) {
+    const first = set[0];
+    set = set.filter((c) => c[0].value !== "<0.0.0-0");
+    if (!set.length) set = [first];
+    else if (set.length > 1) {
+      const any = set.find((c) => c.length === 1 && c[0].value === "");
+      if (any) set = [any];
+    }
+  }
+  return set;
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) => c.semver && c.semver.prerelease.length > 0 &&
+      c.semver.major === v.major && c.semver.minor === v.minor && c.semver.patch === v.patch,
+  );
+}
+
+function testRange(set: Comparator[][], version: string): boolean {
+  let v: SemVer;
+  try {
+    v = parseVersion(version);
+  } catch {
+    return false;
+  }
+  return set.some((s) => testSet(s, v));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  let set: Comparator[][];
+  try {
+    set = parseRange(range);
+  } catch {
+    return false;
+  }
+  return testRange(set, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  let set: Comparator[][];
+  try {
+    set = parseRange(range);
+  } catch {
+    return null;
+  }
+  let max: string | null = null;
+  let maxSV: SemVer | null = null;
+  for (const v of versions) {
+    if (!testRange(set, v)) continue;
+    const sv = parseVersion(v);
+    if (!maxSV || compare(maxSV, sv) === -1) {
+      max = v;
+      maxSV = sv;
+    }
+  }
+  return max;
 }
