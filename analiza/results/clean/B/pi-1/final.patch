+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+const LETTERDASHNUMBER = "[a-zA-Z0-9-]";
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = `\\d*[a-zA-Z-]${LETTERDASHNUMBER}*`;
+const MAIN_VERSION = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_VERSION_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRERELEASE_ID = `(?:${NON_NUMERIC}|${NUMERIC})`;
+const PRERELEASE_ID_LOOSE = `(?:${NON_NUMERIC}|${NUMERIC_LOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRERELEASE_ID_LOOSE}(?:\\.${PRERELEASE_ID_LOOSE})*))`;
+const BUILD_ID = `${LETTERDASHNUMBER}+`;
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN_VERSION}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_VERSION_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGE_ID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+const LONE_TILDE = "(?:~>?)";
+const LONE_CARET = "(?:\\^)";
+
+// node-semver bounds every quantifier to stop ReDoS; doing the same keeps edge-case results identical.
+function safeRegExp(source: string, flags?: string): RegExp {
+  const limits: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    [LETTERDASHNUMBER, MAX_SAFE_BUILD_LENGTH],
+  ];
+  let safe = source;
+  for (const [token, max] of limits) {
+    safe = safe.split(`${token}*`).join(`${token}{0,${max}}`);
+    safe = safe.split(`${token}+`).join(`${token}{1,${max}}`);
+  }
+  return new RegExp(safe, flags);
+}
+
+const FULL_RE = safeRegExp(`^${FULL_PLAIN}$`);
+const XRANGE_RE = safeRegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const TILDE_RE = safeRegExp(`^${LONE_TILDE}${XRANGE_PLAIN}$`);
+const TILDE_TRIM_RE = safeRegExp(`(\\s*)${LONE_TILDE}\\s+`, "g");
+const CARET_RE = safeRegExp(`^${LONE_CARET}${XRANGE_PLAIN}$`);
+const CARET_TRIM_RE = safeRegExp(`(\\s*)${LONE_CARET}\\s+`, "g");
+const COMPARATOR_RE = safeRegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const COMPARATOR_TRIM_RE = safeRegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const HYPHEN_RANGE_RE = safeRegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const STAR_RE = safeRegExp("(<|>)?=?\\s*\\*");
+const GTE0_RE = safeRegExp("^\\s*>=\\s*0\\.0\\.0\\s*$");
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+const NUMERIC_ID_RE = /^[0-9]+$/;
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+};
+
+const OPERATORS = ["", "<", "<=", ">", ">="] as const;
+type Operator = (typeof OPERATORS)[number];
+
+type Comparator = { operator: Operator; semver: SemVer } | "any";
+
+type ComparatorSet = Comparator[];
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const comparatorSets = parseRange(range);
+  const semver = parseVersion(version);
+  if (!comparatorSets || !semver) return false;
+  return comparatorSets.some((set) => testSet(set, semver));
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const comparatorSets = parseRange(range);
+  if (!comparatorSets) return null;
+  let max: { raw: string; semver: SemVer } | null = null;
+  for (const raw of versions) {
+    const semver = parseVersion(raw);
+    if (!semver || !comparatorSets.some((set) => testSet(set, semver))) continue;
+    if (!max || compare(max.semver, semver) === -1) max = { raw, semver };
+  }
+  return max?.raw ?? null;
+}
+
+function parseVersion(version: string): SemVer | null {
+  if (version.length > MAX_LENGTH) return null;
+  const match = version.trim().match(FULL_RE);
+  if (!match) return null;
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) return null;
+  const prerelease = match[4] ? match[4].split(".").map(toIdentifier) : [];
+  return { major, minor, patch, prerelease };
+}
+
+function toIdentifier(id: string): Identifier {
+  if (!NUMERIC_ID_RE.test(id)) return id;
+  const n = Number(id);
+  return n >= 0 && n < Number.MAX_SAFE_INTEGER ? n : id;
+}
+
+function parseRange(range: string): ComparatorSet[] | null {
+  const raw = range.trim().replace(/\s+/g, " ");
+  const sets: ComparatorSet[] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    if (set.length) sets.push(set);
+  }
+  if (!sets.length) return null;
+  if (sets.length === 1) return sets;
+
+  const withoutNullSets = sets.filter((set) => !isNullSet(set[0]));
+  if (!withoutNullSets.length) return [sets[0]];
+  const anySet = withoutNullSets.find((set) => set.length === 1 && set[0] === "any");
+  return anySet ? [anySet] : withoutNullSets;
+}
+
+function parseComparatorSet(range: string): ComparatorSet | null {
+  const desugared = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RANGE_RE, replaceHyphen)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const primitives = desugared
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const primitive of primitives) {
+    const comparator = parseComparator(primitive);
+    if (!comparator) return null;
+    comparators.push(comparator);
+  }
+
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (isNullSet(comparator)) return [comparator];
+    byValue.set(comparatorValue(comparator), comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(comp: string): Comparator | null {
+  const match = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) return null;
+  if (!match[2]) return "any";
+  const semver = parseVersion(match[2]);
+  if (!semver) return null;
+  const operator = OPERATORS.find((op) => op === match[1] || (op === "" && match[1] === "="));
+  if (operator === undefined) return null;
+  return { operator, semver };
+}
+
+function comparatorValue(comparator: Comparator): string {
+  if (comparator === "any") return "";
+  return comparator.operator + formatVersion(comparator.semver);
+}
+
+function isNullSet(comparator: Comparator): boolean {
+  return comparatorValue(comparator) === "<0.0.0-0";
+}
+
+function formatVersion({ major, minor, patch, prerelease }: SemVer): string {
+  const main = `${major}.${minor}.${patch}`;
+  return prerelease.length ? `${main}-${prerelease.join(".")}` : main;
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function replaceHyphen(
+  _: string,
+  from: string,
+  fromMajor: string,
+  fromMinor: string,
+  fromPatch: string,
+  fromPrerelease: string | undefined,
+  _fromBuild: string | undefined,
+  to: string,
+  toMajor: string,
+  toMinor: string,
+  toPatch: string,
+  toPrerelease: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fromMajor)) lower = "";
+  else if (isX(fromMinor)) lower = `>=${fromMajor}.0.0`;
+  else if (isX(fromPatch)) lower = `>=${fromMajor}.${fromMinor}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(toMajor)) upper = "";
+  else if (isX(toMinor)) upper = `<${+toMajor + 1}.0.0-0`;
+  else if (isX(toPatch)) upper = `<${toMajor}.${+toMinor + 1}.0-0`;
+  else if (toPrerelease) upper = `<=${toMajor}.${toMinor}.${toPatch}-${toPrerelease}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xRanges = tildes.trim().split(/\s+/).map(replaceXRange).join(" ");
+  return xRanges.trim().replace(STAR_RE, "");
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(
+    CARET_RE,
+    (_: string, M: string, m: string, p: string, pr: string | undefined) => {
+      if (isX(M)) return "";
+      if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (isX(p)) {
+        if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+        return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+      }
+      const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+      if (M !== "0") return `${lower} <${+M + 1}.0.0-0`;
+      if (m !== "0") return `${lower} <${M}.${+m + 1}.0-0`;
+      return `${lower} <${M}.${m}.${+p + 1}-0`;
+    },
+  );
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(
+    TILDE_RE,
+    (_: string, M: string, m: string, p: string, pr: string | undefined) => {
+      if (isX(M)) return "";
+      if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+      return `${lower} <${M}.${+m + 1}.0-0`;
+    },
+  );
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE_RE, (whole: string, operator: string, M: string, m: string, p: string) => {
+      // `*.1` or `1.x.2` stays as is, so the comparator parse rejects it.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+      const xMajor = isX(M);
+      const xMinor = xMajor || isX(m);
+      const anyX = xMinor || isX(p);
+      const gtlt = operator === "=" && anyX ? "" : operator;
+
+      if (xMajor) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && anyX) return bumpPartialComparator(gtlt, +M, xMinor ? 0 : +m, xMinor);
+      if (xMinor) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return whole;
+    });
+}
+
+function bumpPartialComparator(gtlt: string, major: number, minor: number, xMinor: boolean): string {
+  if (gtlt === ">") {
+    if (xMinor) return `>=${major + 1}.0.0`;
+    return `>=${major}.${minor + 1}.0`;
+  }
+  if (gtlt === "<=") {
+    if (xMinor) return `<${major + 1}.0.0-0`;
+    return `<${major}.${minor + 1}.0-0`;
+  }
+  if (gtlt === "<") return `<${major}.${minor}.0-0`;
+  return `${gtlt}${major}.${minor}.0`;
+}
+
+function testSet(set: ComparatorSet, version: SemVer): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (comparator) =>
+      comparator !== "any" &&
+      comparator.semver.prerelease.length > 0 &&
+      comparator.semver.major === version.major &&
+      comparator.semver.minor === version.minor &&
+      comparator.semver.patch === version.patch,
+  );
+}
+
+function testComparator(comparator: Comparator, version: SemVer): boolean {
+  if (comparator === "any") return true;
+  const order = compare(version, comparator.semver);
+  switch (comparator.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+function compare(a: SemVer, b: SemVer): -1 | 0 | 1 {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): -1 | 0 | 1 {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    const order = compareIdentifiers(a[i], b[i]);
+    if (order) return order;
+  }
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): -1 | 0 | 1 {
+  const aNumeric = NUMERIC_ID_RE.test(String(a));
+  const bNumeric = NUMERIC_ID_RE.test(String(b));
+  if (aNumeric && bNumeric) {
+    const [x, y] = [+a, +b];
+    return x === y ? 0 : x < y ? -1 : 1;
+  }
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
 }
