+// Port of node-semver v7 range semantics (default options: strict, no includePrerelease).
+
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAIN_LOOSE = `(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})`;
+const PRID = `(?:${NUM}|${NONNUM})`;
+const PRID_LOOSE = `(?:${NONNUM}|${NUM_LOOSE})`;
+const PRE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PRE_LOOSE = `(?:-?(${PRID_LOOSE}(?:\\.${PRID_LOOSE})*))`;
+const BUILDID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDID}(?:\\.${BUILDID})*))`;
+const FULLPLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAIN_LOOSE}${PRE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULLPLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const COMPARATORTRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const TILDETRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARETTRIM_RE = /(\s*)(?:\^)\s+/g;
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+type Id = string | number;
+
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+
+  constructor(v: string) {
+    if (v.length > 256) throw new TypeError("too long");
+    const m = v.trim().match(FULL_RE);
+    if (!m) throw new TypeError(`Invalid Version: ${v}`);
+    this.major = +m[1];
+    this.minor = +m[2];
+    this.patch = +m[3];
+    for (const n of [this.major, this.minor, this.patch])
+      if (n > Number.MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version number");
+    this.prerelease = m[4]
+      ? m[4].split(".").map((id) => {
+          if (/^[0-9]+$/.test(id)) {
+            const n = +id;
+            if (n >= 0 && n < Number.MAX_SAFE_INTEGER) return n;
+          }
+          return id;
+        })
+      : [];
+    this.version = `${this.major}.${this.minor}.${this.patch}` +
+      (this.prerelease.length ? `-${this.prerelease.join(".")}` : "");
+  }
+
+  compare(o: SemVer): number {
+    return (
+      cmpNum(this.major, o.major) || cmpNum(this.minor, o.minor) || cmpNum(this.patch, o.patch) ||
+      this.comparePre(o)
+    );
+  }
+
+  comparePre(o: SemVer): number {
+    const a = this.prerelease, b = o.prerelease;
+    if (a.length && !b.length) return -1;
+    if (!a.length && b.length) return 1;
+    for (let i = 0; ; i++) {
+      if (a[i] === undefined && b[i] === undefined) return 0;
+      if (b[i] === undefined) return 1;
+      if (a[i] === undefined) return -1;
+      const c = cmpId(a[i], b[i]);
+      if (c) return c;
+    }
+  }
+}
+
+const cmpNum = (a: number, b: number) => (a === b ? 0 : a < b ? -1 : 1);
+
+function cmpId(a: Id, b: Id): number {
+  const an = /^[0-9]+$/.test(String(a)), bn = /^[0-9]+$/.test(String(b));
+  if (an && bn) return cmpNum(+a, +b);
+  if (an) return -1;
+  if (bn) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+const ANY = Symbol("ANY");
+
+class Comparator {
+  operator: string;
+  semver: SemVer | typeof ANY;
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(COMPARATOR_RE);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined && m[1] !== "=" ? m[1] : "";
+    this.semver = m[2] ? new SemVer(m[2]) : ANY;
+    this.value = this.semver === ANY ? "" : this.operator + this.semver.version;
+  }
+
+  test(v: SemVer): boolean {
+    if (this.semver === ANY) return true;
+    const c = v.compare(this.semver);
+    switch (this.operator) {
+      case "": return c === 0;
+      case ">": return c > 0;
+      case ">=": return c >= 0;
+      case "<": return c < 0;
+      case "<=": return c <= 0;
+    }
+    throw new TypeError(`Invalid operator: ${this.operator}`);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      return M === "0" ? `>=${M}.${m}.0 <${M}.${+m + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      return m === "0" ? `${lo} <${M}.${m}.${+p + 1}-0` : `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (ret, gtlt: string, M, m, p) => {
+    const xM = isX(M), xm = xM || isX(m), xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    let pr = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      if (xm) m = 0;
+      p = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) { M = +M + 1; m = 0; p = 0; } else { m = +m + 1; p = 0; }
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) M = +M + 1; else m = +m + 1;
+      }
+      if (gtlt === "<") pr = "-0";
+      return `${gtlt + M}.${m}.${p}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+const eachWord = (comp: string, f: (c: string) => string) =>
+  comp.trim().split(/\s+/).map(f).join(" ");
+
+function parseComparator(comp: string): string {
+  comp = eachWord(comp, replaceCaret);
+  comp = eachWord(comp, replaceTilde);
+  comp = eachWord(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function hyphenReplace(
+  _: string, from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseRange(range: string): Comparator[] {
+  range = range.replace(HYPHEN_RE, hyphenReplace as any);
+  range = range.replace(COMPARATORTRIM_RE, "$1$2$3");
+  range = range.replace(TILDETRIM_RE, "$1~");
+  range = range.replace(CARETTRIM_RE, "$1^");
+  const list = range.split(" ").map(parseComparator).join(" ").split(/\s+/)
+    .map((c) => c.trim().replace(GTE0_RE, ""));
+  const map = new Map<string, Comparator>();
+  for (const s of list) {
+    const c = new Comparator(s);
+    if (c.value === "<0.0.0-0") return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+class Range {
+  set: Comparator[][];
+
+  constructor(range: string) {
+    const raw = range.trim().split(/\s+/).join(" ");
+    this.set = raw.split("||").map((r) => parseRange(r.trim())).filter((c) => c.length);
+    if (!this.set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+    if (this.set.length > 1) {
+      const first = this.set[0];
+      this.set = this.set.filter((c) => c[0].value !== "<0.0.0-0");
+      if (!this.set.length) this.set = [first];
+      else if (this.set.length > 1) {
+        const any = this.set.find((c) => c.length === 1 && c[0].value === "");
+        if (any) this.set = [any];
+      }
+    }
+  }
+
+  test(version: string): boolean {
+    let v: SemVer;
+    try { v = new SemVer(version); } catch { return false; }
+    return this.set.some((set) => testSet(set, v));
+  }
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => c.test(v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some((c) => {
+    const s = c.semver;
+    return s !== ANY && s.prerelease.length > 0 &&
+      s.major === v.major && s.minor === v.minor && s.patch === v.patch;
+  });
+}
+
+function makeRange(range: string): Range | null {
+  try { return new Range(range); } catch { return null; }
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  return makeRange(range)?.test(version) ?? false;
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const r = makeRange(range);
+  if (!r) return null;
+  let max: string | null = null;
+  let maxSV: SemVer | null = null;
+  for (const v of versions) {
+    if (!r.test(v)) continue;
+    if (!maxSV || maxSV.compare(new SemVer(v)) === -1) {
+      max = v;
+      maxSV = new SemVer(v);
+    }
+  }
+  return max;
 }
