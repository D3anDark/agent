+// Port of node-semver v7 range logic (default options: not loose, no includePrerelease).
+const MAX_LENGTH = 256;
+
+// node-semver's "safe" regex transform: bound \s and \d repetitions.
+const safe = (s: string) =>
+  ([["\\s", 1], ["\\d", MAX_LENGTH], ["[a-zA-Z0-9-]", MAX_LENGTH - 6]] as const).reduce(
+    (v, [tok, max]) => v.split(`${tok}*`).join(`${tok}{0,${max}}`).split(`${tok}+`).join(`${tok}{1,${max}}`),
+    s,
+  );
+
+const LDN = "[a-zA-Z0-9-]";
+const NUM = "0|[1-9]\\d*";
+const NUMLOOSE = "\\d+";
+const NONNUM = `\\d*[a-zA-Z-]${LDN}*`;
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAINLOOSE = `(${NUMLOOSE})\\.(${NUMLOOSE})\\.(${NUMLOOSE})`;
+const PRID = `(?:${NONNUM}|${NUM})`;
+const PRIDLOOSE = `(?:${NUMLOOSE}|${NONNUM})`;
+const PRE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PRELOOSE = `(?:-?(${PRIDLOOSE}(?:\\.${PRIDLOOSE})*))`;
+const BUILDID = `${LDN}+`;
+const BUILD = `(?:\\+(${BUILDID}(?:\\.${BUILDID})*))`;
+const FULLPLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAINLOOSE}${PRELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRE})?${BUILD}?)?)?`;
+
+const mk = (s: string, flags?: string) => new RegExp(safe(s), flags);
+const RE = {
+  FULL: mk(`^${FULLPLAIN}$`),
+  HYPHEN: mk(`^\\s*(${XPLAIN})\\s+-\\s+(${XPLAIN})\\s*$`),
+  COMPTRIM: mk(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XPLAIN})`, "g"),
+  TILDETRIM: mk(`(\\s*)(?:~>?)\\s+`, "g"),
+  CARETTRIM: mk(`(\\s*)(?:\\^)\\s+`, "g"),
+  TILDE: mk(`^(?:~>?)${XPLAIN}$`),
+  CARET: mk(`^(?:\\^)${XPLAIN}$`),
+  XRANGE: mk(`^${GTLT}\\s*${XPLAIN}$`),
+  STAR: mk(`(<|>)?=?\\s*\\*`),
+  GTE0: mk(`^\\s*>=\\s*0\\.0\\.0\\s*$`),
+  COMPARATOR: mk(`^${GTLT}\\s*(${FULLPLAIN})$|^$`),
+};
+
+type Id = string | number;
+interface SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+}
+
+function parse(v: string): SemVer {
+  if (v.length > MAX_LENGTH) throw new TypeError("too long");
+  const m = v.trim().match(RE.FULL);
+  if (!m) throw new TypeError(`Invalid Version: ${v}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) throw new TypeError("too big");
+  const prerelease: Id[] = m[4]
+    ? m[4].split(".").map((id) => (/^[0-9]+$/.test(id) && +id < Number.MAX_SAFE_INTEGER ? +id : id))
+    : [];
+  const version = `${major}.${minor}.${patch}` + (prerelease.length ? `-${prerelease.join(".")}` : "");
+  return { major, minor, patch, prerelease, version };
+}
+
+const cmpId = (a: Id, b: Id) => {
+  const an = typeof a === "number", bn = typeof b === "number";
+  if (an && !bn) return -1;
+  if (bn && !an) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+};
+
+function compare(a: SemVer, b: SemVer): number {
+  const main = cmpId(a.major, b.major) || cmpId(a.minor, b.minor) || cmpId(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i], y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return cmpId(x, y);
+  }
+}
+
+interface Comparator {
+  op: string;
+  semver: SemVer | null; // null = ANY
+  value: string;
+}
+
+function comparator(comp: string): Comparator {
+  comp = comp.trim().split(/\s+/).join(" ");
+  const m = comp.match(RE.COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  let op = m[1] ?? "";
+  if (op === "=") op = "";
+  const semver = m[2] ? parse(m[2]) : null;
+  return { op, semver, value: semver ? op + semver.version : "" };
+}
+
+function testComp(c: Comparator, v: SemVer): boolean {
+  if (!c.semver) return true;
+  const r = compare(v, c.semver);
+  switch (c.op) {
+    case "": return r === 0;
+    case ">": return r > 0;
+    case ">=": return r >= 0;
+    case "<": return r < 0;
+    case "<=": return r <= 0;
+  }
+  throw new TypeError(`Invalid operator: ${c.op}`);
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+const replaceCaret = (comp: string) =>
+  comp.replace(RE.CARET, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return M === "0" ? `>=${M}.${m}.0 <${M}.${+m + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") return m === "0" ? `${from} <${M}.${m}.${+p + 1}-0` : `${from} <${M}.${+m + 1}.0-0`;
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+
+const replaceTilde = (comp: string) =>
+  comp.replace(RE.TILDE, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+
+const replaceXRange = (comp: string) =>
+  comp.trim().replace(RE.XRANGE, (ret, gtlt: string, M, m, p) => {
+    // node-semver >=7.7: an X before a concrete part (e.g. "x.1.2", "1.x.3") is left as-is, i.e. invalid.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return ret;
+    const xM = isX(M), xm = xM || isX(m), xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    let pr = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      if (xm) m = 0;
+      p = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) { M = +M + 1; m = 0; } else m = +m + 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) M = +M + 1; else m = +m + 1;
+      }
+      if (gtlt === "<") pr = "-0";
+      return `${gtlt + M}.${m}.${p}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+
+const hyphenReplace = (_: string, from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string) => {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+};
+
+function parseComparator(comp: string): string {
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(RE.STAR, "");
+}
+
+function parseRange(range: string): Comparator[] {
+  range = range
+    .replace(RE.HYPHEN, hyphenReplace as any)
+    .replace(RE.COMPTRIM, "$1$2$3")
+    .replace(RE.TILDETRIM, "$1~")
+    .replace(RE.CARETTRIM, "$1^");
+  const list = range.split(" ").map(parseComparator).join(" ").split(/\s+/)
+    .map((c) => c.trim().replace(RE.GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const c of list.map(comparator)) {
+    if (c.value === "<0.0.0-0") return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1) map.delete("");
+  return [...map.values()];
+}
+
+function parseRangeSet(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let set = raw.split("||").map((r) => parseRange(r.trim())).filter((c) => c.length);
+  if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (set.length > 1) {
+    const first = set[0];
+    set = set.filter((c) => c[0].value !== "<0.0.0-0");
+    if (!set.length) set = [first];
+    else if (set.length > 1) {
+      const any = set.find((c) => c.length === 1 && c[0].value === "");
+      if (any) set = [any];
+    }
+  }
+  return set;
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => testComp(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some((c) => c.semver && c.semver.prerelease.length > 0 &&
+    c.semver.major === v.major && c.semver.minor === v.minor && c.semver.patch === v.patch);
+}
+
+const tryParse = <T>(f: () => T): T | null => {
+  try { return f(); } catch { return null; }
+};
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = tryParse(() => parseRangeSet(range));
+  const v = tryParse(() => parse(version));
+  return !!set && !!v && set.some((s) => testSet(s, v));
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = tryParse(() => parseRangeSet(range));
+  if (!set) return null;
+  let best: string | null = null, bestV: SemVer | null = null;
+  for (const s of versions) {
+    const v = tryParse(() => parse(s));
+    if (v && set.some((x) => testSet(x, v)) && (!bestV || compare(bestV, v) < 0)) {
+      best = s;
+      bestV = v;
+    }
+  }
+  return best;
 }
