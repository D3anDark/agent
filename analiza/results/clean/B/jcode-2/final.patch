+// Port of node-semver v7 range matching (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE = Number.MAX_SAFE_INTEGER;
+
+const NUM = "0|[1-9]\\d*";
+const NUMLOOSE = "\\d+";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAINLOOSE = `(${NUMLOOSE})\\.(${NUMLOOSE})\\.(${NUMLOOSE})`;
+const PRID = `(?:${NONNUM}|${NUM})`;
+const PRIDLOOSE = `(?:${NONNUM}|${NUMLOOSE})`;
+const PRERELEASE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PRERELEASELOOSE = `(?:-?(${PRIDLOOSE}(?:\\.${PRIDLOOSE})*))`;
+const BUILDID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDID}(?:\\.${BUILDID})*))`;
+const FULLPLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAINLOOSE}${PRERELEASELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+// node-semver bounds greedy quantifiers to avoid ReDoS. This changes matching on
+// long inputs, so mirror it exactly.
+const LDN = "[a-zA-Z0-9-]";
+function safe(src: string): string {
+  const reps: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    [LDN, MAX_LENGTH - 6],
+  ];
+  for (const [tok, max] of reps) {
+    src = src
+      .split(`${tok}*`)
+      .join(`${tok}{0,${max}}`)
+      .split(`${tok}+`)
+      .join(`${tok}{1,${max}}`);
+  }
+  return src;
+}
+const mk = (src: string, flags?: string) => new RegExp(safe(src), flags);
+
+const RE_FULL = mk(`^${FULLPLAIN}$`);
+const RE_XRANGE = mk(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const RE_TILDETRIM = mk(`(\\s*)(?:~>?)\\s+`, "g");
+const RE_TILDE = mk(`^(?:~>?)${XRANGEPLAIN}$`);
+const RE_CARETTRIM = mk(`(\\s*)(?:\\^)\\s+`, "g");
+const RE_CARET = mk(`^(?:\\^)${XRANGEPLAIN}$`);
+const RE_COMPARATOR = mk(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const RE_COMPARATORTRIM = mk(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const RE_HYPHEN = mk(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const RE_STAR = mk("(<|>)?=?\\s*\\*");
+const RE_GTE0 = mk("^\\s*>=\\s*0\\.0\\.0\\s*$");
+const RE_BUILDSTRIP = new RegExp(BUILD, "g");
+
+type Id = string | number;
+
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  raw: string;
+
+  constructor(version: string) {
+    if (typeof version !== "string") throw new TypeError("Invalid version");
+    if (version.length > MAX_LENGTH) throw new TypeError("Invalid version");
+    const m = version.trim().match(RE_FULL);
+    if (!m) throw new TypeError("Invalid version");
+    this.raw = version;
+    this.major = +m[1];
+    this.minor = +m[2];
+    this.patch = +m[3];
+    for (const n of [this.major, this.minor, this.patch]) {
+      if (n > MAX_SAFE || n < 0) throw new TypeError("Invalid version");
+    }
+    this.prerelease = m[4]
+      ? m[4].split(".").map((id) => {
+          if (/^[0-9]+$/.test(id)) {
+            const num = +id;
+            if (num >= 0 && num < MAX_SAFE) return num;
+          }
+          return id;
+        })
+      : [];
+    this.version = `${this.major}.${this.minor}.${this.patch}`;
+    if (this.prerelease.length) this.version += `-${this.prerelease.join(".")}`;
+  }
+
+  version: string;
+
+  compare(other: SemVer): number {
+    return this.compareMain(other) || this.comparePre(other);
+  }
+
+  compareMain(o: SemVer): number {
+    return (
+      cmpIds(this.major, o.major) || cmpIds(this.minor, o.minor) || cmpIds(this.patch, o.patch)
+    );
+  }
+
+  comparePre(o: SemVer): number {
+    if (this.prerelease.length && !o.prerelease.length) return -1;
+    if (!this.prerelease.length && o.prerelease.length) return 1;
+    if (!this.prerelease.length && !o.prerelease.length) return 0;
+    let i = 0;
+    for (;;) {
+      const a = this.prerelease[i];
+      const b = o.prerelease[i];
+      if (a === undefined && b === undefined) return 0;
+      if (b === undefined) return 1;
+      if (a === undefined) return -1;
+      if (a === b) {
+        i++;
+        continue;
+      }
+      return cmpIds(a, b);
+    }
+  }
+}
+
+const numeric = /^[0-9]+$/;
+function cmpIds(a: Id, b: Id): number {
+  const an = numeric.test(String(a));
+  const bn = numeric.test(String(b));
+  if (an && bn) {
+    a = +a;
+    b = +b;
+  }
+  return a === b ? 0 : an && !bn ? -1 : bn && !an ? 1 : a < b ? -1 : 1;
+}
+
+const ANY = Symbol("ANY");
+
+class Comparator {
+  operator: string;
+  semver: SemVer | typeof ANY;
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(RE_COMPARATOR);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined ? m[1] : "";
+    if (this.operator === "=") this.operator = "";
+    this.semver = m[2] ? new SemVer(m[2]) : ANY;
+    this.value = this.semver === ANY ? "" : this.operator + this.semver.version;
+  }
+
+  test(v: SemVer): boolean {
+    if (this.semver === ANY) return true;
+    const c = v.compare(this.semver);
+    switch (this.operator) {
+      case "":
+        return c === 0;
+      case ">":
+        return c > 0;
+      case ">=":
+        return c >= 0;
+      case "<":
+        return c < 0;
+      case "<=":
+        return c <= 0;
+      default:
+        throw new TypeError(`Invalid operator: ${this.operator}`);
+    }
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(RE_CARET, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const low = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${low} <${M}.${m}.${+p + 1}-0`;
+      return `${low} <${M}.${+m + 1}.0-0`;
+    }
+    return `${low} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(RE_TILDE, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(
+    RE_XRANGE,
+    (ret: string, gtlt: string, M: string, m: string | number, p: string | number) => {
+      if ((isX(M) && !isX(m as string)) || (isX(m as string) && p && !isX(p as string))) {
+        return comp;
+      }
+      const xM = isX(M);
+      const xm = xM || isX(m as string);
+      const xp = xm || isX(p as string);
+      const anyX = xp;
+      if (gtlt === "=" && anyX) gtlt = "";
+      let pr = "";
+      if (xM) {
+        return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      } else if (gtlt && anyX) {
+        let Mn: string | number = M;
+        if (xm) m = 0;
+        p = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            Mn = +M + 1;
+            m = 0;
+            p = 0;
+          } else {
+            m = +m + 1;
+            p = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) Mn = +M + 1;
+          else m = +m + 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt + Mn}.${m}.${p}${pr}`;
+      } else if (xm) {
+        return `>=${M}.0.0${pr} <${+M + 1}.0.0-0`;
+      } else if (xp) {
+        return `>=${M}.${m}.0${pr} <${M}.${+m + 1}.0-0`;
+      }
+      return ret;
+    },
+  );
+}
+
+function parseComparator(comp: string): string {
+  comp = comp
+    .trim()
+    .split(/\s+/)
+    .map((c) => replaceCaret(c))
+    .join(" ");
+  comp = comp
+    .trim()
+    .split(/\s+/)
+    .map((c) => replaceTilde(c))
+    .join(" ");
+  comp = comp
+    .split(/\s+/)
+    .map((c) => replaceXRange(c))
+    .join(" ");
+  comp = comp.trim().replace(RE_STAR, "");
+  return comp;
+}
+
+function hyphenReplace(
+  _0: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseRangeSet(range: string): Comparator[] {
+  range = range.replace(RE_BUILDSTRIP, "");
+  range = range.replace(RE_HYPHEN, hyphenReplace as any);
+  range = range.replace(RE_COMPARATORTRIM, "$1$2$3");
+  range = range.replace(RE_TILDETRIM, "$1~");
+  range = range.replace(RE_CARETTRIM, "$1^");
+  const list = range
+    .split(" ")
+    .map((c) => parseComparator(c))
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(RE_GTE0, ""));
+  const map = new Map<string, Comparator>();
+  const comps = list.map((s) => new Comparator(s));
+  for (const c of comps) {
+    if (isNullSet(c)) return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+class Range {
+  set: Comparator[][];
+
+  constructor(range: string) {
+    if (typeof range !== "string") throw new TypeError("Invalid range");
+    const raw = range.trim().replace(/\s+/g, " ");
+    let set = raw
+      .split("||")
+      .map((r) => parseRangeSet(r.trim()))
+      .filter((c) => c.length);
+    if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+    if (set.length > 1) {
+      const first = set[0];
+      set = set.filter((c) => !isNullSet(c[0]));
+      if (set.length === 0) set = [first];
+      else if (set.length > 1) {
+        for (const c of set) {
+          if (c.length === 1 && isAny(c[0])) {
+            set = [c];
+            break;
+          }
+        }
+      }
+    }
+    this.set = set;
+  }
+
+  test(v: SemVer): boolean {
+    return this.set.some((s) => testSet(s, v));
+  }
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  for (const c of set) if (!c.test(v)) return false;
+  if (v.prerelease.length) {
+    for (const c of set) {
+      if (c.semver === ANY) continue;
+      const a = c.semver;
+      if (
+        a.prerelease.length > 0 &&
+        a.major === v.major &&
+        a.minor === v.minor &&
+        a.patch === v.patch
+      ) {
+        return true;
+      }
+    }
+    return false;
+  }
+  return true;
+}
+
+function tryRange(range: string): Range | null {
+  try {
+    return new Range(range);
+  } catch {
+    return null;
+  }
+}
+
+function trySemVer(v: string): SemVer | null {
+  try {
+    return new SemVer(v);
+  } catch {
+    return null;
+  }
+}
