+// A port of node-semver v7 range matching (default options: not loose,
+// includePrerelease false).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+const MAX_SAFE_INTEGER = Number.MAX_SAFE_INTEGER;
+const LETTERDASHNUMBER = "[a-zA-Z0-9-]";
+
+const safeRegexReplacements: [string, number][] = [
+  ["\\s", 1],
+  ["\\d", MAX_LENGTH],
+  [LETTERDASHNUMBER, MAX_SAFE_BUILD_LENGTH],
+];
+
+function makeSafe(value: string): string {
+  for (const [token, max] of safeRegexReplacements) {
+    value = value
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return value;
+}
+
+const src: Record<string, string> = {};
+const re: Record<string, RegExp> = {};
+function def(name: string, value: string, global = false) {
+  src[name] = value;
+  re[name] = new RegExp(makeSafe(value), global ? "g" : undefined);
+}
+
+def("NUMERICIDENTIFIER", "0|[1-9]\\d*");
+def("NUMERICIDENTIFIERLOOSE", "\\d+");
+def("NONNUMERICIDENTIFIER", `\\d*[a-zA-Z-]${LETTERDASHNUMBER}*`);
+def(
+  "MAINVERSION",
+  `(${src.NUMERICIDENTIFIER})\\.(${src.NUMERICIDENTIFIER})\\.(${src.NUMERICIDENTIFIER})`,
+);
+def(
+  "MAINVERSIONLOOSE",
+  `(${src.NUMERICIDENTIFIERLOOSE})\\.(${src.NUMERICIDENTIFIERLOOSE})\\.(${src.NUMERICIDENTIFIERLOOSE})`,
+);
+def("PRERELEASEIDENTIFIER", `(?:${src.NUMERICIDENTIFIER}|${src.NONNUMERICIDENTIFIER})`);
+def(
+  "PRERELEASEIDENTIFIERLOOSE",
+  `(?:${src.NUMERICIDENTIFIERLOOSE}|${src.NONNUMERICIDENTIFIER})`,
+);
+def(
+  "PRERELEASE",
+  `(?:-(${src.PRERELEASEIDENTIFIER}(?:\\.${src.PRERELEASEIDENTIFIER})*))`,
+);
+def(
+  "PRERELEASELOOSE",
+  `(?:-?(${src.PRERELEASEIDENTIFIERLOOSE}(?:\\.${src.PRERELEASEIDENTIFIERLOOSE})*))`,
+);
+def("BUILDIDENTIFIER", `${LETTERDASHNUMBER}+`);
+def("BUILD", `(?:\\+(${src.BUILDIDENTIFIER}(?:\\.${src.BUILDIDENTIFIER})*))`);
+def("FULLPLAIN", `v?${src.MAINVERSION}${src.PRERELEASE}?${src.BUILD}?`);
+def("FULL", `^${src.FULLPLAIN}$`);
+def("LOOSEPLAIN", `[v=\\s]*${src.MAINVERSIONLOOSE}${src.PRERELEASELOOSE}?${src.BUILD}?`);
+def("GTLT", "((?:<|>)?=?)");
+def("XRANGEIDENTIFIER", `${src.NUMERICIDENTIFIER}|x|X|\\*`);
+def(
+  "XRANGEPLAIN",
+  `[v=\\s]*(${src.XRANGEIDENTIFIER})` +
+    `(?:\\.(${src.XRANGEIDENTIFIER})` +
+    `(?:\\.(${src.XRANGEIDENTIFIER})` +
+    `(?:${src.PRERELEASE})?${src.BUILD}?` +
+    `)?)?`,
+);
+def("XRANGE", `^${src.GTLT}\\s*${src.XRANGEPLAIN}$`);
+def("LONETILDE", "(?:~>?)");
+def("TILDETRIM", `(\\s*)${src.LONETILDE}\\s+`, true);
+def("TILDE", `^${src.LONETILDE}${src.XRANGEPLAIN}$`);
+def("LONECARET", "(?:\\^)");
+def("CARETTRIM", `(\\s*)${src.LONECARET}\\s+`, true);
+def("CARET", `^${src.LONECARET}${src.XRANGEPLAIN}$`);
+def("COMPARATOR", `^${src.GTLT}\\s*(${src.FULLPLAIN})$|^$`);
