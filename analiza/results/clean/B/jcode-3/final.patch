+  for (const s of rangeList) {
+    const comp = new Comparator(s);
+    if (isNullSet(comp)) return [comp];
+    rangeMap.set(comp.value, comp);
+  }
+  if (rangeMap.size > 1 && rangeMap.has("")) rangeMap.delete("");
+  return [...rangeMap.values()];
+}
+
+class Range {
+  set: Comparator[][];
