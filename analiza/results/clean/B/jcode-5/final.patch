+// Port of node-semver v7 range matching (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_INTEGER = Number.MAX_SAFE_INTEGER;
+
+const NUMERICIDENTIFIER = "0|[1-9]\\d*";
+const NUMERICIDENTIFIERLOOSE = "\\d+";
+const NONNUMERICIDENTIFIER = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAINVERSION = `(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})`;
+const MAINVERSIONLOOSE = `(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASEIDENTIFIER = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIER})`;
+const PRERELEASEIDENTIFIERLOOSE = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASEIDENTIFIER}(?:\\.${PRERELEASEIDENTIFIER})*))`;
+const PRERELEASELOOSE = `(?:-?(${PRERELEASEIDENTIFIERLOOSE}(?:\\.${PRERELEASEIDENTIFIERLOOSE})*))`;
+const BUILDIDENTIFIER = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDIDENTIFIER}(?:\\.${BUILDIDENTIFIER})*))`;
+const FULLPLAIN = `v?${MAINVERSION}${PRERELEASE}?${BUILD}?`;
+const FULL = new RegExp(`^${FULLPLAIN}$`);
+const LOOSEPLAIN = `[v=\\s]*${MAINVERSIONLOOSE}${PRERELEASELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGEIDENTIFIER = `${NUMERICIDENTIFIER}|x|X|\\*`;
+const XRANGEPLAIN =
+  `[v=\\s]*(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:${PRERELEASE})?${BUILD}?)?)?`;
+const XRANGE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const LONETILDE = "(?:~>?)";
+const TILDETRIM = new RegExp(`(\\s*)${LONETILDE}\\s+`, "g");
+const TILDE = new RegExp(`^${LONETILDE}${XRANGEPLAIN}$`);
+const LONECARET = "(?:\\^)";
+const CARETTRIM = new RegExp(`(\\s*)${LONECARET}\\s+`, "g");
+const CARET = new RegExp(`^${LONECARET}${XRANGEPLAIN}$`);
+const COMPARATOR = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const COMPARATORTRIM = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const HYPHENRANGE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const STAR = /(<|>)?=?\s*\*/;
+const GTE0 = /^\s*>=\s*0\.0\.0\s*$/;
+const BUILD_RE = new RegExp(BUILD);
+const NUMERIC = /^[0-9]+$/;
+
+type Id = string | number;
+
+function compareIdentifiers(a: Id, b: Id): number {
+  const anum = NUMERIC.test(String(a));
+  const bnum = NUMERIC.test(String(b));
+  if (anum && bnum) {
+    a = +a;
+    b = +b;
+  }
+  if (a === b) return 0;
+  if (anum && !bnum) return -1;
+  if (bnum && !anum) return 1;
+  return a < b ? -1 : 1;
+}
+
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+
+  constructor(version: string) {
+    if (typeof version !== "string") throw new TypeError("Invalid version");
+    if (version.length > MAX_LENGTH) throw new TypeError("Version too long");
+    const m = version.trim().match(FULL);
+    if (!m) throw new TypeError(`Invalid Version: ${version}`);
+    this.major = +m[1];
+    this.minor = +m[2];
+    this.patch = +m[3];
+    for (const n of [this.major, this.minor, this.patch]) {
+      if (n > MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version component");
+    }
+    this.prerelease = m[4]
+      ? m[4].split(".").map((id) => {
+          if (NUMERIC.test(id)) {
+            const num = +id;
+            if (num >= 0 && num < MAX_SAFE_INTEGER) return num;
+          }
+          return id;
+        })
+      : [];
+    this.version = `${this.major}.${this.minor}.${this.patch}`;
+    if (this.prerelease.length) this.version += `-${this.prerelease.join(".")}`;
+  }
+
+  compareMain(o: SemVer): number {
+    return (
+      cmpNum(this.major, o.major) || cmpNum(this.minor, o.minor) || cmpNum(this.patch, o.patch)
+    );
+  }
+
+  comparePre(o: SemVer): number {
+    if (this.prerelease.length && !o.prerelease.length) return -1;
+    if (!this.prerelease.length && o.prerelease.length) return 1;
+    if (!this.prerelease.length && !o.prerelease.length) return 0;
+    let i = 0;
+    for (;;) {
+      const a = this.prerelease[i];
+      const b = o.prerelease[i];
+      if (a === undefined && b === undefined) return 0;
+      if (b === undefined) return 1;
+      if (a === undefined) return -1;
+      i++;
+      if (a === b) continue;
+      return compareIdentifiers(a, b);
+    }
+  }
+
+  compare(o: SemVer): number {
+    return this.compareMain(o) || this.comparePre(o);
+  }
+}
+
+function cmpNum(a: number, b: number): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+const ANY = Symbol("ANY");
+
+class Comparator {
+  operator: string;
+  semver: SemVer | typeof ANY;
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(COMPARATOR);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined ? m[1] : "";
+    if (this.operator === "=") this.operator = "";
+    if (!m[2]) this.semver = ANY;
+    else this.semver = new SemVer(m[2]);
+    this.value = this.semver === ANY ? "" : this.operator + this.semver.version;
+  }
+
+  test(v: SemVer): boolean {
+    if (this.semver === ANY) return true;
+    const c = v.compare(this.semver);
+    switch (this.operator) {
+      case "":
+        return c === 0;
+      case ">":
+        return c > 0;
+      case ">=":
+        return c >= 0;
+      case "<":
+        return c < 0;
+      case "<=":
+        return c <= 0;
+      default:
+        throw new TypeError(`Invalid operator: ${this.operator}`);
+    }
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lo} <${M}.${m}.${+p + 1}-0`;
+      return `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(
+    XRANGE,
+    (ret: string, gtlt: string, M: string, m: string | number, p: string | number) => {
+      const xM = isX(M);
+      const xm = xM || isX(m as string);
+      const xp = xm || isX(p as string);
+      const anyX = xp;
+      if (gtlt === "=" && anyX) gtlt = "";
+      let pr = "";
+      if (xM) {
+        if (gtlt === ">" || gtlt === "<") return "<0.0.0-0";
+        return "*";
+      }
+      if (gtlt && anyX) {
+        let Mn: number | string = M;
+        if (xm) m = 0;
+        p = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            Mn = +M + 1;
+            m = 0;
+            p = 0;
+          } else {
+            m = +m + 1;
+            p = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) Mn = +M + 1;
+          else m = +m + 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt + Mn}.${m}.${p}${pr}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return ret;
+    },
+  );
+}
+
+function parseComparator(comp: string): string {
+  comp = comp.replace(BUILD_RE, "");
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  comp = comp.trim().replace(STAR, "");
+  return comp;
+}
+
+function hyphenReplace(
+  _0: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function isNullSet(c: Comparator): boolean {
+  return c.value === "<0.0.0-0";
+}
+
+function parseRange(range: string): Comparator[] {
+  range = range.replace(HYPHENRANGE, hyphenReplace as (...a: string[]) => string);
+  range = range.replace(COMPARATORTRIM, "$1$2$3");
+  range = range.replace(TILDETRIM, "$1~");
+  range = range.replace(CARETTRIM, "$1^");
+  const rangeList = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const s of rangeList) {
+    const comp = new Comparator(s);
+    if (isNullSet(comp)) return [comp];
+    map.set(comp.value, comp);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+class Range {
+  set: Comparator[][];
+
+  constructor(range: string) {
+    if (typeof range !== "string") throw new TypeError("Invalid range");
+    const raw = range.trim().split(/\s+/).join(" ");
+    this.set = raw
+      .split("||")
+      .map((r) => parseRange(r.trim()))
+      .filter((c) => c.length);
+    if (!this.set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+    if (this.set.length > 1) {
+      const first = this.set[0];
+      this.set = this.set.filter((c) => !isNullSet(c[0]));
+      if (this.set.length === 0) this.set = [first];
+      else if (this.set.length > 1) {
+        for (const c of this.set) {
+          if (c.length === 1 && c[0].semver === ANY) {
+            this.set = [c];
+            break;
+          }
+        }
+      }
+    }
+  }
+
+  test(version: string): boolean {
+    if (!version) return false;
+    let v: SemVer;
+    try {
+      v = new SemVer(version);
+    } catch {
+      return false;
+    }
+    return this.set.some((s) => testSet(s, v));
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  for (const c of set) if (!c.test(version)) return false;
+  if (version.prerelease.length) {
+    for (const c of set) {
+      if (c.semver === ANY) continue;
+      const a = c.semver;
+      if (
+        a.prerelease.length > 0 &&
+        a.major === version.major &&
+        a.minor === version.minor &&
+        a.patch === version.patch
+      )
+        return true;
+    }
+    return false;
+  }
+  return true;
+}
+
