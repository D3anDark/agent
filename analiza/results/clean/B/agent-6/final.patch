+// Port of node-semver v7 range semantics (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const NUM = "0|[1-9]\\d*";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const PRID = `(?:${NUM}|${NONNUM})`;
+const PRERELEASE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const BUILDID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDID}(?:\\.${BUILDID})*))`;
+const FULLPLAIN = `v?(${NUM})\\.(${NUM})\\.(${NUM})${PRERELEASE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*(\\d+)\\.(\\d+)\\.(\\d+)(?:-?((?:\\d+|${NONNUM})(?:\\.(?:\\d+|${NONNUM}))*))?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const re = {
+  full: new RegExp(`^${FULLPLAIN}$`),
+  build: new RegExp(BUILD),
+  comparator: new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`),
+  hyphen: new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`),
+  comparatorTrim: new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g"),
+  tildeTrim: /(\s*)(?:~>?)\s+/g,
+  caretTrim: /(\s*)(?:\^)\s+/g,
+  tilde: new RegExp(`^(?:~>?)${XRANGEPLAIN}$`),
+  caret: new RegExp(`^(?:\\^)${XRANGEPLAIN}$`),
+  xrange: new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`),
+  star: /(<|>)?=?\s*\*/,
+  gte0: /^\s*>=\s*0\.0\.0\s*$/,
+};
+
+type Id = string | number;
+interface SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+}
+
+function parseVersion(v: string): SemVer {
+  if (v.length > MAX_LENGTH) throw new TypeError("version too long");
+  const m = v.trim().match(re.full);
+  if (!m) throw new TypeError(`Invalid Version: ${v}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  for (const n of [major, minor, patch]) {
+    if (n > Number.MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version component");
+  }
+  const prerelease: Id[] = m[4]
+    ? m[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const num = +id;
+          if (num >= 0 && num < Number.MAX_SAFE_INTEGER) return num;
+        }
+        return id;
+      })
+    : [];
+  const version = `${major}.${minor}.${patch}` + (prerelease.length ? `-${prerelease.join(".")}` : "");
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIds(a: Id, b: Id): number {
+  const an = typeof a === "number" || /^[0-9]+$/.test(a);
+  const bn = typeof b === "number" || /^[0-9]+$/.test(b);
+  if (an && bn) {
+    a = +a;
+    b = +b;
+  }
+  return a === b ? 0 : an && !bn ? -1 : bn && !an ? 1 : a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main = compareIds(a.major, b.major) || compareIds(a.minor, b.minor) || compareIds(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    const c = compareIds(x, y);
+    if (c) return c;
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceTilde(comp: string): string {
+  return comp.replace(re.tilde, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(re.caret, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      return M === "0" ? `>=${M}.${m}.0 <${M}.${+m + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      return m === "0" ? `${lo} <${M}.${m}.${+p + 1}-0` : `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(re.xrange, (ret, gtlt: string, M, m, p) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    let pr = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      if (xm) m = 0;
+      p = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          M = +M + 1;
+          m = 0;
+        } else {
+          m = +m + 1;
+        }
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) M = +M + 1;
+        else m = +m + 1;
+      }
+      if (gtlt === "<") pr = "-0";
+      return `${gtlt + M}.${m}.${p}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+function parseComparator(comp: string): string {
+  comp = comp.replace(re.build, "");
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(re.star, "");
+}
+
+function hyphenReplace(
+  _: string, from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+interface Comparator {
+  op: string;
+  semver: SemVer | null; // null = ANY
+}
+
+function makeComparator(comp: string): Comparator {
+  comp = comp.trim().split(/\s+/).join(" ");
+  const m = comp.match(re.comparator);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const op = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  return { op, semver: m[2] ? parseVersion(m[2]) : null };
+}
+
+function testComparator(c: Comparator, v: SemVer): boolean {
+  if (!c.semver) return true;
+  const r = compare(v, c.semver);
+  switch (c.op) {
+    case "": return r === 0;
+    case ">": return r > 0;
+    case ">=": return r >= 0;
+    case "<": return r < 0;
+    case "<=": return r <= 0;
+  }
+  throw new TypeError(`Invalid operator: ${c.op}`);
+}
+
+function parseRangeSet(range: string): Comparator[] {
+  range = range.replace(re.hyphen, hyphenReplace as any);
+  range = range.replace(re.comparatorTrim, "$1$2$3");
+  range = range.replace(re.tildeTrim, "$1~");
+  range = range.replace(re.caretTrim, "$1^");
+  const list = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(re.gte0, ""));
+  return list.map(makeComparator);
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  return raw.split("||").map((r) => parseRangeSet(r.trim()));
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (v.prerelease.length) {
+    return set.some(
+      (c) =>
+        c.semver !== null &&
+        c.semver.prerelease.length > 0 &&
+        c.semver.major === v.major &&
+        c.semver.minor === v.minor &&
+        c.semver.patch === v.patch,
+    );
+  }
+  return true;
+}
+
+function tryParse<T>(fn: () => T): T | null {
+  try {
+    return fn();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): SemVer | null {
+  const v = tryParse(() => parseVersion(version));
+  return v && sets.some((s) => testSet(s, v)) ? v : null;
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version) !== null;
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxSV: SemVer | null = null;
+  for (const v of versions) {
+    const sv = testRange(sets, v);
+    if (sv && (!maxSV || compare(maxSV, sv) === -1)) {
+      max = v;
+      maxSV = sv;
+    }
+  }
+  return max;
 }
