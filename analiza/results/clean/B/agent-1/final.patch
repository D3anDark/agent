+// Port of node-semver v7 range semantics (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+
+const NUM = "0|[1-9]\\d*";
+const NUML = "\\d+";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAINL = `(${NUML})\\.(${NUML})\\.(${NUML})`;
+const PRID = `(?:${NUM}|${NONNUM})`;
+const PRIDL = `(?:${NUML}|${NONNUM})`;
+const PRE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PREL = `(?:-?(${PRIDL}(?:\\.${PRIDL})*))`;
+const BUILDID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDID}(?:\\.${BUILDID})*))`;
+const FULLPLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAINL}${PREL}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRE})?${BUILD}?)?)?`;
+
+const RE_FULL = new RegExp(`^${FULLPLAIN}$`);
+const RE_COMPARATOR = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const RE_HYPHEN = new RegExp(`^\\s*(${XPLAIN})\\s+-\\s+(${XPLAIN})\\s*$`);
+const RE_COMPTRIM = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XPLAIN})`, "g");
+const RE_TILDETRIM = new RegExp(`(\\s*)(?:~>?)\\s+`, "g");
+const RE_CARETTRIM = new RegExp(`(\\s*)(?:\\^)\\s+`, "g");
+const RE_TILDE = new RegExp(`^(?:~>?)${XPLAIN}$`);
+const RE_CARET = new RegExp(`^(?:\\^)${XPLAIN}$`);
+const RE_XRANGE = new RegExp(`^${GTLT}\\s*${XPLAIN}$`);
+const RE_STAR = /(<|>)?=?\s*\*/;
+const RE_GTE0 = /^\s*>=\s*0\.0\.0\s*$/;
+
+type Ident = string | number;
+
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Ident[];
+  version: string;
+
+  constructor(v: string) {
+    if (typeof v !== "string") throw new TypeError("Invalid version");
+    if (v.length > MAX_LENGTH) throw new TypeError("Version too long");
+    const m = v.trim().match(RE_FULL);
+    if (!m) throw new TypeError(`Invalid Version: ${v}`);
+    this.major = +m[1];
+    this.minor = +m[2];
+    this.patch = +m[3];
+    for (const n of [this.major, this.minor, this.patch]) {
+      if (n > Number.MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version number");
+    }
+    this.prerelease = m[4]
+      ? m[4].split(".").map((id) => {
+          if (/^[0-9]+$/.test(id)) {
+            const n = +id;
+            if (n >= 0 && n < Number.MAX_SAFE_INTEGER) return n;
+          }
+          return id;
+        })
+      : [];
+    this.version = `${this.major}.${this.minor}.${this.patch}`;
+    if (this.prerelease.length) this.version += `-${this.prerelease.join(".")}`;
+  }
+
+  compare(o: SemVer): number {
+    return this.compareMain(o) || this.comparePre(o);
+  }
+
+  compareMain(o: SemVer): number {
+    return cmpNum(this.major, o.major) || cmpNum(this.minor, o.minor) || cmpNum(this.patch, o.patch);
+  }
+
+  comparePre(o: SemVer): number {
+    const a = this.prerelease, b = o.prerelease;
+    if (a.length && !b.length) return -1;
+    if (!a.length && b.length) return 1;
+    for (let i = 0; ; i++) {
+      if (a[i] === undefined && b[i] === undefined) return 0;
+      if (b[i] === undefined) return 1;
+      if (a[i] === undefined) return -1;
+      const c = compareIdentifiers(a[i], b[i]);
+      if (c) return c;
+    }
+  }
+}
+
+const cmpNum = (a: number, b: number) => (a < b ? -1 : a > b ? 1 : 0);
+
+function compareIdentifiers(a: Ident, b: Ident): number {
+  const an = /^[0-9]+$/.test(String(a));
+  const bn = /^[0-9]+$/.test(String(b));
+  if (an && bn) return cmpNum(+a, +b);
+  if (an) return -1;
+  if (bn) return 1;
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+const ANY = Symbol("ANY");
+
+class Comparator {
+  operator: string;
+  semver: SemVer | typeof ANY;
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(RE_COMPARATOR);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined ? m[1] : "";
+    if (this.operator === "=") this.operator = "";
+    this.semver = m[2] ? new SemVer(m[2]) : ANY;
+    this.value = this.semver === ANY ? "" : this.operator + this.semver.version;
+  }
+
+  test(v: SemVer): boolean {
+    if (this.semver === ANY) return true;
+    const c = v.compare(this.semver);
+    switch (this.operator) {
+      case "": return c === 0;
+      case ">": return c > 0;
+      case ">=": return c >= 0;
+      case "<": return c < 0;
+      case "<=": return c <= 0;
+      default: throw new TypeError(`Invalid operator: ${this.operator}`);
+    }
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(RE_CARET, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      return M === "0" ? `>=${M}.${m}.0 <${M}.${+m + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      return m === "0" ? `${lo} <${M}.${m}.${+p + 1}-0` : `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(RE_TILDE, (_, M, m, p, pr) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(RE_XRANGE, (ret, gtlt, M, m, p) => {
+    // x.1.2 / 1.x.2 are invalid: leave unchanged so Comparator rejects them
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    let pr = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      if (xm) m = 0;
+      p = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          M = +M + 1;
+          m = 0;
+        } else {
+          m = +m + 1;
+        }
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) M = +M + 1;
+        else m = +m + 1;
+      }
+      if (gtlt === "<") pr = "-0";
+      return `${gtlt + M}.${m}.${p}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+const eachWord = (comp: string, f: (c: string) => string) => comp.trim().split(/\s+/).map(f).join(" ");
+
+function parseComparator(comp: string): string {
+  comp = eachWord(comp, replaceCaret);
+  comp = eachWord(comp, replaceTilde);
+  comp = eachWord(comp, replaceXRange);
+  return comp.trim().replace(RE_STAR, "");
+}
+
+function hyphenReplace(
+  _: string, from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+function parseRange(range: string): Comparator[] {
+  range = range.replace(RE_HYPHEN, hyphenReplace as any);
+  range = range.replace(RE_COMPTRIM, "$1$2$3");
+  range = range.replace(RE_TILDETRIM, "$1~");
+  range = range.replace(RE_CARETTRIM, "$1^");
+  const list = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(RE_GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const s of list) {
+    const c = new Comparator(s);
+    if (isNullSet(c)) return [c];
+    map.set(c.value, c);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+function parseRangeSet(range: string): Comparator[][] {
+  if (typeof range !== "string") throw new TypeError("Invalid range");
+  const raw = range.trim().replace(/\s+/g, " ");
+  let set = raw.split("||").map((r) => parseRange(r.trim())).filter((c) => c.length);
+  if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (set.length > 1) {
+    const first = set[0];
+    set = set.filter((c) => !isNullSet(c[0]));
+    if (!set.length) set = [first];
+    else if (set.length > 1) {
+      const any = set.find((c) => c.length === 1 && isAny(c[0]));
+      if (any) set = [any];
+    }
+  }
+  return set;
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => c.test(v))) return false;
+  if (v.prerelease.length) {
+    return set.some(
+      (c) =>
+        c.semver !== ANY &&
+        c.semver.prerelease.length > 0 &&
+        c.semver.major === v.major &&
+        c.semver.minor === v.minor &&
+        c.semver.patch === v.patch,
+    );
+  }
+  return true;
+}
+
+function tryParse<T>(f: () => T): T | null {
+  try {
+    return f();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(set: Comparator[][], version: string): boolean {
+  const v = tryParse(() => new SemVer(version));
+  return !!v && set.some((s) => testSet(s, v));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = tryParse(() => parseRangeSet(range));
+  return !!set && testRange(set, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = tryParse(() => parseRangeSet(range));
+  if (!set) return null;
+  let max: string | null = null;
+  let maxSV: SemVer | null = null;
+  for (const v of versions) {
+    if (testRange(set, v) && (!maxSV || maxSV.compare(new SemVer(v)) === -1)) {
+      max = v;
+      maxSV = new SemVer(v);
+    }
+  }
+  return max;
 }
