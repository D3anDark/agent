+// Port of node-semver v7 range matching (default options: not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_INTEGER = Number.MAX_SAFE_INTEGER;
+
+// ---- regex sources ----
+const NUMERICIDENTIFIER = "0|[1-9]\\d*";
+const NUMERICIDENTIFIERLOOSE = "\\d+";
+const NONNUMERICIDENTIFIER = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAINVERSION = `(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})\\.(${NUMERICIDENTIFIER})`;
+const MAINVERSIONLOOSE = `(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})\\.(${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASEIDENTIFIER = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIER})`;
+const PRERELEASEIDENTIFIERLOOSE = `(?:${NONNUMERICIDENTIFIER}|${NUMERICIDENTIFIERLOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASEIDENTIFIER}(?:\\.${PRERELEASEIDENTIFIER})*))`;
+const PRERELEASELOOSE = `(?:-?(${PRERELEASEIDENTIFIERLOOSE}(?:\\.${PRERELEASEIDENTIFIERLOOSE})*))`;
+const BUILDIDENTIFIER = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILDIDENTIFIER}(?:\\.${BUILDIDENTIFIER})*))`;
+const FULLPLAIN = `v?${MAINVERSION}${PRERELEASE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAINVERSIONLOOSE}${PRERELEASELOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGEIDENTIFIER = `${NUMERICIDENTIFIER}|x|X|\\*`;
+const XRANGEPLAIN =
+  `[v=\\s]*(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:\\.(${XRANGEIDENTIFIER})` +
+  `(?:${PRERELEASE})?${BUILD}?` +
+  `)?)?`;
+const LONETILDE = "(?:~>?)";
+const LONECARET = "(?:\\^)";
+
+const RE_FULL = new RegExp(`^${FULLPLAIN}$`);
+const RE_XRANGE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const RE_TILDETRIM = new RegExp(`(\\s*)${LONETILDE}\\s+`, "g");
+const RE_TILDE = new RegExp(`^${LONETILDE}${XRANGEPLAIN}$`);
+const RE_CARETTRIM = new RegExp(`(\\s*)${LONECARET}\\s+`, "g");
+const RE_CARET = new RegExp(`^${LONECARET}${XRANGEPLAIN}$`);
+const RE_COMPARATOR = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const RE_COMPARATORTRIM = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const RE_HYPHENRANGE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const RE_BUILD = new RegExp(BUILD);
+const RE_STAR = /(<|>)?=?\s*\*/;
+const RE_GTE0 = /^\s*>=\s*0\.0\.0\s*$/;
+
+// ---- identifiers ----
+type Id = string | number;
+const numeric = /^[0-9]+$/;
+function compareIdentifiers(a: Id, b: Id): number {
+  const anum = numeric.test(String(a));
+  const bnum = numeric.test(String(b));
+  if (anum && bnum) {
+    a = +a;
+    b = +b;
+  }
+  return a === b ? 0 : anum && !bnum ? -1 : bnum && !anum ? 1 : a < b ? -1 : 1;
+}
+
+// ---- SemVer ----
+class SemVer {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Id[];
+  version: string;
+
+  constructor(version: string) {
+    if (typeof version !== "string") throw new TypeError("Invalid version");
+    if (version.length > MAX_LENGTH) throw new TypeError("version too long");
+    const m = version.trim().match(RE_FULL);
+    if (!m) throw new TypeError(`Invalid Version: ${version}`);
+    this.major = +m[1]!;
+    this.minor = +m[2]!;
+    this.patch = +m[3]!;
+    for (const n of [this.major, this.minor, this.patch]) {
+      if (n > MAX_SAFE_INTEGER || n < 0) throw new TypeError("Invalid version number");
+    }
+    this.prerelease = !m[4]
+      ? []
+      : m[4].split(".").map((id) => {
+          if (/^[0-9]+$/.test(id)) {
+            const num = +id;
+            if (num >= 0 && num < MAX_SAFE_INTEGER) return num;
+          }
+          return id;
+        });
+    this.version = `${this.major}.${this.minor}.${this.patch}`;
+    if (this.prerelease.length) this.version += `-${this.prerelease.join(".")}`;
+  }
+
+  compare(other: SemVer): number {
+    return this.compareMain(other) || this.comparePre(other);
+  }
+
+  compareMain(other: SemVer): number {
+    return (
+      compareIdentifiers(this.major, other.major) ||
+      compareIdentifiers(this.minor, other.minor) ||
+      compareIdentifiers(this.patch, other.patch)
+    );
+  }
+
+  comparePre(other: SemVer): number {
+    if (this.prerelease.length && !other.prerelease.length) return -1;
+    if (!this.prerelease.length && other.prerelease.length) return 1;
+    if (!this.prerelease.length && !other.prerelease.length) return 0;
+    let i = 0;
+    do {
+      const a = this.prerelease[i];
+      const b = other.prerelease[i];
+      if (a === undefined && b === undefined) return 0;
+      if (b === undefined) return 1;
+      if (a === undefined) return -1;
+      if (a === b) continue;
+      return compareIdentifiers(a, b);
+    } while (++i);
+    return 0;
+  }
+}
+
+// ---- Comparator ----
+class Comparator {
+  operator: string;
+  semver: SemVer | null; // null = ANY
+  value: string;
+
+  constructor(comp: string) {
+    comp = comp.trim().split(/\s+/).join(" ");
+    const m = comp.match(RE_COMPARATOR);
+    if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+    this.operator = m[1] !== undefined ? m[1] : "";
+    if (this.operator === "=") this.operator = "";
+    this.semver = m[2] ? new SemVer(m[2]) : null;
+    this.value = this.semver ? this.operator + this.semver.version : "";
+  }
+
+  test(version: SemVer): boolean {
+    if (!this.semver) return true;
+    const c = version.compare(this.semver);
+    switch (this.operator) {
+      case "":
+        return c === 0;
+      case ">":
+        return c > 0;
+      case ">=":
+        return c >= 0;
+      case "<":
+        return c < 0;
+      case "<=":
+        return c <= 0;
+      default:
+        throw new TypeError(`Invalid operator: ${this.operator}`);
+    }
+  }
+}
+
+// ---- range desugaring ----
+const isX = (id: string | undefined): boolean => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceTilde(comp: string): string {
+  return comp.replace(RE_TILDE, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(RE_CARET, (_: string, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lo = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lo} <${M}.${m}.${+p + 1}-0`;
+      return `${lo} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lo} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(
+    RE_XRANGE,
+    (ret: string, gtlt: string, M: string | number, m: string | number, p: string | number) => {
+      if (
+        (isX(M as string) && !isX(m as string)) ||
+        (isX(m as string) && p && !isX(p as string))
+      ) {
+        return comp;
+      }
+      const xM = isX(M as string);
+      const xm = xM || isX(m as string);
+      const xp = xm || isX(p as string);
+      const anyX = xp;
+      if (gtlt === "=" && anyX) gtlt = "";
+      let pr = "";
+      if (xM) {
+        ret = gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      } else if (gtlt && anyX) {
+        if (xm) m = 0;
+        p = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            M = +M + 1;
+            m = 0;
+            p = 0;
+          } else {
+            m = +m + 1;
+            p = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) M = +M + 1;
+          else m = +m + 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        ret = `${gtlt + M}.${m}.${p}${pr}`;
+      } else if (xm) {
+        ret = `>=${M}.0.0${pr} <${+M + 1}.0.0-0`;
+      } else if (xp) {
+        ret = `>=${M}.${m}.0${pr} <${M}.${+m + 1}.0-0`;
+      }
+      return ret;
+    },
+  );
+}
+
+function parseComparator(comp: string): string {
+  comp = comp.replace(RE_BUILD, "");
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  comp = comp.trim().replace(RE_STAR, "");
+  return comp;
+}
+
+function hyphenReplace(
+  _0: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+function parseRange(range: string): Comparator[] {
+  range = range.replace(RE_HYPHENRANGE, hyphenReplace as (...a: any[]) => string);
+  range = range.replace(RE_COMPARATORTRIM, "$1$2$3");
+  range = range.replace(RE_TILDETRIM, "$1~");
+  range = range.replace(RE_CARETTRIM, "$1^");
+  const rangeList = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((c) => c.trim().replace(RE_GTE0, ""));
+  const map = new Map<string, Comparator>();
+  for (const s of rangeList) {
+    const comp = new Comparator(s);
+    if (isNullSet(comp)) return [comp];
+    map.set(comp.value, comp);
+  }
+  if (map.size > 1 && map.has("")) map.delete("");
+  return [...map.values()];
+}
+
+class Range {
+  set: Comparator[][];
+
+  constructor(range: string) {
+    if (typeof range !== "string") throw new TypeError("Invalid range");
+    const raw = range.trim().split(/\s+/).join(" ");
+    let set = raw
+      .split("||")
+      .map((r) => parseRange(r.trim()))
+      .filter((c) => c.length);
+    if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+    if (set.length > 1) {
+      const first = set[0]!;
+      set = set.filter((c) => !isNullSet(c[0]!));
+      if (set.length === 0) set = [first];
+      else if (set.length > 1) {
+        for (const c of set) {
+          if (c.length === 1 && isAny(c[0]!)) {
+            set = [c];
+            break;
+          }
+        }
+      }
+    }
+    this.set = set;
+  }
+
+  test(version: string): boolean {
+    let v: SemVer;
+    try {
+      v = new SemVer(version);
+    } catch {
+      return false;
+    }
+    return this.set.some((s) => testSet(s, v));
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  for (const c of set) if (!c.test(version)) return false;
+  if (version.prerelease.length) {
+    for (const c of set) {
+      if (!c.semver) continue;
+      if (c.semver.prerelease.length > 0) {
+        const a = c.semver;
+        if (a.major === version.major && a.minor === version.minor && a.patch === version.patch) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+  return true;
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  let r: Range;
+  try {
+    r = new Range(range);
+  } catch {
+    return false;
+  }
+  return r.test(version);
 }
 
