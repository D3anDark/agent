+// A port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+// The regex sources mirror node-semver's `safeRe`, which bounds `\s*`, `\d*` and `[a-zA-Z0-9-]*`.
+
+const MAX_LENGTH = 256;
+const MAX_BUILD_LENGTH = MAX_LENGTH - 6;
+
+const NUMERIC = `0|[1-9]\\d{0,${MAX_LENGTH}}`;
+const NUMERIC_LOOSE = `\\d{1,${MAX_LENGTH}}`;
+const NON_NUMERIC = `\\d{0,${MAX_LENGTH}}[a-zA-Z-][a-zA-Z0-9-]{0,${MAX_BUILD_LENGTH}}`;
+const PRERELEASE_ID = `(?:${NON_NUMERIC}|${NUMERIC})`;
+const PRERELEASE_ID_LOOSE = `(?:${NON_NUMERIC}|${NUMERIC_LOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRERELEASE_ID_LOOSE}(?:\\.${PRERELEASE_ID_LOOSE})*))`;
+const BUILD_ID = `[a-zA-Z0-9-]{1,${MAX_BUILD_LENGTH}}`;
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const X_ID = `${NUMERIC}|x|X|\\*`;
+const X_RANGE_PLAIN = `[v=\\s]*(${X_ID})(?:\\.(${X_ID})(?:\\.(${X_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s{0,1}(${FULL_PLAIN})$|^$`);
+const HYPHEN_RANGE_RE = new RegExp(
+  `^\\s{0,1}(${X_RANGE_PLAIN})\\s{1,1}-\\s{1,1}(${X_RANGE_PLAIN})\\s{0,1}$`,
+);
+const COMPARATOR_TRIM_RE = new RegExp(
+  `(\\s{0,1})${GTLT}\\s{0,1}(${LOOSE_PLAIN}|${X_RANGE_PLAIN})`,
+  "g",
+);
+const TILDE_TRIM_RE = /(\s{0,1})(?:~>?)\s{1,1}/g;
+const CARET_TRIM_RE = /(\s{0,1})(?:\^)\s{1,1}/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${X_RANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${X_RANGE_PLAIN}$`);
+const X_RANGE_RE = new RegExp(`^${GTLT}\\s{0,1}${X_RANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s{0,1}\*/;
+const GTE0_RE = /^\s{0,1}>=\s{0,1}0\.0\.0\s{0,1}$/;
+const BUILD_RE = new RegExp(BUILD);
+const BUILD_STRIP_RE = /(?:\+([a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*))/g;
+
+type Version = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: string[];
+};
+
+type Operator = "" | "<" | "<=" | ">" | ">=";
+
+// `version: null` is node-semver's ANY comparator, which matches every version.
+type Comparator = {
+  operator: Operator;
+  version: Version | null;
+  value: string;
+};
+
+type ComparatorSet = Comparator[];
+
+const NULL_SET_VALUE = "<0.0.0-0";
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = parseRange(range);
+  const parsed = parseVersion(version);
+  if (!sets || !parsed) return false;
+  return sets.some((set) => testSet(set, parsed));
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = parseRange(range);
+  if (!sets) return null;
+
+  let max: { text: string; version: Version } | null = null;
+  for (const text of versions) {
+    const version = parseVersion(text);
+    if (!version || !sets.some((set) => testSet(set, version))) continue;
+    if (!max || compareVersions(max.version, version) === -1) max = { text, version };
+  }
+  return max?.text ?? null;
+}
+
+function parseVersion(text: string): Version | null {
+  if (text.length > MAX_LENGTH) return null;
+  const match = text.trim().match(FULL_RE);
+  if (!match) return null;
+
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  if (major > Number.MAX_SAFE_INTEGER) return null;
+  if (minor > Number.MAX_SAFE_INTEGER) return null;
+  if (patch > Number.MAX_SAFE_INTEGER) return null;
+
+  return { major, minor, patch, prerelease: match[4] ? match[4].split(".") : [] };
+}
+
+function formatVersion(version: Version): string {
+  const main = `${version.major}.${version.minor}.${version.patch}`;
+  return version.prerelease.length ? `${main}-${version.prerelease.join(".")}` : main;
+}
+
+function compareVersions(a: Version, b: Version): number {
+  return compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePrereleases(a.prerelease, b.prerelease);
+}
+
+function compareNumbers(a: number, b: number): number {
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function comparePrereleases(a: string[], b: string[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    const order = compareIdentifiers(a[i], b[i]);
+    if (order !== 0) return order;
+  }
+}
+
+function compareIdentifiers(a: string, b: string): number {
+  const aNumeric = /^[0-9]+$/.test(a);
+  const bNumeric = /^[0-9]+$/.test(b);
+  if (aNumeric && bNumeric) return compareNumbers(Number(a), Number(b));
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function testSet(set: ComparatorSet, version: Version): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (!version.prerelease.length) return true;
+
+  // ^1.2.3-pr.1 lets 1.2.3-pr.2 through, but never 1.2.4-alpha.
+  return set.some(({ version: allowed }) =>
+    allowed !== null &&
+    allowed.prerelease.length > 0 &&
+    allowed.major === version.major &&
+    allowed.minor === version.minor &&
+    allowed.patch === version.patch
+  );
+}
+
+function testComparator(comparator: Comparator, version: Version): boolean {
+  if (!comparator.version) return true;
+  const order = compareVersions(version, comparator.version);
+  switch (comparator.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+function parseRange(range: string): ComparatorSet[] | null {
+  const raw = range.trim().replace(/\s+/g, " ");
+  const sets: ComparatorSet[] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    sets.push(set);
+  }
+  return dropRedundantSets(sets);
+}
+
+function dropRedundantSets(sets: ComparatorSet[]): ComparatorSet[] {
+  if (sets.length === 1) return sets;
+  const meaningful = sets.filter((set) => set[0].value !== NULL_SET_VALUE);
+  if (meaningful.length === 0) return [sets[0]];
+  const any = meaningful.find((set) => set.length === 1 && set[0].value === "");
+  return any ? [any] : meaningful;
+}
+
+function parseComparatorSet(range: string): ComparatorSet | null {
+  const desugared = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RANGE_RE, replaceHyphen)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^")
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const text of desugared) {
+    const comparator = parseComparator(text);
+    if (!comparator) return null;
+    comparators.push(comparator);
+  }
+
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (comparator.value === NULL_SET_VALUE) return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(text: string): Comparator | null {
+  const match = text.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) return null;
+
+  const gtlt = match[1] ?? "";
+  const operator = gtlt === "=" ? "" : gtlt;
+  if (!isOperator(operator)) return null;
+  if (!match[2]) return { operator, version: null, value: "" };
+
+  const version = parseVersion(match[2]);
+  if (!version) return null;
+  return { operator, version, value: operator + formatVersion(version) };
+}
+
+function isOperator(text: string): text is Operator {
+  return text === "" || text === "<" || text === "<=" || text === ">" || text === ">=";
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.replace(BUILD_RE, "").trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xRanges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xRanges.trim().replace(STAR_RE, "");
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+// ~1.2.3 := >=1.2.3 <1.3.0-0, ~1.2 := >=1.2.0 <1.3.0-0, ~1 := >=1.0.0 <2.0.0-0
+function replaceTilde(comp: string): string {
+  const match = comp.match(TILDE_RE);
+  if (!match) return comp;
+  const [, M, m, p, pr] = match;
+
+  if (isX(M)) return "";
+  if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+  if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+  const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+  return `>=${from} <${M}.${+m + 1}.0-0`;
+}
+
+// ^1.2.3 := >=1.2.3 <2.0.0-0, ^0.2.3 := >=0.2.3 <0.3.0-0, ^0.0.3 := >=0.0.3 <0.0.4-0
+function replaceCaret(comp: string): string {
+  const match = comp.match(CARET_RE);
+  if (!match) return comp;
+  const [, M, m, p, pr] = match;
+
+  if (isX(M)) return "";
+  if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+  if (isX(p)) {
+    if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+  }
+
+  const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+  if (M !== "0") return `>=${from} <${+M + 1}.0.0-0`;
+  if (m !== "0") return `>=${from} <${M}.${+m + 1}.0-0`;
+  return `>=${from} <${M}.${m}.${+p + 1}-0`;
+}
+
+// 1.x := >=1.0.0 <2.0.0-0, >1.2 := >=1.3.0, <=1.x := <2.0.0-0, >* := <0.0.0-0
+function replaceXRange(comp: string): string {
+  const trimmed = comp.trim();
+  const match = trimmed.match(X_RANGE_RE);
+  if (!match) return trimmed;
+  const [, gtlt, M, m, p] = match;
+
+  if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return trimmed;
+
+  const xMajor = isX(M);
+  const xMinor = xMajor || isX(m);
+  const xPatch = xMinor || isX(p);
+  const operator = gtlt === "=" && xPatch ? "" : gtlt;
+
+  if (xMajor) return operator === ">" || operator === "<" ? NULL_SET_VALUE : "*";
+
+  if (operator && xPatch) {
+    if (operator === ">") {
+      return xMinor ? `>=${+M + 1}.0.0` : `>=${M}.${+m + 1}.0`;
+    }
+    if (operator === "<=") {
+      return xMinor ? `<${+M + 1}.0.0-0` : `<${M}.${+m + 1}.0-0`;
+    }
+    const lower = xMinor ? `${M}.0.0` : `${M}.${m}.0`;
+    return operator === "<" ? `<${lower}-0` : `${operator}${lower}`;
+  }
+
+  if (xMinor) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+  if (xPatch) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+  return trimmed;
+}
+
+// 1.2 - 2.3.4 := >=1.2.0 <=2.3.4, 1.2.3 - 2.3 := >=1.2.3 <2.4.0-0
+function replaceHyphen(
+  _match: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
 }
