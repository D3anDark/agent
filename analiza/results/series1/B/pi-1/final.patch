+// Port of node-semver v7 range logic with default options (strict, no includePrerelease).
+
+type SemVer = { major: number; minor: number; patch: number; prerelease: (string | number)[] };
+type Comparator = { operator: "" | "<" | "<=" | ">" | ">="; semver: SemVer | null; value: string };
+
+const NUM = "0|[1-9]\\d*";
+const PRERELEASE_ID = `(?:\\d*[a-zA-Z-][a-zA-Z0-9-]*|${NUM})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const BUILD = "(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))";
+const FULLPLAIN = `v?(${NUM})\\.(${NUM})\\.(${NUM})${PRERELEASE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULLPLAIN}$`);
+const BUILD_RE = new RegExp(BUILD, "g");
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${XRANGEPLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = parseRange(range);
+  const semver = parseVersion(version);
+  if (!set || !semver) return false;
+  return testRange(set, semver);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = parseRange(range);
+  if (!set) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const version of versions) {
+    const semver = parseVersion(version);
+    if (!semver || !testRange(set, semver)) continue;
+    if (!maxVersion || compare(maxVersion, semver) === -1) {
+      max = version;
+      maxVersion = semver;
+    }
+  }
+  return max;
+}
+
+function parseVersion(version: string): SemVer | null {
+  if (version.length > 256) return null;
+  const m = version.trim().match(FULL_RE);
+  if (!m) return null;
+  const [major, minor, patch] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  if (![major, minor, patch].every(Number.isSafeInteger)) return null;
+  const prerelease = m[4]
+    ? m[4].split(".").map((id) => {
+        const n = Number(id);
+        return /^[0-9]+$/.test(id) && n < Number.MAX_SAFE_INTEGER ? n : id;
+      })
+    : [];
+  return { major, minor, patch, prerelease };
+}
+
+function compare(a: SemVer, b: SemVer): -1 | 0 | 1 {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: SemVer["prerelease"], b: SemVer["prerelease"]): -1 | 0 | 1 {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (i >= a.length && i >= b.length) return 0;
+    if (i >= b.length) return 1;
+    if (i >= a.length) return -1;
+    const order = compareIdentifiers(a[i], b[i]);
+    if (order) return order;
+  }
+}
+
+function compareIdentifiers(a: string | number, b: string | number): -1 | 0 | 1 {
+  const aNumeric = typeof a === "number";
+  const bNumeric = typeof b === "number";
+  if (a === b) return 0;
+  if (aNumeric && !bNumeric) return -1;
+  if (bNumeric && !aNumeric) return 1;
+  return a < b ? -1 : 1;
+}
+
+function parseRange(range: string): Comparator[][] | null {
+  const raw = range.trim().split(/\s+/).join(" ");
+  const sets: Comparator[][] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    sets.push(set);
+  }
+  if (sets.length === 1) return sets;
+  const nonNull = sets.filter((set) => set[0].value !== "<0.0.0-0");
+  if (nonNull.length === 0) return [sets[0]];
+  const any = nonNull.find((set) => set.length === 1 && set[0].value === "");
+  return any ? [any] : nonNull;
+}
+
+function parseComparatorSet(range: string): Comparator[] | null {
+  const desugared = range
+    .replace(BUILD_RE, "")
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const list = desugared
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const text of list) {
+    const comparator = parseComparator(text);
+    if (!comparator) return null;
+    comparators.push(comparator);
+  }
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (comparator.value === "<0.0.0-0") return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(text: string): Comparator | null {
+  const m = text.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) return null;
+  const operator = (m[1] === "=" ? "" : (m[1] ?? "")) as Comparator["operator"];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  if (!semver) return null;
+  return { operator, semver, value: operator + format(semver) };
+}
+
+function format(v: SemVer): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+const inc = (id: string) => Number(id) + 1;
+
+function desugarComparator(comp: string): string {
+  const carets = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.trim().split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${inc(M)}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${inc(m!)}.0-0`;
+      return `>=${M}.${m}.0 <${inc(M)}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${inc(M)}.0.0-0`;
+    if (m !== "0") return `${from} <${M}.${inc(m!)}.0-0`;
+    return `${from} <${M}.${m}.${inc(p!)}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${inc(M)}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${inc(m!)}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${inc(m!)}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, operator: string, M: string, m?: string, p?: string) => {
+    // node-semver 7.8 leaves `x.1` and `1.x.3` untouched, so they fail to parse.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+    const xMajor = isX(M);
+    const xMinor = xMajor || isX(m);
+    const anyX = xMinor || isX(p);
+    const gtlt = operator === "=" && anyX ? "" : operator;
+
+    if (xMajor) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = Number(M);
+      let minor = xMinor ? 0 : Number(m);
+      let op = gtlt;
+      if (gtlt === ">") {
+        op = ">=";
+        if (xMinor) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+      } else if (gtlt === "<=") {
+        op = "<";
+        if (xMinor) major += 1;
+        else minor += 1;
+      }
+      return `${op}${major}.${minor}.0${op === "<" ? "-0" : ""}`;
+    }
+    if (xMinor) return `>=${M}.0.0 <${inc(M)}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${inc(m!)}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${inc(tM)}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${inc(tm!)}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function testRange(sets: Comparator[][], version: SemVer): boolean {
+  return sets.some((set) => testSet(set, version));
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function testComparator({ operator, semver }: Comparator, version: SemVer): boolean {
+  if (!semver) return true;
+  const order = compare(version, semver);
+  switch (operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
 }
