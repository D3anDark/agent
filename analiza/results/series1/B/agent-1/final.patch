+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+type SemVer = { major: number; minor: number; patch: number; prerelease: string[] };
+type Operator = "" | "<" | "<=" | ">" | ">=";
+type Comparator = { operator: Operator; semver: SemVer | null };
+
+const MAX_LENGTH = 256;
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[0-9A-Za-z-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XR_ID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XR_ID})(?:\\.(${XR_ID})(?:\\.(${XR_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)\^\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^\\^${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD);
+const STAR_RE = /(<|>)?=?\s*\*/;
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  let set: Comparator[][];
+  let parsed: SemVer;
+  try {
+    set = parseRange(range);
+    parsed = parseVersion(version);
+  } catch {
+    return false;
+  }
+  return testRange(set, parsed);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  let set: Comparator[][];
+  try {
+    set = parseRange(range);
+  } catch {
+    return null;
+  }
+  let max: { raw: string; semver: SemVer } | null = null;
+  for (const raw of versions) {
+    let semver: SemVer;
+    try {
+      semver = parseVersion(raw);
+    } catch {
+      continue;
+    }
+    if (!testRange(set, semver)) continue;
+    if (!max || compare(max.semver, semver) === -1) max = { raw, semver };
+  }
+  return max?.raw ?? null;
+}
+
+function parseVersion(version: string): SemVer {
+  if (version.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH} characters`);
+  const m = version.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${version}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map((part) => {
+    const n = Number(part);
+    if (n > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid version part: ${part}`);
+    return n;
+  });
+  return { major, minor, patch, prerelease: m[4] ? m[4].split(".") : [] };
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  return raw.split("||").map((part) => parseComparatorSet(part.trim()));
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  const normalized = range
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comparators = normalized
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map(parseComparator);
+  const meaningful = comparators.filter((c) => c.semver !== null);
+  return meaningful.length > 0 ? meaningful : comparators.slice(0, 1);
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  if (m[2] === undefined) return { operator: "", semver: null };
+  const operator = m[1] === "=" ? "" : (m[1] as Operator);
+  return { operator, semver: parseVersion(m[2]) };
+}
+
+function desugarComparator(comp: string): string {
+  const withoutBuild = comp.replace(BUILD_RE, "");
+  const carets = withoutBuild.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.trim().split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${from} <${M}.${+m! + 1}.0-0`;
+    return `${from} <${M}.${m}.${+p! + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.replace(XRANGE_RE, (whole: string, gtlt: string, M: string, m?: string, p?: string) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major += 1;
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  ...[, from, fM, fm, fp, fpr, , to, tM, tm, tp, tpr]: string[]
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function testRange(set: Comparator[][], version: SemVer): boolean {
+  return set.some((comparators) => testSet(comparators, version));
+}
+
+function testSet(comparators: Comparator[], version: SemVer): boolean {
+  if (!comparators.every((c) => testComparator(c, version))) return false;
+  if (version.prerelease.length === 0) return true;
+  return comparators.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function testComparator({ operator, semver }: Comparator, version: SemVer): boolean {
+  if (semver === null) return true;
+  const order = compare(version, semver);
+  switch (operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function compareNumbers(a: number, b: number): number {
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function comparePrerelease(a: string[], b: string[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    if (a[i] === b[i]) continue;
+    return compareIdentifiers(a[i], b[i]);
+  }
+}
+
+function compareIdentifiers(a: string, b: string): number {
+  const aNumeric = /^[0-9]+$/.test(a);
+  const bNumeric = /^[0-9]+$/.test(b);
+  if (aNumeric && bNumeric) return compareNumbers(Number(a), Number(b));
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  return a < b ? -1 : 1;
 }
