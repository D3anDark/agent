+++ b/src/semver.ts
@@ -1,8 +1,291 @@
+// Port of node-semver v7 range semantics with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NON_NUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAIN_LOOSE = `(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})`;
+const PRID = `(?:${NUM}|${NON_NUM})`;
+const PRID_LOOSE = `(?:${NUM_LOOSE}|${NON_NUM})`;
+const PRERELEASE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRID_LOOSE}(?:\\.${PRID_LOOSE})*))`;
+const BUILD = "(?:\\+([a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*))";
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+type Identifier = string | number;
+type SemVer = { major: number; minor: number; patch: number; prerelease: Identifier[]; version: string };
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Version is longer than ${MAX_LENGTH} characters`);
+  const match = input.trim().match(FULL_RE);
+  if (!match) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  for (const part of [major, minor, patch]) {
+    if (part > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid Version: ${input}`);
+  }
+  const prerelease: Identifier[] = [];
+  for (const id of match[4] ? match[4].split(".") : []) {
+    const num = Number(id);
+    prerelease.push(/^[0-9]+$/.test(id) && num < Number.MAX_SAFE_INTEGER ? num : id);
+  }
+  let version = `${major}.${minor}.${patch}`;
+  if (prerelease.length) version += `-${prerelease.join(".")}`;
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) {
+    a = Number(a);
+    b = Number(b);
+  }
+  if (a === b) return 0;
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p! + 1}-0`;
+      return `${from} <${M}.${+m! + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m! + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE_RE, (whole: string, gtlt: string, M: string, mRaw?: string, pRaw?: string) => {
+      // semver 7.8 leaves "1.*.3" or "*.1" untouched, so the comparator later fails to parse.
+      if ((isX(M) && !isX(mRaw)) || (isX(mRaw) && pRaw && !isX(pRaw))) return whole;
+      const xM = isX(M);
+      const xm = xM || isX(mRaw);
+      const xp = xm || isX(pRaw);
+      if (gtlt === "=" && xp) gtlt = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && xp) {
+        let major = +M;
+        let minor = xm ? 0 : +mRaw!;
+        let patch = 0;
+        let pr = "";
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            major += 1;
+            minor = 0;
+          } else {
+            minor += 1;
+          }
+          patch = 0;
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major += 1;
+          else minor += 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt}${major}.${minor}.${patch}${pr}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${mRaw}.0 <${M}.${+mRaw! + 1}.0-0`;
+      return whole;
+    });
+}
+
+function eachWord(comp: string, replace: (word: string) => string): string {
+  return comp.trim().split(/\s+/).map(replace).join(" ");
+}
+
+function parseComparatorString(comp: string): string {
+  comp = comp.replace(BUILD_RE, "");
+  comp = eachWord(comp, replaceCaret);
+  comp = eachWord(comp, replaceTilde);
+  comp = eachWord(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function hyphenReplace(
+  _: string,
+  from: string, fM: string, fm: string | undefined, fp: string | undefined, fpr: string | undefined, _fb: string | undefined,
+  to: string, tM: string, tm: string | undefined, tp: string | undefined, tpr: string | undefined,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+
+  return `${from} ${to}`.trim();
+}
+
+function parseComparator(comp: string): Comparator {
+  const match = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = match[1] === "=" || match[1] === undefined ? "" : match[1];
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(match[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range.replace(HYPHEN_RE, hyphenReplace);
+  range = range.replace(COMPARATOR_TRIM_RE, "$1$2$3");
+  range = range.replace(TILDE_TRIM_RE, "$1~");
+  range = range.replace(CARET_TRIM_RE, "$1^");
+  const words = range
+    .split(" ")
+    .map(parseComparatorString)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  // Parse every word before the "<0.0.0-0" shortcut: semver rejects "> X 01" as invalid, not as empty.
+  const comparators = words.map(parseComparator);
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (comparator.value === "<0.0.0-0") return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((part) => parseComparatorSet(part.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => set[0].value !== "<0.0.0-0");
+    if (!sets.length) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (any) return [any];
+  }
+  return sets;
+}
+
+function testComparator(comparator: Comparator, version: SemVer): boolean {
+  if (!comparator.semver) return true;
+  const order = compare(version, comparator.semver);
+  switch (comparator.operator) {
+    case "": return order === 0;
+    case ">": return order > 0;
+    case ">=": return order >= 0;
+    case "<": return order < 0;
+    case "<=": return order <= 0;
+    default: throw new TypeError(`Invalid operator: ${comparator.operator}`);
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): SemVer | null {
+  const parsed = tryParse(() => parseVersion(version));
+  if (!parsed) return null;
+  return sets.some((set) => testSet(set, parsed)) ? parsed : null;
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version) !== null;
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: { raw: string; semver: SemVer } | null = null;
+  for (const raw of versions) {
+    const semver = testRange(sets, raw);
+    if (semver && (!max || compare(max.semver, semver) < 0)) max = { raw, semver };
+  }
+  return max?.raw ?? null;
 }
