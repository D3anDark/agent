+// Port of node-semver v7 (default options: strict, includePrerelease off).
+
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAIN_LOOSE = `(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})`;
+const PRE_ID = `(?:${NUM}|${NONNUM})`;
+const PRE_ID_LOOSE = `(?:${NUM_LOOSE}|${NONNUM})`;
+const PRE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)~>?\s+/g;
+const CARET_TRIM_RE = /(\s*)\^\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+
+type Version = { major: number; minor: number; patch: number; prerelease: (string | number)[] };
+type Comparator = { operator: string; version: Version | null };
+
+function parseVersion(text: string): Version | null {
+  const trimmed = text.trim();
+  if (trimmed.length > 256) return null;
+  const m = trimmed.match(FULL_RE);
+  if (!m) return null;
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) return null;
+  const prerelease = m[4]
+    ? m[4].split(".").map((id) => (/^[0-9]+$/.test(id) && +id < Number.MAX_SAFE_INTEGER ? +id : id))
+    : [];
+  return { major, minor, patch, prerelease };
+}
+
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const aNum = typeof a === "number";
+  const bNum = typeof b === "number";
+  if (a === b) return 0;
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  for (const key of ["major", "minor", "patch"] as const) {
+    if (a[key] !== b[key]) return a[key] < b[key] ? -1 : 1;
+  }
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    const c = compareIdentifiers(x, y);
+    if (c !== 0) return c;
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceHyphen(
+  _all: string,
+  from: string, fM: string, fm: string, fp: string, fpr: string, _fb: string,
+  to: string, tM: string, tm: string, tp: string, tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (all, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const low = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${low} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${low} <${M}.${+m + 1}.0-0`;
+    return `${low} <${M}.${m}.${+p + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (all, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.replace(XRANGE_RE, (all, op: string, M: string, m: string, p: string) => {
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return all;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (op === "=" && anyX) op = "";
+    if (xM) return op === ">" || op === "<" ? "<0.0.0-0" : "*";
+    if (op && anyX) {
+      let [major, minor, patch] = [+M, xm ? 0 : +m, 0];
+      if (op === ">") {
+        op = ">=";
+        if (xm) [major, minor] = [major + 1, 0];
+        else minor += 1;
+      } else if (op === "<=") {
+        op = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${op}${major}.${minor}.${patch}${op === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return all;
+  });
+}
+
+const mapTokens = (comp: string, fn: (token: string) => string) => comp.trim().split(/\s+/).map(fn).join(" ");
+
+function parseComparatorText(comp: string): string {
+  comp = mapTokens(comp, replaceCaret);
+  comp = mapTokens(comp, replaceTilde);
+  comp = mapTokens(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function parseComparator(text: string): Comparator {
+  const m = text.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${text}`);
+  const operator = m[1] === "=" ? "" : (m[1] ?? "");
+  if (!m[2]) return { operator, version: null };
+  const version = parseVersion(m[2]);
+  if (!version) throw new TypeError(`Invalid version: ${m[2]}`);
+  return { operator, version };
+}
+
+function parseSet(range: string): Comparator[] {
+  range = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RE, replaceHyphen)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  return range
+    .split(" ")
+    .map(parseComparatorText)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => parseComparator(comp.trim().replace(GTE0_RE, "")));
+}
+
+function parseRange(range: string): Comparator[][] | null {
+  try {
+    const sets = range.trim().split(/\s+/).join(" ").split("||").map((set) => parseSet(set.trim()));
+    // node-semver collapses the whole range to a lone `*` set, which then rejects prereleases.
+    const anySet = sets.find((set) => set.every((comp) => comp.version === null));
+    return anySet ? [anySet] : sets;
+  } catch {
+    return null;
+  }
+}
+
+function testComparator({ operator, version: target }: Comparator, version: Version): boolean {
+  if (!target) return true;
+  const c = compare(version, target);
+  switch (operator) {
+    case "": return c === 0;
+    case "<": return c < 0;
+    case "<=": return c <= 0;
+    case ">": return c > 0;
+    case ">=": return c >= 0;
+    default: throw new Error(`Unknown operator: ${operator}`);
+  }
+}
+
+function testSet(set: Comparator[], version: Version): boolean {
+  if (!set.every((comp) => testComparator(comp, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ version: v }) =>
+      v !== null &&
+      v.prerelease.length > 0 &&
+      v.major === version.major &&
+      v.minor === version.minor &&
+      v.patch === version.patch,
+  );
+}
+
+const testRange = (sets: Comparator[][], version: Version) => sets.some((set) => testSet(set, version));
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = parseRange(range);
+  const parsed = parseVersion(version);
+  if (!sets || !parsed) return false;
+  return testRange(sets, parsed);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = parseRange(range);
+  if (!sets) return null;
+  let max: { text: string; version: Version } | null = null;
+  for (const text of versions) {
+    const version = parseVersion(text);
+    if (!version || !testRange(sets, version)) continue;
+    if (!max || compare(max.version, version) < 0) max = { text, version };
+  }
+  return max?.text ?? null;
 }
