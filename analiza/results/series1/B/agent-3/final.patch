+// Port of node-semver v7 range semantics (default options: not loose, no includePrerelease).
+
+type Identifier = string | number;
+
+type Version = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: Version | null; value: string };
+
+const MAX_LENGTH = 256;
+
+const NUMERIC_ID = "0|[1-9]\\d*";
+const NON_NUMERIC_ID = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const PRERELEASE_ID = `(?:${NON_NUMERIC_ID}|${NUMERIC_ID})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const PRERELEASE_LOOSE_ID = `(?:${NON_NUMERIC_ID}|\\d+)`;
+const PRERELEASE_LOOSE = `(?:-?(${PRERELEASE_LOOSE_ID}(?:\\.${PRERELEASE_LOOSE_ID})*))`;
+const BUILD = "(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))";
+const MAIN = `(${NUMERIC_ID})\\.(${NUMERIC_ID})\\.(${NUMERIC_ID})`;
+const MAIN_LOOSE = "(\\d+)\\.(\\d+)\\.(\\d+)";
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XR_ID = `${NUMERIC_ID}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XR_ID})(?:\\.(${XR_ID})(?:\\.(${XR_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = parseRange(range);
+  const parsed = parseVersion(version);
+  if (!set || !parsed) return false;
+  return testRange(set, parsed);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = parseRange(range);
+  if (!set) return null;
+  let max: string | null = null;
+  let maxVersion: Version | null = null;
+  for (const raw of versions) {
+    const version = parseVersion(raw);
+    if (!version || !testRange(set, version)) continue;
+    if (!maxVersion || compare(maxVersion, version) === -1) {
+      max = raw;
+      maxVersion = version;
+    }
+  }
+  return max;
+}
+
+function parseVersion(raw: string): Version | null {
+  if (raw.length > MAX_LENGTH) return null;
+  const match = raw.trim().match(FULL_RE);
+  if (!match) return null;
+  const major = Number(match[1]);
+  const minor = Number(match[2]);
+  const patch = Number(match[3]);
+  if (![major, minor, patch].every(Number.isSafeInteger)) return null;
+  const prerelease: Identifier[] = [];
+  for (const id of match[4]?.split(".") ?? []) {
+    const num = Number(id);
+    prerelease.push(/^[0-9]+$/.test(id) && num < Number.MAX_SAFE_INTEGER ? num : id);
+  }
+  const main = `${major}.${minor}.${patch}`;
+  const version = prerelease.length ? `${main}-${prerelease.join(".")}` : main;
+  return { major, minor, patch, prerelease, version };
+}
+
+function compare(a: Version, b: Version): number {
+  return (
+    compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function compareNumbers(a: number, b: number): number {
+  return a < b ? -1 : a > b ? 1 : 0;
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a[i];
+    const y = b[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = typeof a === "number";
+  const bNum = typeof b === "number";
+  if (aNum && bNum) return compareNumbers(a, b);
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function parseRange(range: string): Comparator[][] | null {
+  const raw = range.trim().split(/\s+/).join(" ");
+  const sets: Comparator[][] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    if (set.length) sets.push(set);
+  }
+  if (!sets.length) return null;
+  if (sets.length === 1) return sets;
+
+  const nonNull = sets.filter((set) => set[0].value !== "<0.0.0-0");
+  if (!nonNull.length) return [sets[0]];
+  const anySet = nonNull.find((set) => set.length === 1 && set[0].value === "");
+  return anySet ? [anySet] : nonNull;
+}
+
+function parseComparatorSet(range: string): Comparator[] | null {
+  const trimmed = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comparatorStrings = trimmed
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const text of comparatorStrings) {
+    const comparator = parseComparator(text);
+    if (!comparator) return null;
+    comparators.push(comparator);
+  }
+
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (comparator.value === "<0.0.0-0") return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(text: string): Comparator | null {
+  const match = text.match(COMPARATOR_RE);
+  if (!match) return null;
+  const operator = match[1] === "=" || match[1] === undefined ? "" : match[1];
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(match[2]);
+  if (!semver) return null;
+  return { operator, semver, value: operator + semver.version };
+}
+
+function desugarComparator(comp: string): string {
+  let result = splitMap(comp, replaceCaret);
+  result = splitMap(result, replaceTilde);
+  result = splitMap(result, (c) => replaceXRange(c.trim()));
+  return result.trim().replace(STAR_RE, "");
+}
+
+function splitMap(comp: string, replace: (part: string) => string): string {
+  return comp.trim().split(/\s+/).map(replace).join(" ");
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${Number(p) + 1}-0`;
+      return `${from} <${M}.${Number(m) + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${Number(m) + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.replace(
+    XRANGE_RE,
+    (whole, gtlt: string, M: string, m?: string, p?: string) => {
+      // node-semver 7.8 leaves `x.1.2` and `1.x.3` unrewritten, so they fail as comparators.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const xp = xm || isX(p);
+      if (gtlt === "=" && xp) gtlt = "";
+
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && xp) {
+        let major = +M;
+        let minor = xm ? 0 : Number(m);
+        let patch = 0;
+        let pr = "";
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            major += 1;
+            minor = 0;
+            patch = 0;
+          } else {
+            minor += 1;
+            patch = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major += 1;
+          else minor += 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt}${major}.${minor}.${patch}${pr}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return whole;
+    },
+  );
+}
+
+function hyphenReplace(
+  _whole: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${Number(tm) + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function testRange(sets: Comparator[][], version: Version): boolean {
+  return sets.some((set) => testSet(set, version));
+}
+
+function testSet(set: Comparator[], version: Version): boolean {
+  for (const comparator of set) {
+    if (!testComparator(comparator, version)) return false;
+  }
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function testComparator({ operator, semver }: Comparator, version: Version): boolean {
+  if (!semver) return true;
+  const order = compare(version, semver);
+  switch (operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new Error(`Unknown operator: ${operator}`);
+  }
 }
