{"error":null,"id":"toolu_01R4xfxNSWaL3ouCMEPgjdwi","name":"bash","output":"export function parseCsv(text: string): string[][] {\n  return text\n    .split(\"\\n\")\n    .filter((line) => line.length > 0)\n    .map((line) => line.split(\",\"));\n}\nexport function parseAmount(raw: string): number {\n  const value = parseFloat(raw);\n  return Math.floor(value * 100);\n}\n\nexport function formatCents(cents: number): string {\n  return (cents / 100).toFixed(2);\n}\nimport { parseCsv } from \"./csv\";\nimport { parseAmount } from \"./money\";\n\nexport type Summary = {\n  totals: Map<string, number>;\n  skipped: number;\n};\n\nexport function summarize(csvText: string): Summary {\n  const rows = parseCsv(csvText).slice(1);\n  const totals = new Map<string, number>();\n  for (const [, category, , amount] of rows) {\n    totals.set(category, (totals.get(category) ?? 0) + parseAmount(amount));\n  }\n  return { totals, skipped: 0 };\n}\nimport { expect, test } from \"bun:test\";\nimport { parseCsv } from \"../src/csv\";\nimport { parseAmount } from \"../src/money\";\nimport { summarize } from \"../src/report\";\n\ntest(\"parses quoted fields with commas\", () => {\n  expect(parseCsv('a,\"b,c\",d\\n')).toEqual([[\"a\", \"b,c\", \"d\"]]);\n});\n\ntest(\"amounts are exact cents\", () => {\n  expect(parseAmount(\"0.29\")).toBe(29);\n  expect(parseAmount(\"-12.5\")).toBe(-1250);\n});\n\ntest(\"summarizes per category\", () => {\n  const csv = \"date,category,description,amount\\n2026-01-01,food,bread,3.10\\n2026-01-02,food,milk,0.29\\n\";\n  expect(summarize(csv).totals.get(\"food\")).toBe(339);\n});\n{\n  \"name\": \"ledger\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"test\": \"bun test\" }\n}\ndate,category,description,amount\n2026-01-03,food,\"Bread, rye\",3.10\n2026-01-04, travel ,\"Train \"\"express\"\"\",\"1,234.50\"\n2026-01-05,food,refund,-0.29\n2026-01-06,fun,\"Concert\nsecond line\",45\n\n--- Command finished with exit code: 0 ---\n","type":"tool_done"}
