diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..93eea5b
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort(([a, x], [b, y]) => y - x || (a < b ? -1 : a > b ? 1 : 0));
+let grand = 0;
+for (const [category, cents] of entries) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grand += cents;
+}
+console.log(`TOTAL\t${formatCents(grand)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..988e0bb 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,49 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let quoted = false;
+  let rowHasContent = false;
+  let i = 0;
+
+  const endField = () => {
+    row.push(field);
+    field = "";
+  };
+  const endRow = () => {
+    endField();
+    if (rowHasContent || row.length > 1) rows.push(row);
+    row = [];
+    rowHasContent = false;
+  };
+
+  while (i < text.length) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch === '"' && text[i + 1] === '"') {
+        field += '"';
+        i += 2;
+        continue;
+      }
+      if (ch === '"') quoted = false;
+      else field += ch;
+      i++;
+      continue;
+    }
+    if (ch === '"') {
+      quoted = true;
+      rowHasContent = true;
+    } else if (ch === ",") endField();
+    else if (ch === "\n") endRow();
+    else if (ch === "\r" && text[i + 1] === "\n") {
+      endRow();
+      i++;
+    } else {
+      field += ch;
+      rowHasContent = true;
+    }
+    i++;
+  }
+  if (field.length > 0 || row.length > 0 || rowHasContent) endRow();
+  return rows;
 }
