new file mode 100644
index 0000000..3df9dd4
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort(([a, x], [b, y]) => y - x || (a < b ? -1 : a > b ? 1 : 0));
+let grandTotal = 0;
+for (const [category, cents] of entries) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..f88117a 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,42 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let lineHasContent = false;
+
+  const endRow = () => {
+    if (lineHasContent) rows.push([...row, field]);
+    row = [];
+    field = "";
+    lineHasContent = false;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch !== '"') field += ch;
+      else if (text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else inQuotes = false;
+      continue;
+    }
+    if (ch === '"') {
+      inQuotes = true;
+      lineHasContent = true;
+    } else if (ch === ",") {
+      row.push(field);
+      field = "";
+      lineHasContent = true;
+    } else if (ch === "\n" || (ch === "\r" && text[i + 1] === "\n")) {
+      if (ch === "\r") i++;
+      endRow();
+    } else {
+      field += ch;
+      lineHasContent = true;
+    }
+  }
+  endRow();
+  return rows;
 }
