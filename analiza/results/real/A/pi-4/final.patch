diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..987e04d
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+for (const [category, cents] of entries) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..70b5983 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,39 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let quoted = false;
+  let lineHasContent = false;
+
+  const endRow = () => {
+    if (lineHasContent) rows.push([...row, field]);
+    row = [];
+    field = "";
+    lineHasContent = false;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (quoted) {
+      if (char !== '"') field += char;
+      else if (text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else quoted = false;
+      continue;
+    }
+    if (char === "\r" && text[i + 1] === "\n") continue;
+    if (char === "\n") {
+      endRow();
+      continue;
+    }
+    lineHasContent = true;
+    if (char === '"') quoted = true;
+    else if (char === ",") {
+      row.push(field);
+      field = "";
+    } else field += char;
+  }
+  endRow();
+  return rows;
 }
