diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..d63fa15
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const sorted = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+for (const [category, cents] of sorted) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..cbf3427 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,43 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let quoted = false;
+  let rowHasContent = false;
+
+  const endRow = () => {
+    row.push(field);
+    if (rowHasContent) rows.push(row);
+    row = [];
+    field = "";
+    rowHasContent = false;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch !== '"') field += ch;
+      else if (text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else quoted = false;
+      continue;
+    }
+    if (ch === '"') {
+      quoted = true;
+      rowHasContent = true;
+    } else if (ch === ",") {
+      row.push(field);
+      field = "";
+      rowHasContent = true;
+    } else if (ch === "\n" || (ch === "\r" && text[i + 1] === "\n")) {
+      if (ch === "\r") i++;
+      endRow();
+    } else {
+      field += ch;
+      rowHasContent = true;
+    }
+  }
+  endRow();
+  return rows;
 }
