+const AMOUNT = /^(-?)(\d+|\d{1,3}(?:,\d{3})+)(?:\.(\d{1,2}))?$/;
+
 export function parseAmount(raw: string): number {
-  const value = parseFloat(raw);
-  return Math.floor(value * 100);
+  const match = AMOUNT.exec(raw);
+  if (!match) throw new Error(`invalid amount: ${JSON.stringify(raw)}`);
+  const [, sign, integer, fraction = ""] = match;
+  const cents = Number(integer.replaceAll(",", "")) * 100 + Number(fraction.padEnd(2, "0"));
+  return sign ? -cents : cents;
 }
 
 export function formatCents(cents: number): string {
-  return (cents / 100).toFixed(2);
+  const abs = Math.abs(cents);
+  const fraction = String(abs % 100).padStart(2, "0");
+  return `${cents < 0 ? "-" : ""}${Math.floor(abs / 100)}.${fraction}`;
 }
