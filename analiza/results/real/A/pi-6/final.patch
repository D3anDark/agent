diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..d63fa15
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const sorted = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+for (const [category, cents] of sorted) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..eed01f9 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,42 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let i = 0;
+
+  const endRow = () => {
+    row.push(field);
+    const isBlankLine = row.length === 1 && row[0] === "";
+    if (!isBlankLine) rows.push(row);
+    row = [];
+    field = "";
+  };
+
+  while (i < text.length) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch === '"' && text[i + 1] === '"') {
+        field += '"';
+        i += 2;
+        continue;
+      }
+      if (ch === '"') inQuotes = false;
+      else field += ch;
+      i++;
+      continue;
+    }
+    if (ch === '"') inQuotes = true;
+    else if (ch === ",") {
+      row.push(field);
+      field = "";
+    } else if (ch === "\n") endRow();
+    else if (ch === "\r" && text[i + 1] === "\n") {
+      endRow();
+      i++;
+    } else field += ch;
+    i++;
+  }
+  endRow();
+  return rows;
 }
