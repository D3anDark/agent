diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..6edc306
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,27 @@
+import { readFileSync } from "node:fs";
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = readFileSync(path, "utf8");
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const sorted = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+for (const [category, cents] of sorted) {
+  console.log(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..25e4188 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,40 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let fieldQuoted = false;
+  let inQuotes = false;
+
+  const endRow = () => {
+    row.push(field);
+    const isBlankLine = row.length === 1 && field === "" && !fieldQuoted;
+    if (!isBlankLine) rows.push(row);
+    row = [];
+    field = "";
+    fieldQuoted = false;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    const char = text[i];
+    if (inQuotes) {
+      if (char !== '"') field += char;
+      else if (text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else inQuotes = false;
+    } else if (char === '"') {
+      inQuotes = true;
+      fieldQuoted = true;
+    } else if (char === ",") {
+      row.push(field);
+      field = "";
+      fieldQuoted = false;
+    } else if (char === "\n") endRow();
+    else if (char === "\r" && text[i + 1] === "\n") {
+      endRow();
+      i++;
+    } else field += char;
+  }
+  if (field !== "" || fieldQuoted || row.length > 0) endRow();
+  return rows;
 }
