diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..40a8150
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,26 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const entries = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+for (const [category, total] of entries) {
+  console.log(`${category}\t${formatCents(total)}`);
+  grandTotal += total;
+}
+console.log(`TOTAL\t${formatCents(grandTotal)}`);
+if (skipped > 0) console.error(`skipped: ${skipped}`);
diff --git a/src/csv.ts b/src/csv.ts
index 897c73d..aca188f 100644
--- a/src/csv.ts
+++ b/src/csv.ts
@@ -1,6 +1,42 @@
 export function parseCsv(text: string): string[][] {
-  return text
-    .split("\n")
-    .filter((line) => line.length > 0)
-    .map((line) => line.split(","));
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = "";
+  let inQuotes = false;
+  let fieldStarted = false;
+
+  const endRow = () => {
+    if (fieldStarted || row.length > 0) rows.push([...row, field]);
+    row = [];
+    field = "";
+    fieldStarted = false;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch !== '"') field += ch;
+      else if (text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else inQuotes = false;
+      continue;
+    }
+    if (ch === '"') {
+      inQuotes = true;
+      fieldStarted = true;
+    } else if (ch === ",") {
+      row.push(field);
+      field = "";
+      fieldStarted = true;
+    } else if (ch === "\n" || (ch === "\r" && text[i + 1] === "\n")) {
+      if (ch === "\r") i++;
+      endRow();
+    } else {
+      field += ch;
+      fieldStarted = true;
+    }
+  }
+  endRow();
+  return rows;
 }
