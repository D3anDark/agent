diff --git a/src/cli.ts b/src/cli.ts
new file mode 100644
index 0000000..f877a75
--- /dev/null
+++ b/src/cli.ts
@@ -0,0 +1,28 @@
+import { formatCents } from "./money";
+import { summarize } from "./report";
+
+const path = process.argv[2];
+if (!path) {
+  console.error("usage: bun src/cli.ts <file.csv>");
+  process.exit(2);
+}
+
+let text: string;
+try {
+  text = await Bun.file(path).text();
+} catch {
+  console.error(`error: cannot read ${path}`);
+  process.exit(1);
+}
+
+const { totals, skipped } = summarize(text);
+const sorted = [...totals].sort(([nameA, a], [nameB, b]) => b - a || (nameA < nameB ? -1 : nameA > nameB ? 1 : 0));
+let grandTotal = 0;
+const lines: string[] = [];
+for (const [category, cents] of sorted) {
+  lines.push(`${category}\t${formatCents(cents)}`);
+  grandTotal += cents;
+}
+lines.push(`TOTAL\t${formatCents(grandTotal)}`);
+console.log(lines.join("\n"));
+if (skipped > 0) console.error(`skipped: ${skipped}`);
