+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+
+// node-semver bounds quantifiers to avoid ReDoS; same bounds here so edge cases match.
+function safe(source: string): string {
+  const bounds: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_SAFE_BUILD_LENGTH],
+  ];
+  for (const [token, max] of bounds) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return source;
+}
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const X_ID = `${NUMERIC}|x|X|\\*`;
+const X_PLAIN = `[v=\\s]*(${X_ID})(?:\\.(${X_ID})(?:\\.(${X_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const re = (source: string, flags?: string) => new RegExp(safe(source), flags);
+const FULL_RE = re(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = re(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const BUILD_RE = re(BUILD);
+const HYPHEN_RE = re(`^\\s*(${X_PLAIN})\\s+-\\s+(${X_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = re(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${X_PLAIN})`, "g");
+const TILDE_TRIM_RE = re("(\\s*)(?:~>?)\\s+", "g");
+const CARET_TRIM_RE = re("(\\s*)(?:\\^)\\s+", "g");
+const TILDE_RE = re(`^(?:~>?)${X_PLAIN}$`);
+const CARET_RE = re(`^(?:\\^)${X_PLAIN}$`);
+const X_RANGE_RE = re(`^${GTLT}\\s*${X_PLAIN}$`);
+const STAR_RE = re("(<|>)?=?\\s*\\*");
+const GTE0_RE = re("^\\s*>=\\s*0\\.0\\.0\\s*$");
+
+type Version = { major: number; minor: number; patch: number; prerelease: string[]; text: string };
+type Comparator = { operator: string; semver: Version | null; value: string };
+
+function parseVersion(input: string): Version {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Version is longer than ${MAX_LENGTH}`);
+  const m = input.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map((n) => {
+    const value = Number(n);
+    if (value > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid version number: ${n}`);
+    return value;
+  });
+  const prerelease = m[4] ? m[4].split(".") : [];
+  const text = `${major}.${minor}.${patch}${prerelease.length ? `-${prerelease.join(".")}` : ""}`;
+  return { major, minor, patch, prerelease, text };
+}
+
+const isNumeric = (id: string) => /^[0-9]+$/.test(id);
+
+function compareIdentifiers(a: string, b: string): number {
+  const aNum = isNumeric(a);
+  const bNum = isNumeric(b);
+  if (aNum && bNum) return Math.sign(Number(a) - Number(b));
+  if (a === b) return 0;
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  const main =
+    Math.sign(a.major - b.major) || Math.sign(a.minor - b.minor) || Math.sign(a.patch - b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = m[1] === "=" || m[1] === undefined ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + semver.text };
+}
+
+function testComparator(c: Comparator, version: Version): boolean {
+  if (!c.semver) return true;
+  const order = compare(version, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${c.operator}`);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p! + 1}-0`;
+      return `${from} <${M}.${+m! + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(X_RANGE_RE, (whole, gtlt: string, M: string, m?: string, p?: string) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major += 1;
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+const eachPart = (comp: string, replace: (part: string) => string) =>
+  comp.trim().split(/\s+/).map(replace).join(" ");
+
+function desugarComparator(comp: string): string {
+  comp = comp.replace(BUILD_RE, "");
+  comp = eachPart(comp, replaceCaret);
+  comp = eachPart(comp, replaceTilde);
+  comp = eachPart(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range.replace(HYPHEN_RE, hyphenReplace);
+  range = range.replace(COMPARATOR_TRIM_RE, "$1$2$3");
+  range = range.replace(TILDE_TRIM_RE, "$1~");
+  range = range.replace(CARET_TRIM_RE, "$1^");
+  const parts = range
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const part of parts) {
+    const comp = parseComparator(part);
+    if (comp.value === "<0.0.0-0") return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw.split("||").map((r) => parseComparatorSet(r.trim()));
+  if (sets.length > 1) {
+    const first = sets[0]!;
+    sets = sets.filter((set) => set[0]!.value !== "<0.0.0-0");
+    if (sets.length === 0) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0]!.value === "");
+    if (sets.length > 1 && any) return [any];
+  }
+  return sets;
+}
+
+function testSet(set: Comparator[], version: Version): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+const tryParse = <T>(parse: () => T): T | null => {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+};
+
+const testRange = (sets: Comparator[][], version: string): boolean => {
+  const parsed = tryParse(() => parseVersion(version));
+  return parsed !== null && sets.some((set) => testSet(set, parsed));
+};
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (sets === null) return null;
+  let max: { text: string; version: Version } | null = null;
+  for (const text of versions) {
+    if (!testRange(sets, text)) continue;
+    const version = parseVersion(text);
+    if (!max || compare(max.version, version) < 0) max = { text, version };
+  }
+  return max?.text ?? null;
 }
