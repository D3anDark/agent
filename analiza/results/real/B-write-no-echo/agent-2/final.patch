+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+
+// node-semver bounds quantifiers to avoid ReDoS; mirroring it keeps edge-case results identical.
+function bounded(source: string): string {
+  const limits: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_SAFE_BUILD_LENGTH],
+  ];
+  for (const [token, max] of limits) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return source;
+}
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const re = (source: string, flags?: string) => new RegExp(bounded(source), flags);
+const FULL_RE = re(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = re(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = re(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = re(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = re("(\\s*)(?:~>?)\\s+", "g");
+const CARET_TRIM_RE = re("(\\s*)(?:\\^)\\s+", "g");
+const TILDE_RE = re(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = re(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = re(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = re("(<|>)?=?\\s*\\*");
+const GTE0_RE = re("^\\s*>=\\s*0\\.0\\.0\\s*$");
+
+type Identifier = string | number;
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+type Operator = "" | "<" | "<=" | ">" | ">=";
+type Comparator = { operator: Operator; semver: SemVer | "any"; value: string };
+type ComparatorSet = Comparator[];
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH}`);
+  const m = input.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map(Number);
+  for (const n of [major, minor, patch]) {
+    if (n > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid Version: ${input}`);
+  }
+  const prerelease: Identifier[] = m[4]
+    ? m[4].split(".").map((id) => {
+        const n = Number(id);
+        return /^[0-9]+$/.test(id) && n < Number.MAX_SAFE_INTEGER ? n : id;
+      })
+    : [];
+  const main = `${major}.${minor}.${patch}`;
+  const version = prerelease.length ? `${main}-${prerelease.join(".")}` : main;
+  return { major, minor, patch, prerelease, version };
+}
+
+function tryParseVersion(input: string): SemVer | null {
+  try {
+    return parseVersion(input);
+  } catch {
+    return null;
+  }
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNumeric = /^[0-9]+$/.test(String(a));
+  const bNumeric = /^[0-9]+$/.test(String(b));
+  if (aNumeric && bNumeric) {
+    a = Number(a);
+    b = Number(b);
+  }
+  if (a === b) return 0;
+  if (aNumeric && !bNumeric) return -1;
+  if (bNumeric && !aNumeric) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = (m[1] === "=" ? "" : (m[1] ?? "")) as Operator;
+  if (!m[2]) return { operator, semver: "any", value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function testComparator(c: Comparator, v: SemVer): boolean {
+  if (c.semver === "any") return true;
+  const order = compare(v, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p + 1}-0`;
+      return `${from} <${M}.${+m + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE_RE, (whole: string, gtlt: string, M: string, m: string, p: string) => {
+      // node-semver 7.8 leaves `x.1.2` and `1.x.2` unexpanded, so the comparator parse rejects them.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const xp = xm || isX(p);
+      if (gtlt === "=" && xp) gtlt = "";
+      let pr = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && xp) {
+        let major = +M;
+        let minor = xm ? 0 : +m;
+        let patch = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            major += 1;
+            minor = 0;
+            patch = 0;
+          } else {
+            minor += 1;
+            patch = 0;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major += 1;
+          else minor += 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt}${major}.${minor}.${patch}${pr}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return whole;
+    });
+}
+
+function desugar(comp: string): string {
+  const eachWord = (s: string, fn: (w: string) => string) =>
+    s.trim().split(/\s+/).map(fn).join(" ");
+  comp = eachWord(comp, replaceCaret);
+  comp = eachWord(comp, replaceTilde);
+  comp = eachWord(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function parseComparatorSet(range: string): ComparatorSet {
+  range = range
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const words = range
+    .split(" ")
+    .map(desugar)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of words.map(parseComparator)) {
+    if (isNullSet(comp)) return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): ComparatorSet[] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((part) => parseComparatorSet(part.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => !isNullSet(set[0]));
+    if (!sets.length) return [first];
+    const anySet = sets.find((set) => set.length === 1 && isAny(set[0]));
+    if (anySet) return [anySet];
+  }
+  return sets;
+}
+
+function tryParseRange(range: string): ComparatorSet[] | null {
+  try {
+    return parseRange(range);
+  } catch {
+    return null;
+  }
+}
+
+function testSet(set: ComparatorSet, v: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== "any" &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === v.major &&
+      c.semver.minor === v.minor &&
+      c.semver.patch === v.patch,
+  );
+}
+
+function testRange(sets: ComparatorSet[], version: string): boolean {
+  const v = tryParseVersion(version);
+  return v !== null && sets.some((set) => testSet(set, v));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParseRange(range);
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParseRange(range);
+  if (!sets) return null;
+  let max: { raw: string; semver: SemVer } | null = null;
+  for (const raw of versions) {
+    if (!testRange(sets, raw)) continue;
+    const semver = parseVersion(raw);
+    if (!max || compare(max.semver, semver) === -1) max = { raw, semver };
+  }
+  return max ? max.raw : null;
 }
