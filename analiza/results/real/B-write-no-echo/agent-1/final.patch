+// Port of node-semver v7 range semantics with default options (strict, no includePrerelease).
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+const MAX_LENGTH = 256;
+
+const NUM = "0|[1-9]\\d*";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const PRERELEASE_ID = `(?:${NUM}|${NONNUM})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULLPLAIN = `v?(${NUM})\\.(${NUM})\\.(${NUM})${PRERELEASE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULLPLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const TILDETRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const CARETTRIM_RE = /(\s*)(?:\^)\s+/g;
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const COMPARATORTRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${XRANGEPLAIN})`, "g");
+const HYPHENRANGE_RE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+function parseNumber(text: string): number {
+  const n = Number(text);
+  if (n > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid number: ${text}`);
+  return n;
+}
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Version too long: ${input}`);
+  const m = input.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid version: ${input}`);
+  const major = parseNumber(m[1]);
+  const minor = parseNumber(m[2]);
+  const patch = parseNumber(m[3]);
+  const prerelease: Identifier[] = m[4]
+    ? m[4].split(".").map((id) => {
+        if (!/^[0-9]+$/.test(id)) return id;
+        const n = Number(id);
+        return n < Number.MAX_SAFE_INTEGER ? n : id;
+      })
+    : [];
+  const main = `${major}.${minor}.${patch}`;
+  const version = prerelease.length ? `${main}-${prerelease.join(".")}` : main;
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = typeof a === "number";
+  const bNum = typeof b === "number";
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    const c = compareIdentifiers(x, y);
+    if (c) return c;
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p + 1}-0`;
+      return `${from} <${M}.${+m + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE_RE, (ret: string, gtlt: string, M: string, m: string, p: string) => {
+      // semver 7.7+: an X before a number ("x.1.2", "1.x.3") stays unreplaced and fails to parse.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return ret;
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const anyX = xm || isX(p);
+      if (gtlt === "=" && anyX) gtlt = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && anyX) {
+        let major = +M;
+        let minor = xm ? 0 : +m;
+        let patch = 0;
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            major += 1;
+            minor = 0;
+          } else {
+            minor += 1;
+          }
+          patch = 0;
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major += 1;
+          else minor += 1;
+        }
+        return `${gtlt}${major}.${minor}.${patch}${gtlt === "<" ? "-0" : ""}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return ret;
+    });
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  _fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+
+  return `${from} ${to}`.trim();
+}
+
+function eachWord(comp: string, replace: (word: string) => string): string {
+  return comp.trim().split(/\s+/).map(replace).join(" ");
+}
+
+function parseComparatorString(comp: string): string {
+  comp = eachWord(comp, replaceCaret);
+  comp = eachWord(comp, replaceTilde);
+  comp = eachWord(comp, replaceXRange);
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function parseComparator(comp: string): Comparator {
+  comp = comp.trim().split(/\s+/).join(" ");
+  const m = comp.match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range.replace(HYPHENRANGE_RE, hyphenReplace);
+  range = range.replace(COMPARATORTRIM_RE, "$1$2$3");
+  range = range.replace(TILDETRIM_RE, "$1~");
+  range = range.replace(CARETTRIM_RE, "$1^");
+  const comparators = range
+    .split(" ")
+    .map(parseComparatorString)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => parseComparator(comp.trim().replace(GTE0_RE, "")));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (isNullSet(comparator)) return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid range: ${range}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => !isNullSet(set[0]));
+    if (!sets.length) return [first];
+    const anySet = sets.find((set) => set.length === 1 && isAny(set[0]));
+    if (anySet) return [anySet];
+  }
+  return sets;
+}
+
+function testComparator(comparator: Comparator, version: SemVer): boolean {
+  if (!comparator.semver) return true;
+  const c = compare(version, comparator.semver);
+  switch (comparator.operator) {
+    case "":
+      return c === 0;
+    case ">":
+      return c > 0;
+    case ">=":
+      return c >= 0;
+    case "<":
+      return c < 0;
+    case "<=":
+      return c <= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${comparator.operator}`);
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function tryParseVersion(version: string): SemVer | null {
+  try {
+    return parseVersion(version);
+  } catch {
+    return null;
+  }
+}
+
+function tryParseRange(range: string): Comparator[][] | null {
+  try {
+    return parseRange(range);
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): SemVer | null {
+  if (!version) return null;
+  const parsed = tryParseVersion(version);
+  if (!parsed) return null;
+  return sets.some((set) => testSet(set, parsed)) ? parsed : null;
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParseRange(range);
+  return sets !== null && testRange(sets, version) !== null;
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParseRange(range);
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxParsed: SemVer | null = null;
+  for (const version of versions) {
+    const parsed = testRange(sets, version);
+    if (parsed && (!maxParsed || compare(maxParsed, parsed) === -1)) {
+      max = version;
+      maxParsed = parsed;
+    }
+  }
+  return max;
 }
