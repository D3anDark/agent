+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NONNUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAIN_LOOSE = `(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})`;
+const PRID = `(?:${NONNUM}|${NUM})`;
+const PRID_LOOSE = `(?:${NONNUM}|${NUM_LOOSE})`;
+const PRERELEASE = `(?:-(${PRID}(?:\\.${PRID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRID_LOOSE}(?:\\.${PRID_LOOSE})*))`;
+const BUILD = "(?:\\+([a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*))";
+const FULLPLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULLPLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const BUILD_RE = new RegExp(BUILD);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+const MAX_LENGTH = 256;
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH} characters`);
+  const match = input.trim().match(FULL_RE);
+  if (!match) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  for (const part of [major, minor, patch]) {
+    if (part > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid Version: ${input}`);
+  }
+  const prerelease: Identifier[] = match[4]
+    ? match[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const num = Number(id);
+          if (num < Number.MAX_SAFE_INTEGER) return num;
+        }
+        return id;
+      })
+    : [];
+  const version = `${major}.${minor}.${patch}${prerelease.length ? `-${prerelease.join(".")}` : ""}`;
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNumeric = /^[0-9]+$/.test(String(a));
+  const bNumeric = /^[0-9]+$/.test(String(b));
+  if (aNumeric && bNumeric) {
+    const an = Number(a);
+    const bn = Number(b);
+    return an === bn ? 0 : an < bn ? -1 : 1;
+  }
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function compareVersions(a: SemVer, b: SemVer): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    if (a[i] === b[i]) continue;
+    return compareIdentifiers(a[i], b[i]);
+  }
+}
+
+function parseComparatorObject(comp: string): Comparator {
+  const normalized = comp.trim().split(/\s+/).join(" ");
+  const match = normalized.match(COMPARATOR_RE);
+  if (!match) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = match[1] === undefined || match[1] === "=" ? "" : match[1];
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(match[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function testComparator(comparator: Comparator, version: SemVer): boolean {
+  if (!comparator.semver) return true;
+  const order = compareVersions(version, comparator.semver);
+  switch (comparator.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${comparator.operator}`);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = `>=${M}.${m}.${p}${pr ? `-${pr}` : ""}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p + 1}-0`;
+      return `${from} <${M}.${+m + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, gtlt: string, M: string, m: string, p: string) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (gtlt === "=" && anyX) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xm ? 0 : +m;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _whole: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function expandComparator(comp: string): string {
+  let result = comp.replace(BUILD_RE, "");
+  result = result.trim().split(/\s+/).map(replaceCaret).join(" ");
+  result = result.trim().split(/\s+/).map(replaceTilde).join(" ");
+  result = result.split(/\s+/).map(replaceXRange).join(" ");
+  return result.trim().replace(STAR_RE, "");
+}
+
+function parseComparatorSet(input: string): Comparator[] {
+  const range = input
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comps = range
+    .split(" ")
+    .map(expandComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of comps) {
+    const comparator = parseComparatorObject(comp);
+    if (comparator.value === "<0.0.0-0") return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(input: string): Comparator[][] {
+  const raw = input.trim().split(/\s+/).join(" ");
+  const sets = raw
+    .split("||")
+    .map((part) => parseComparatorSet(part.trim()))
+    .filter((set) => set.length > 0);
+  if (sets.length === 0) throw new TypeError(`Invalid SemVer Range: ${input}`);
+  if (sets.length === 1) return sets;
+  const nonNull = sets.filter((set) => set[0].value !== "<0.0.0-0");
+  if (nonNull.length === 0) return [sets[0]];
+  const anySet = nonNull.find((set) => set.length === 1 && set[0].value === "");
+  return anySet ? [anySet] : nonNull;
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (version.prerelease.length === 0) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function rangeTest(range: Comparator[][], version: string): boolean {
+  const parsed = tryParse(() => parseVersion(version));
+  if (!parsed) return false;
+  return range.some((set) => testSet(set, parsed));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const parsedRange = tryParse(() => parseRange(range));
+  if (!parsedRange) return false;
+  return rangeTest(parsedRange, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const parsedRange = tryParse(() => parseRange(range));
+  if (!parsedRange) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const version of versions) {
+    if (!rangeTest(parsedRange, version)) continue;
+    const parsed = parseVersion(version);
+    if (!maxVersion || compareVersions(maxVersion, parsed) === -1) {
+      max = version;
+      maxVersion = parsed;
+    }
+  }
+  return max;
 }
