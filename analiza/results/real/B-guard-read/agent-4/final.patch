--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,335 @@
+// Port of node-semver v7 range logic with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+const MAX_SAFE_BUILD_LENGTH = MAX_LENGTH - 6;
+
+// node-semver bounds quantifiers (ReDoS guard); this changes what matches, so mirror it.
+function safe(source: string): string {
+  const limits: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_SAFE_BUILD_LENGTH],
+  ];
+  for (const [token, max] of limits) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return source;
+}
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[0-9A-Za-z-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRE})?${BUILD}?)?)?`;
+
+const re = (source: string, flags?: string) => new RegExp(safe(source), flags);
+const FULL = re(`^${FULL_PLAIN}$`);
+const COMPARATOR = re(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RANGE = re(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM = re(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM = re("(\\s*)(?:~>?)\\s+", "g");
+const CARET_TRIM = re("(\\s*)(?:\\^)\\s+", "g");
+const TILDE = re(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET = re(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE = re(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR = re("(<|>)?=?\\s*\\*");
+const GTE0 = re("^\\s*>=\\s*0\\.0\\.0\\s*$");
+const BUILD_FIRST = re(BUILD);
+const BUILD_ALL = new RegExp(BUILD, "g");
+
+type Identifier = number | string;
+type Version = { major: number; minor: number; patch: number; prerelease: Identifier[] };
+type Comparator = { operator: string; version: Version | null; value: string };
+
+function parseVersion(text: string): Version {
+  if (text.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH}`);
+  const m = text.trim().match(FULL);
+  if (!m) throw new TypeError(`Invalid Version: ${text}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map(Number);
+  for (const n of [major, minor, patch]) {
+    if (n > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid Version: ${text}`);
+  }
+  const prerelease = m[4]
+    ? m[4].split(".").map((id): Identifier => {
+        if (!/^[0-9]+$/.test(id)) return id;
+        const num = Number(id);
+        return num < Number.MAX_SAFE_INTEGER ? num : id;
+      })
+    : [];
+  return { major, minor, patch, prerelease };
+}
+
+function format(v: Version): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) {
+    a = Number(a);
+    b = Number(b);
+  }
+  if (a === b) return 0;
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a[i];
+    const y = b[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function parseComparator(text: string): Comparator {
+  const comp = text.trim().split(/\s+/).join(" ");
+  const m = comp.match(COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator: ${text}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, version: null, value: "" };
+  const version = parseVersion(m[2]);
+  return { operator, version, value: operator + format(version) };
+}
+
+function testComparator(c: Comparator, v: Version): boolean {
+  if (!c.version) return true;
+  const order = compare(v, c.version);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${c.operator}`);
+  }
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lower} <${M}.${m}.${+p + 1}-0`;
+      return `${lower} <${M}.${Number(m) + 1}.0-0`;
+    }
+    return `${lower} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${Number(m) + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${Number(m) + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE, (ret, gtlt: string, M: string, m?: string, p?: string) => {
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const xp = xm || isX(p);
+      if (gtlt === "=" && xp) gtlt = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && xp) {
+        let major = +M;
+        let minor = xm ? 0 : Number(m);
+        let pr = "";
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) {
+            major += 1;
+            minor = 0;
+          } else {
+            minor += 1;
+          }
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major += 1;
+          else minor += 1;
+        }
+        if (gtlt === "<") pr = "-0";
+        return `${gtlt}${major}.${minor}.0${pr}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return ret;
+    });
+}
+
+function expandComparator(comp: string): string {
+  const eachPart = (s: string, fn: (part: string) => string) =>
+    s.trim().split(/\s+/).map(fn).join(" ");
+  comp = eachPart(comp.replace(BUILD_FIRST, ""), replaceCaret);
+  comp = eachPart(comp, replaceTilde);
+  comp = eachPart(comp, replaceXRange);
+  return comp.trim().replace(STAR, "");
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range
+    .replace(BUILD_ALL, "")
+    .replace(HYPHEN_RANGE, hyphenReplace)
+    .replace(COMPARATOR_TRIM, "$1$2$3")
+    .replace(TILDE_TRIM, "$1~")
+    .replace(CARET_TRIM, "$1^");
+  const parts = range
+    .split(" ")
+    .map(expandComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0, ""));
+
+  const byValue = new Map<string, Comparator>();
+  const comparators = parts.map(parseComparator);
+  for (const comp of comparators) {
+    if (comp.value === "<0.0.0-0") return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().replace(/\s+/g, " ");
+  let sets = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => set[0].value !== "<0.0.0-0");
+    if (!sets.length) return [first];
+    const anySet = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (sets.length > 1 && anySet) return [anySet];
+  }
+  return sets;
+}
+
+function testSet(set: Comparator[], v: Version): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.version !== null &&
+      c.version.prerelease.length > 0 &&
+      c.version.major === v.major &&
+      c.version.minor === v.minor &&
+      c.version.patch === v.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): boolean {
+  if (!version) return false;
+  const v = tryParse(() => parseVersion(version));
+  return v !== null && sets.some((set) => testSet(set, v));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxVersion: Version | null = null;
+  for (const candidate of versions) {
+    if (!testRange(sets, candidate)) continue;
+    const v = parseVersion(candidate);
+    if (!maxVersion || compare(maxVersion, v) < 0) {
+      max = candidate;
+      maxVersion = v;
+    }
+  }
+  return max;
 }
