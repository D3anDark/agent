+// Port of node-semver v7.8 range semantics with default options (not loose, no includePrerelease).
+
+const LETTERDASHNUMBER = "[a-zA-Z0-9-]";
+const NUM = "0|[1-9]\\d*";
+const NONNUM = `\\d*[a-zA-Z-]${LETTERDASHNUMBER}*`;
+const PRE_ID = `(?:${NUM}|${NONNUM})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const BUILD = `(?:\\+(${LETTERDASHNUMBER}+(?:\\.${LETTERDASHNUMBER}+)*))`;
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const FULLPLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const PRE_ID_LOOSE = `(?:\\d+|${NONNUM})`;
+const LOOSEPLAIN = `[v=\\s]*(\\d+)\\.(\\d+)\\.(\\d+)(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+// node-semver bounds greedy quantifiers against ReDoS; the bounds change results on long or double-spaced input.
+function safeRegExp(source: string, flags?: string): RegExp {
+  const bounds: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", 256],
+    [LETTERDASHNUMBER, 250],
+  ];
+  for (const [token, max] of bounds) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return new RegExp(source, flags);
+}
+
+const BUILDSTRIP = new RegExp(BUILD, "g");
+const FULL = safeRegExp(`^${FULLPLAIN}$`);
+const COMPARATOR = safeRegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const HYPHENRANGE = safeRegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const COMPARATORTRIM = safeRegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const TILDETRIM = safeRegExp("(\\s*)(?:~>?)\\s+", "g");
+const CARETTRIM = safeRegExp("(\\s*)(?:\\^)\\s+", "g");
+const TILDE = safeRegExp(`^(?:~>?)${XRANGEPLAIN}$`);
+const CARET = safeRegExp(`^(?:\\^)${XRANGEPLAIN}$`);
+const XRANGE = safeRegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const STAR = safeRegExp("(<|>)?=?\\s*\\*");
+const GTE0 = safeRegExp("^\\s*>=\\s*0\\.0\\.0\\s*$");
+
+type Identifier = string | number;
+type SemVer = { major: number; minor: number; patch: number; prerelease: Identifier[]; version: string };
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+function parseNumber(text: string): number {
+  const n = Number(text);
+  if (n > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid number ${text}`);
+  return n;
+}
+
+function parseSemVer(input: string): SemVer {
+  if (input.length > 256) throw new TypeError("Version too long");
+  const m = input.trim().match(FULL);
+  if (!m) throw new TypeError(`Invalid version ${input}`);
+  const major = parseNumber(m[1]);
+  const minor = parseNumber(m[2]);
+  const patch = parseNumber(m[3]);
+  const prerelease: Identifier[] = m[4]
+    ? m[4].split(".").map((id) => {
+        const n = Number(id);
+        return /^[0-9]+$/.test(id) && n < Number.MAX_SAFE_INTEGER ? n : id;
+      })
+    : [];
+  const pre = prerelease.length ? `-${prerelease.join(".")}` : "";
+  return { major, minor, patch, prerelease, version: `${major}.${minor}.${patch}${pre}` };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) return Math.sign(Number(a) - Number(b));
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+function parseComparatorString(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator ${comp}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseSemVer(m[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function testComparator(c: Comparator, v: SemVer): boolean {
+  if (!c.semver) return true;
+  const order = compare(v, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new TypeError(`Invalid operator ${c.operator}`);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function hyphenReplace(_: string, ...groups: string[]): string {
+  let [from, fM, fm, fp, , , to, tM, tm, tp, tpr] = groups;
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const low = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${low} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${low} <${M}.${+m + 1}.0-0`;
+    return `${low} <${M}.${m}.${+p + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    const low = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${low} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE, (ret, gtlt: string, M: string, m: string, p: string) => {
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return ret;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let major = +M;
+      let minor = xm ? 0 : +m;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major++;
+        else minor++;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major++;
+        else minor++;
+      }
+      const pre = gtlt === "<" ? "-0" : "";
+      return `${gtlt}${major}.${minor}.0${pre}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+function eachToken(comp: string, replace: (token: string) => string): string {
+  return comp.trim().split(/\s+/).map(replace).join(" ");
+}
+
+function parseComparator(comp: string): string {
+  comp = eachToken(comp, replaceCaret);
+  comp = eachToken(comp, replaceTilde);
+  comp = eachToken(comp, replaceXRange);
+  return comp.trim().replace(STAR, "");
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range.replace(BUILDSTRIP, "");
+  range = range.replace(HYPHENRANGE, hyphenReplace);
+  range = range.replace(COMPARATORTRIM, "$1$2$3");
+  range = range.replace(TILDETRIM, "$1~");
+  range = range.replace(CARETTRIM, "$1^");
+  const tokens = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0, ""));
+
+  const comparators = tokens.map(parseComparatorString);
+  const byValue = new Map<string, Comparator>();
+  for (const comp of comparators) {
+    if (comp.value === "<0.0.0-0") return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw.split("||").map((part) => parseComparatorSet(part.trim()));
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => set[0].value !== "<0.0.0-0");
+    if (sets.length === 0) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (any) return [any];
+  }
+  return sets;
+}
+
+function testSet(set: Comparator[], v: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === v.major &&
+      c.semver.minor === v.minor &&
+      c.semver.patch === v.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch (error) {
+    if (error instanceof TypeError) return null;
+    throw error;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): boolean {
+  const v = tryParse(() => parseSemVer(version));
+  return v !== null && sets.some((set) => testSet(set, v));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: SemVer | null = null;
+  let maxRaw: string | null = null;
+  for (const raw of versions) {
+    if (!testRange(sets, raw)) continue;
+    const v = parseSemVer(raw);
+    if (!max || compare(max, v) < 0) {
+      max = v;
+      maxRaw = raw;
+    }
+  }
+  return maxRaw;
 }
