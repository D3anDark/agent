--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,332 @@
+// Port of node-semver 7.8 range matching with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+
+const NUM = "0|[1-9]\\d*";
+const PRERELEASE_ID = `(?:${NUM}|\\d*[a-zA-Z-][a-zA-Z0-9-]*)`;
+const PRERELEASE_LOOSE_ID = "(?:\\d+|\\d*[a-zA-Z-][a-zA-Z0-9-]*)";
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const BUILD = "(?:\\+([a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*))";
+const FULLPLAIN = `v?(${NUM})\\.(${NUM})\\.(${NUM})${PRERELEASE}?${BUILD}?`;
+const LOOSEPLAIN = `[v=\\s]*(\\d+)\\.(\\d+)\\.(\\d+)(?:-?(${PRERELEASE_LOOSE_ID}(?:\\.${PRERELEASE_LOOSE_ID})*))?${BUILD}?`;
+const XID = `${NUM}|x|X|\\*`;
+const XRANGEPLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+const GTLT = "((?:<|>)?=?)";
+const LONETILDE = "(?:~>?)";
+
+const FULL = safeRegExp(`^${FULLPLAIN}$`);
+const COMPARATOR = safeRegExp(`^${GTLT}\\s*(${FULLPLAIN})$|^$`);
+const HYPHENRANGE = safeRegExp(`^\\s*(${XRANGEPLAIN})\\s+-\\s+(${XRANGEPLAIN})\\s*$`);
+const COMPARATORTRIM = safeRegExp(`(\\s*)${GTLT}\\s*(${LOOSEPLAIN}|${XRANGEPLAIN})`, "g");
+const TILDETRIM = safeRegExp(`(\\s*)${LONETILDE}\\s+`, "g");
+const CARETTRIM = safeRegExp("(\\s*)\\^\\s+", "g");
+const TILDE = safeRegExp(`^${LONETILDE}${XRANGEPLAIN}$`);
+const CARET = safeRegExp(`^\\^${XRANGEPLAIN}$`);
+const XRANGE = safeRegExp(`^${GTLT}\\s*${XRANGEPLAIN}$`);
+const STAR = safeRegExp("(<|>)?=?\\s*\\*");
+const GTE0 = safeRegExp("^\\s*>=\\s*0\\.0\\.0\\s*$");
+// node-semver strips build metadata with the unbounded pattern, the rest use bounded ones.
+const BUILD_GLOBAL = new RegExp(BUILD, "g");
+
+// Mirrors node-semver's makeSafeRegex: `\s*` matches at most one space, which changes
+// results for ranges like `> +b.1 1.0` where stripping the build leaves two spaces.
+function safeRegExp(source: string, flags?: string): RegExp {
+  const limits: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_LENGTH - 6],
+  ];
+  for (const [token, max] of limits) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return new RegExp(source, flags);
+}
+
+type SemVer = { major: number; minor: number; patch: number; prerelease: (string | number)[] };
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+type ComparatorSet = Comparator[];
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = parseRangeOrNull(range);
+  const parsed = parseVersionOrNull(version);
+  if (!set || !parsed) return false;
+  return set.some((comparators) => testSet(comparators, parsed));
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = parseRangeOrNull(range);
+  if (!set) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const v of versions) {
+    const parsed = parseVersionOrNull(v);
+    if (!parsed || !set.some((comparators) => testSet(comparators, parsed))) continue;
+    if (!maxVersion || compare(maxVersion, parsed) === -1) {
+      max = v;
+      maxVersion = parsed;
+    }
+  }
+  return max;
+}
+
+function parseVersionOrNull(version: string): SemVer | null {
+  try {
+    return parseVersion(version);
+  } catch {
+    return null;
+  }
+}
+
+function parseRangeOrNull(range: string): ComparatorSet[] | null {
+  try {
+    return parseRange(range);
+  } catch {
+    return null;
+  }
+}
+
+function parseVersion(version: string): SemVer {
+  if (version.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH}`);
+  const m = version.trim().match(FULL);
+  if (!m) throw new TypeError(`Invalid Version: ${version}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  for (const n of [major, minor, patch]) {
+    if (n > Number.MAX_SAFE_INTEGER) throw new TypeError("Invalid version number");
+  }
+  const prerelease = m[4]
+    ? m[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const num = +id;
+          if (num < Number.MAX_SAFE_INTEGER) return num;
+        }
+        return id;
+      })
+    : [];
+  return { major, minor, patch, prerelease };
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePre(a, b)
+  );
+}
+
+function compareNumbers(a: number, b: number): number {
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function comparePre(a: SemVer, b: SemVer): number {
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const aNumeric = /^[0-9]+$/.test(String(a));
+  const bNumeric = /^[0-9]+$/.test(String(b));
+  if (aNumeric && bNumeric) return compareNumbers(+a, +b);
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function parseRange(range: string): ComparatorSet[] {
+  const raw = range.trim().replace(/\s+/g, " ");
+  let set = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r.trim()))
+    .filter((c) => c.length);
+  if (!set.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (set.length > 1) {
+    const first = set[0];
+    set = set.filter((c) => c[0].value !== "<0.0.0-0");
+    if (!set.length) return [first];
+    // A lone `*` set swallows the others, which also drops their prerelease opt-ins.
+    const any = set.find((c) => c.length === 1 && c[0].value === "");
+    if (any) return [any];
+  }
+  return set;
+}
+
+function parseComparatorSet(range: string): ComparatorSet {
+  const trimmed = range
+    .replace(BUILD_GLOBAL, "")
+    .replace(HYPHENRANGE, hyphenReplace)
+    .replace(COMPARATORTRIM, "$1$2$3")
+    .replace(TILDETRIM, "$1~")
+    .replace(CARETTRIM, "$1^");
+  const comparators = trimmed
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0, ""))
+    .map(parseComparator);
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of comparators) {
+    if (comp.value === "<0.0.0-0") return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR, "");
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + formatVersion(semver) };
+}
+
+function formatVersion(v: SemVer): string {
+  const pre = v.prerelease.length ? `-${v.prerelease.join(".")}` : "";
+  return `${v.major}.${v.minor}.${v.patch}${pre}`;
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function hyphenReplace(
+  _match: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_match, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lower} <${M}.${m}.${+p + 1}-0`;
+      return `${lower} <${M}.${+m + 1}.0-0`;
+    }
+    return `${lower} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_match, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE, (match, gtlt: string, M: string, m: string, p: string) => {
+    // node-semver leaves `x.1` and `1.x.2` unchanged, so they fail as comparators.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp.trim();
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (gtlt === "=" && anyX) gtlt = "";
+
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xm ? 0 : +m;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major += 1;
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return match;
+  });
+}
+
+function testSet(set: ComparatorSet, version: SemVer): boolean {
+  for (const c of set) {
+    if (!testComparator(c, version)) return false;
+  }
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function testComparator(c: Comparator, version: SemVer): boolean {
+  if (!c.semver) return true;
+  const order = compare(version, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${c.operator}`);
+  }
 }
