+++ b/src/semver.ts
@@ -1,8 +1,319 @@
+// Port of node-semver v7 range semantics with default options (not loose, no includePrerelease).
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+const NUMERIC_ID = String.raw`0|[1-9]\d*`;
+const NON_NUMERIC_ID = String.raw`\d*[a-zA-Z-][a-zA-Z0-9-]*`;
+const PRERELEASE_ID = `(?:${NON_NUMERIC_ID}|${NUMERIC_ID})`;
+const PRERELEASE = String.raw`(?:-(${PRERELEASE_ID}(?:\.${PRERELEASE_ID})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = String.raw`(?:\+(${BUILD_ID}(?:\.${BUILD_ID})*))`;
+const MAIN_VERSION = String.raw`(${NUMERIC_ID})\.(${NUMERIC_ID})\.(${NUMERIC_ID})`;
+const FULL_PLAIN = `v?${MAIN_VERSION}${PRERELEASE}?${BUILD}?`;
+const LOOSE_ID = String.raw`\d+`;
+const PRERELEASE_LOOSE_ID = `(?:${LOOSE_ID}|${NON_NUMERIC_ID})`;
+const LOOSE_PLAIN = String.raw`[v=\s]*(${LOOSE_ID})\.(${LOOSE_ID})\.(${LOOSE_ID})(?:-?(${PRERELEASE_LOOSE_ID}(?:\.${PRERELEASE_LOOSE_ID})*))?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGE_ID = String.raw`${NUMERIC_ID}|x|X|\*`;
+const XRANGE_PLAIN = String.raw`[v=\s]*(${XRANGE_ID})(?:\.(${XRANGE_ID})(?:\.(${XRANGE_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(String.raw`^${GTLT}\s*(${FULL_PLAIN})$|^$`);
+const COMPARATOR_TRIM_RE = new RegExp(String.raw`(\s*)${GTLT}\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = new RegExp(String.raw`(\s*)(?:~>?)\s+`, "g");
+const CARET_TRIM_RE = new RegExp(String.raw`(\s*)\^\s+`, "g");
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(String.raw`^\^${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(String.raw`^${GTLT}\s*${XRANGE_PLAIN}$`);
+const HYPHEN_RE = new RegExp(String.raw`^\s*(${XRANGE_PLAIN})\s+-\s+(${XRANGE_PLAIN})\s*$`);
+const BUILD_RE = new RegExp(BUILD);
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+const NUMERIC_RE = /^[0-9]+$/;
+const MAX_LENGTH = 256;
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const parsedRange = tryParse(() => parseRange(range));
+  return parsedRange !== null && testRange(parsedRange, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const parsedRange = tryParse(() => parseRange(range));
+  if (parsedRange === null) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const version of versions) {
+    if (!testRange(parsedRange, version)) continue;
+    const parsed = parseVersion(version);
+    if (maxVersion === null || compare(maxVersion, parsed) === -1) {
+      max = version;
+      maxVersion = parsed;
+    }
+  }
+  return max;
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH} characters`);
+  const match = input.trim().match(FULL_RE);
+  if (!match) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [match[1], match[2], match[3]].map((part) => {
+    const value = Number(part);
+    if (value > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid version component: ${part}`);
+    return value;
+  });
+  const prerelease: Identifier[] = match[4]
+    ? match[4].split(".").map((id) => {
+        if (!NUMERIC_RE.test(id)) return id;
+        const num = Number(id);
+        return num < Number.MAX_SAFE_INTEGER ? num : id;
+      })
+    : [];
+  const pre = prerelease.length ? `-${prerelease.join(".")}` : "";
+  return { major, minor, patch, prerelease, version: `${major}.${minor}.${patch}${pre}` };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = NUMERIC_RE.test(String(a));
+  const bNum = NUMERIC_RE.test(String(b));
+  if (aNum && bNum) {
+    const diff = Number(a) - Number(b);
+    return diff === 0 ? 0 : diff < 0 ? -1 : 1;
+  }
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a === b ? 0 : String(a) < String(b) ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (i >= a.length && i >= b.length) return 0;
+    if (i >= b.length) return 1;
+    if (i >= a.length) return -1;
+    if (a[i] === b[i]) continue;
+    return compareIdentifiers(a[i], b[i]);
+  }
+}
+
+function parseRange(input: string): Comparator[][] {
+  const raw = input.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((part) => parseComparatorSet(part.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${input}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => !isNullSet(set[0]));
+    if (sets.length === 0) return [first];
+    const anySet = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (anySet) return [anySet];
+  }
+  return sets;
+}
+
+function isNullSet(comparator: Comparator): boolean {
+  return comparator.value === "<0.0.0-0";
+}
+
+function parseComparatorSet(input: string): Comparator[] {
+  const trimmed = input
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comparators = trimmed
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""))
+    .map(parseComparator);
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (isNullSet(comparator)) return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(input: string): Comparator {
+  const match = input.match(COMPARATOR_RE);
+  if (!match) throw new TypeError(`Invalid comparator: ${input}`);
+  const operator = match[1] === undefined || match[1] === "=" ? "" : match[1];
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(match[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.replace(BUILD_RE, "").trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${from} <${M}.${+m! + 1}.0-0`;
+    return `${from} <${M}.${m}.${+p! + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, operator: string, M: string, m?: string, p?: string) => {
+    // node-semver leaves `1.x.3` and `*.1` untouched so they fail as invalid comparators.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+    const xMajor = isX(M);
+    const xMinor = xMajor || isX(m);
+    const anyX = xMinor || isX(p);
+    let gtlt = operator === "=" && anyX ? "" : operator;
+    if (xMajor) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xMinor ? 0 : +m!;
+      let patch = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xMinor) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+        patch = 0;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xMinor) major += 1;
+        else minor += 1;
+      }
+      const pr = gtlt === "<" ? "-0" : "";
+      return `${gtlt}${major}.${minor}.${patch}${pr}`;
+    }
+    if (xMinor) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _whole: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  _fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function testRange(range: Comparator[][], input: string): boolean {
+  const version = tryParse(() => parseVersion(input));
+  if (version === null) return false;
+  return range.some((set) => testSet(set, version));
+}
+
+function testComparator(comparator: Comparator, version: SemVer): boolean {
+  if (comparator.semver === null) return true;
+  const order = compare(version, comparator.semver);
+  switch (comparator.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${comparator.operator}`);
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
 }
