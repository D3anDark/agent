+++ b/src/semver.ts
@@ -1,8 +1,284 @@
+// Port of node-semver v7 range handling with default options (strict, no includePrerelease).
+// Regex sources mirror node-semver's internal/re.js so edge cases match exactly.
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRERELEASE_ID = `(?:${NON_NUMERIC}|${NUMERIC})`;
+const PRERELEASE_ID_LOOSE = `(?:${NON_NUMERIC}|${NUMERIC_LOOSE})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRERELEASE_ID_LOOSE}(?:\\.${PRERELEASE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGE_ID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+const MAX_LENGTH = 256;
+
+type Version = { major: number; minor: number; patch: number; prerelease: string[] };
+type Operator = "" | "<" | "<=" | ">" | ">=";
+// semver null means the ANY comparator (matches everything).
+type Comparator = { operator: Operator; semver: Version | null; value: string };
+type ComparatorSet = Comparator[];
+
+function parseVersion(input: string): Version {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Version is longer than ${MAX_LENGTH}`);
+  const m = input.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [m[1], m[2], m[3]].map(Number);
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) {
+    throw new TypeError(`Invalid Version: ${input}`);
+  }
+  return { major, minor, patch, prerelease: m[4] ? m[4].split(".") : [] };
+}
+
+function formatVersion(v: Version): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+function compareIdentifiers(a: string, b: string): number {
+  const aNumeric = /^[0-9]+$/.test(a);
+  const bNumeric = /^[0-9]+$/.test(b);
+  if (aNumeric && bNumeric) return Math.sign(Number(a) - Number(b));
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  const main = Math.sign(a.major - b.major) || Math.sign(a.minor - b.minor) || Math.sign(a.patch - b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m === "0") return `${from} <${M}.${m}.${+p! + 1}-0`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, gtlt: string, M: string, m?: string, p?: string) => {
+    // node-semver 7.7+: "*.2.3" or "1.x.3" is left as-is so it fails as an invalid comparator.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      let pre = "";
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major += 1;
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      if (gtlt === "<") pre = "-0";
+      return `${gtlt}${major}.${minor}.0${pre}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _: string,
+  from: string, fM: string, fm: string | undefined, fp: string | undefined, fpr: string | undefined, _fb: string | undefined,
+  to: string, tM: string, tm: string | undefined, tp: string | undefined, tpr: string | undefined,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseComparator(comp: string): string {
+  comp = comp.replace(BUILD_RE, "");
+  comp = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function makeComparator(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = (m[1] === "=" ? "" : (m[1] ?? "")) as Operator;
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + formatVersion(semver) };
+}
+
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+const isAny = (c: Comparator) => c.value === "";
+
+function parseComparatorSet(range: string): ComparatorSet {
+  range = range.replace(HYPHEN_RE, hyphenReplace);
+  range = range.replace(COMPARATOR_TRIM_RE, "$1$2$3");
+  range = range.replace(TILDE_TRIM_RE, "$1~");
+  range = range.replace(CARET_TRIM_RE, "$1^");
+  const parts = range
+    .split(" ")
+    .map(parseComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of parts.map(makeComparator)) {
+    if (isNullSet(comp)) return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(input: string): ComparatorSet[] {
+  const raw = input.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => !isNullSet(set[0]));
+    if (!sets.length) return [first];
+    const anySet = sets.find((set) => set.length === 1 && isAny(set[0]));
+    if (anySet) return [anySet];
+  }
+  return sets;
+}
+
+function testComparator(c: Comparator, v: Version): boolean {
+  if (!c.semver) return true;
+  const order = compare(v, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+function testSet(set: ComparatorSet, v: Version): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === v.major &&
+      c.semver.minor === v.minor &&
+      c.semver.patch === v.patch,
+  );
+}
+
+function testRange(sets: ComparatorSet[], version: string): boolean {
+  let v: Version;
+  try {
+    v = parseVersion(version);
+  } catch {
+    return false;
+  }
+  return sets.some((set) => testSet(set, v));
+}
+
+function tryParseRange(range: string): ComparatorSet[] | null {
+  try {
+    return parseRange(range);
+  } catch {
+    return null;
+  }
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParseRange(range);
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParseRange(range);
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxVersion: Version | null = null;
+  for (const version of versions) {
+    if (!testRange(sets, version)) continue;
+    const parsed = parseVersion(version);
+    if (!maxVersion || compare(maxVersion, parsed) === -1) {
+      max = version;
+      maxVersion = parsed;
+    }
+  }
+  return max;
 }
