+++ b/src/semver.ts
@@ -1,8 +1,291 @@
+// Port of node-semver v7 range semantics with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NON_NUMERIC}|${NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NON_NUMERIC}|${NUMERIC_LOOSE})`;
+const PRE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const X_ID = `${NUMERIC}|x|X|\\*`;
+const X_PLAIN = `[v=\\s]*(${X_ID})(?:\\.(${X_ID})(?:\\.(${X_ID})(?:${PRE})?${BUILD}?)?)?`;
+
+const FULL = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RANGE = new RegExp(`^\\s*(${X_PLAIN})\\s+-\\s+(${X_PLAIN})\\s*$`);
+const COMPARATOR_TRIM = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${X_PLAIN})`, "g");
+const TILDE_TRIM = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM = /(\s*)(?:\^)\s+/g;
+const TILDE = new RegExp(`^(?:~>?)${X_PLAIN}$`);
+const CARET = new RegExp(`^(?:\\^)${X_PLAIN}$`);
+const X_RANGE = new RegExp(`^${GTLT}\\s*${X_PLAIN}$`);
+const STAR = /(<|>)?=?\s*\*/;
+const GTE0 = /^\s*>=\s*0\.0\.0\s*$/;
+
+type Identifier = string | number;
+type Version = { major: number; minor: number; patch: number; prerelease: Identifier[] };
+type Comparator = { operator: string; semver: Version | null; value: string };
+type ComparatorSet = Comparator[];
+
+function parseVersion(input: string): Version {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Invalid Version: ${input}`);
+  const m = input.trim().match(FULL);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) {
+    throw new TypeError(`Invalid Version: ${input}`);
+  }
+  const prerelease = m[4] ? m[4].split(".").map(toIdentifier) : [];
+  return { major, minor, patch, prerelease };
+}
+
+function toIdentifier(id: string): Identifier {
+  if (!/^[0-9]+$/.test(id)) return id;
+  const num = +id;
+  return num < Number.MAX_SAFE_INTEGER ? num : id;
+}
+
+function formatVersion(v: Version): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) {
+    a = +a;
+    b = +b;
+  }
+  if (a === b) return 0;
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    const order = compareIdentifiers(a[i], b[i]);
+    if (order !== 0) return order;
+  }
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + formatVersion(semver) };
+}
+
+function testComparator(c: Comparator, v: Version): boolean {
+  if (c.semver === null) return true;
+  const order = compare(v, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+  throw new TypeError(`Invalid operator: ${c.operator}`);
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+const isNullSet = (c: Comparator) => c.value === "<0.0.0-0";
+
+function hyphenReplace(...g: (string | undefined)[]): string {
+  const [, fromRaw, fM, fm, fp, fpr, , toRaw, tM, tm, tp, tpr] = g;
+  let from: string;
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${fromRaw}`;
+
+  let to: string;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM! + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${toRaw}`;
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${from} <${M}.${+m! + 1}.0-0`;
+    return `${from} <${M}.${m}.${+p! + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(X_RANGE, (whole, gtlt: string, M: string, m?: string, p?: string) => {
+    // node-semver keeps "x.1.2" and "1.x.3" as-is so they fail comparator parsing.
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (gtlt === "=" && anyX) gtlt = "";
+
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      const pr = gtlt === "<" ? "-0" : "";
+      return `${gtlt}${major}.${minor}.0${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function desugar(comp: string): string {
+  const mapWords = (s: string, fn: (w: string) => string) => s.trim().split(/\s+/).map(fn).join(" ");
+  comp = mapWords(comp, replaceCaret);
+  comp = mapWords(comp, replaceTilde);
+  comp = mapWords(comp, replaceXRange);
+  return comp.trim().replace(STAR, "");
+}
+
+function parseComparatorSet(range: string): ComparatorSet {
+  range = range.replace(HYPHEN_RANGE, hyphenReplace);
+  range = range.replace(COMPARATOR_TRIM, "$1$2$3");
+  range = range.replace(TILDE_TRIM, "$1~");
+  range = range.replace(CARET_TRIM, "$1^");
+
+  const words = range
+    .split(" ")
+    .map(desugar)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of words.map(parseComparator)) {
+    if (isNullSet(comp)) return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(range: string): ComparatorSet[] {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r.trim()))
+    .filter((set) => set.length);
+  if (!sets.length) throw new TypeError(`Invalid SemVer Range: ${range}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => !isNullSet(set[0]));
+    if (!sets.length) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (any) return [any];
+  }
+  return sets;
+}
+
+function testSet(set: ComparatorSet, v: Version): boolean {
+  if (!set.every((c) => testComparator(c, v))) return false;
+  if (!v.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === v.major &&
+      c.semver.minor === v.minor &&
+      c.semver.patch === v.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: ComparatorSet[], version: string): Version | null {
+  const v = tryParse(() => parseVersion(version));
+  if (!v || !sets.some((set) => testSet(set, v))) return null;
+  return v;
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version) !== null;
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: { raw: string; version: Version } | null = null;
+  for (const raw of versions) {
+    const version = testRange(sets, raw);
+    if (version && (!max || compare(max.version, version) < 0)) max = { raw, version };
+  }
+  return max?.raw ?? null;
 }
