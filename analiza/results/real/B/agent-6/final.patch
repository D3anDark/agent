--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,318 @@
+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const MAX_LENGTH = 256;
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN_VERSION = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_VERSION_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRERELEASE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRERELEASE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRERELEASE_ID_LOOSE}(?:\\.${PRERELEASE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN_VERSION}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_VERSION_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XRANGE_ID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:\\.(${XRANGE_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+const LONE_TILDE = "(?:~>?)";
+const LONE_CARET = "(?:\\^)";
+
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+const BUILD_RE = safeRegExp(BUILD);
+const FULL_RE = safeRegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = safeRegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RANGE_RE = safeRegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = safeRegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = safeRegExp(`(\\s*)${LONE_TILDE}\\s+`, "g");
+const CARET_TRIM_RE = safeRegExp(`(\\s*)${LONE_CARET}\\s+`, "g");
+const TILDE_RE = safeRegExp(`^${LONE_TILDE}${XRANGE_PLAIN}$`);
+const CARET_RE = safeRegExp(`^${LONE_CARET}${XRANGE_PLAIN}$`);
+const XRANGE_RE = safeRegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+const NUMERIC_ID_RE = /^[0-9]+$/;
+
+// node-semver bounds repeats to avoid ReDoS, which also caps identifier lengths.
+function safeRegExp(source: string, flags?: string): RegExp {
+  const bounds: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_LENGTH - 6],
+  ];
+  for (const [token, max] of bounds) {
+    source = source.split(`${token}*`).join(`${token}{0,${max}}`).split(`${token}+`).join(`${token}{1,${max}}`);
+  }
+  return new RegExp(source, flags);
+}
+
+type SemVer = { major: number; minor: number; patch: number; prerelease: string[] };
+type Operator = "" | "<" | "<=" | ">" | ">=";
+// semver null means the comparator matches any version.
+type Comparator = { operator: Operator; semver: SemVer | null; value: string };
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = parseRange(range);
+  const semver = parseSemVer(version);
+  return set !== null && semver !== null && testRange(set, semver);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = parseRange(range);
+  if (set === null) return null;
+  let max: string | null = null;
+  let maxSemVer: SemVer | null = null;
+  for (const version of versions) {
+    const semver = parseSemVer(version);
+    if (semver === null || !testRange(set, semver)) continue;
+    if (maxSemVer === null || compare(maxSemVer, semver) === -1) {
+      max = version;
+      maxSemVer = semver;
+    }
+  }
+  return max;
+}
+
+function parseSemVer(version: string): SemVer | null {
+  if (version.length > MAX_LENGTH) return null;
+  const match = version.trim().match(FULL_RE);
+  if (!match) return null;
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  if (major > Number.MAX_SAFE_INTEGER || minor > Number.MAX_SAFE_INTEGER || patch > Number.MAX_SAFE_INTEGER) {
+    return null;
+  }
+  return { major, minor, patch, prerelease: match[4] ? match[4].split(".") : [] };
+}
+
+function formatSemVer(v: SemVer): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function compareNumbers(a: number, b: number): number {
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function comparePrerelease(a: string[], b: string[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (a[i] === undefined && b[i] === undefined) return 0;
+    if (b[i] === undefined) return 1;
+    if (a[i] === undefined) return -1;
+    const result = compareIdentifiers(a[i], b[i]);
+    if (result !== 0) return result;
+  }
+}
+
+function compareIdentifiers(a: string, b: string): number {
+  const aNumeric = NUMERIC_ID_RE.test(a);
+  const bNumeric = NUMERIC_ID_RE.test(b);
+  if (aNumeric && bNumeric) return compareNumbers(Number(a), Number(b));
+  if (aNumeric) return -1;
+  if (bNumeric) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function parseRange(range: string): Comparator[][] | null {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let set: Comparator[][] = [];
+  for (const part of raw.split("||")) {
+    const comparators = parseComparatorSet(part.trim());
+    if (comparators === null) return null;
+    if (comparators.length) set.push(comparators);
+  }
+  if (!set.length) return null;
+  if (set.length > 1) {
+    const first = set[0];
+    set = set.filter((comparators) => !isNullSet(comparators[0]));
+    if (set.length === 0) return [first];
+    const anySet = set.find((comparators) => comparators.length === 1 && comparators[0].value === "");
+    if (anySet) return [anySet];
+  }
+  return set;
+}
+
+function parseComparatorSet(range: string): Comparator[] | null {
+  const expanded = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RANGE_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comps = expanded
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const comp of comps) {
+    const comparator = parseComparator(comp);
+    if (comparator === null) return null;
+    comparators.push(comparator);
+  }
+  const byValue = new Map<string, Comparator>();
+  for (const comparator of comparators) {
+    if (isNullSet(comparator)) return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(comp: string): Comparator | null {
+  const match = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) return null;
+  const operator = (match[1] === "=" ? "" : (match[1] ?? "")) as Operator;
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseSemVer(match[2]);
+  if (semver === null) return null;
+  return { operator, semver, value: operator + formatSemVer(semver) };
+}
+
+function isNullSet(c: Comparator): boolean {
+  return c.value === "<0.0.0-0";
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.replace(BUILD_RE, "").trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function hyphenReplace(...groups: string[]): string {
+  const [, from, fM, fm, fp, fpr, , to, tM, tm, tp, tpr] = groups;
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lower} <${M}.${m}.${+p! + 1}-0`;
+      return `${lower} <${M}.${+m! + 1}.0-0`;
+    }
+    return `${lower} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${lower} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, operator: string, M: string, m?: string, p?: string) => {
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+    const xMajor = isX(M);
+    const xMinor = xMajor || isX(m);
+    const anyX = xMinor || isX(p);
+    if (operator === "=" && anyX) operator = "";
+
+    if (xMajor) return operator === ">" || operator === "<" ? "<0.0.0-0" : "*";
+    if (operator && anyX) {
+      let major = +M;
+      let minor = xMinor ? 0 : +m!;
+      let patch = 0;
+      let suffix = "";
+      if (operator === ">") {
+        operator = ">=";
+        if (xMinor) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+        patch = 0;
+      } else if (operator === "<=") {
+        operator = "<";
+        if (xMinor) major += 1;
+        else minor += 1;
+      }
+      if (operator === "<") suffix = "-0";
+      return `${operator}${major}.${minor}.${patch}${suffix}`;
+    }
+    if (xMinor) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function testRange(set: Comparator[][], version: SemVer): boolean {
+  return set.some((comparators) => testComparatorSet(comparators, version));
+}
+
+function testComparatorSet(comparators: Comparator[], version: SemVer): boolean {
+  if (!comparators.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return comparators.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function testComparator(c: Comparator, version: SemVer): boolean {
+  if (c.semver === null) return true;
+  const order = compare(version, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
 }
