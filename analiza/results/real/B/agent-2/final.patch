--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,309 @@
+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+const MAX_LENGTH = 256;
+
+const NUMERIC = "0|[1-9]\\d*";
+const NUMERIC_LOOSE = "\\d+";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const MAIN_LOOSE = `(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})\\.(${NUMERIC_LOOSE})`;
+const PRE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRE_ID_LOOSE = `(?:${NUMERIC_LOOSE}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD = "(?:\\+([a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*))";
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+// node-semver uses its "safe" regexes, where `\s*` is `\s{0,1}` and `\s+` is `\s{1}`.
+const RE = {
+  full: new RegExp(`^${FULL_PLAIN}$`),
+  buildStrip: new RegExp(BUILD, "g"),
+  comparator: new RegExp(`^${GTLT}\\s?(${FULL_PLAIN})$|^$`),
+  comparatorTrim: new RegExp(`(\\s?)${GTLT}\\s?(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g"),
+  tildeTrim: /(\s?)(?:~>?)\s/g,
+  caretTrim: /(\s?)(?:\^)\s/g,
+  tilde: new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`),
+  caret: new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`),
+  xrange: new RegExp(`^${GTLT}\\s?${XRANGE_PLAIN}$`),
+  hyphen: new RegExp(`^\\s?(${XRANGE_PLAIN})\\s-\\s(${XRANGE_PLAIN})\\s?$`),
+  star: /(<|>)?=?\s?\*/,
+  gte0: /^\s?>=\s?0\.0\.0\s?$/,
+};
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH}`);
+  const m = input.trim().match(RE.full);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  for (const n of [major, minor, patch]) {
+    if (n > Number.MAX_SAFE_INTEGER) throw new TypeError("Invalid version number");
+  }
+  const prerelease: Identifier[] = m[4]
+    ? m[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const num = Number(id);
+          if (num < Number.MAX_SAFE_INTEGER) return num;
+        }
+        return id;
+      })
+    : [];
+  const version = `${major}.${minor}.${patch}${prerelease.length ? `-${prerelease.join(".")}` : ""}`;
+  return { major, minor, patch, prerelease, version };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) {
+    a = Number(a);
+    b = Number(b);
+  }
+  if (a === b) return 0;
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePre(a, b)
+  );
+}
+
+function comparePre(a: SemVer, b: SemVer): number {
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+function parseComparator(input: string): Comparator {
+  const comp = input.trim().split(/\s+/).join(" ");
+  const m = comp.match(RE.comparator);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  return { operator, semver, value: operator + semver.version };
+}
+
+function testComparator(c: Comparator, version: SemVer): boolean {
+  if (!c.semver) return true;
+  const order = compare(version, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new TypeError(`Invalid operator: ${c.operator}`);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(RE.caret, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${from} <${M}.${m}.${+p + 1}-0`;
+      return `${from} <${M}.${+m + 1}.0-0`;
+    }
+    return `${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(RE.tilde, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(input: string): string {
+  const comp = input.trim();
+  return comp.replace(RE.xrange, (ret, gtlt: string, M: string, m: string, p: string) => {
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    if (gtlt === "=" && xp) gtlt = "";
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let [major, minor, patch] = [+M, xm ? 0 : +m, 0];
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+        patch = 0;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      const pre = gtlt === "<" ? "-0" : "";
+      return `${gtlt}${major}.${minor}.${patch}${pre}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    return ret;
+  });
+}
+
+function hyphenReplace(...g: string[]): string {
+  const [, fromRaw, fM, fm, fp, fpr, , toRaw, tM, tm, tp, tpr] = g;
+  let from: string;
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${fromRaw}`;
+
+  let to: string;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${toRaw}`;
+  return `${from} ${to}`.trim();
+}
+
+function expandComparator(input: string): string {
+  let comp = input.trim().split(/\s+/).map(replaceCaret).join(" ");
+  comp = comp.trim().split(/\s+/).map(replaceTilde).join(" ");
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(RE.star, "");
+}
+
+function parseComparatorSet(input: string): Comparator[] {
+  const range = input
+    .replace(RE.buildStrip, "")
+    .trim()
+    .replace(RE.hyphen, hyphenReplace)
+    .replace(RE.comparatorTrim, "$1$2$3")
+    .replace(RE.tildeTrim, "$1~")
+    .replace(RE.caretTrim, "$1^");
+  const parts = range
+    .split(" ")
+    .map(expandComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(RE.gte0, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of parts.map(parseComparator)) {
+    if (comp.value === "<0.0.0-0") return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseRange(input: string): Comparator[][] {
+  const raw = input.trim().split(/\s+/).join(" ");
+  let sets = raw
+    .split("||")
+    .map((r) => parseComparatorSet(r))
+    .filter((set) => set.length > 0);
+  if (sets.length === 0) throw new TypeError(`Invalid SemVer Range: ${raw}`);
+  if (sets.length > 1) {
+    const first = sets[0];
+    sets = sets.filter((set) => set[0].value !== "<0.0.0-0");
+    if (sets.length === 0) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0].value === "");
+    if (any) return [any];
+  }
+  return sets;
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (version.prerelease.length === 0) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], input: string): boolean {
+  const version = tryParse(() => parseVersion(input));
+  if (!version) return false;
+  return sets.some((set) => testSet(set, version));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return false;
+  return testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const v of versions) {
+    if (!testRange(sets, v)) continue;
+    const parsed = parseVersion(v);
+    if (maxVersion === null || compare(maxVersion, parsed) === -1) {
+      max = v;
+      maxVersion = parsed;
+    }
+  }
+  return max;
 }
