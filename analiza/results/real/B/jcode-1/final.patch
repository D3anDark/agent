+// Port of node-semver v7 range matching with default options (strict, no includePrerelease).
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+};
+
+type Comparator = {
+  operator: string;
+  semver: SemVer | null; // null means "any version"
+  value: string;
+};
+
+type ComparatorSet = Comparator[];
+
+const MAX_LENGTH = 256;
+
+const NUM = String.raw`0|[1-9]\d*`;
+const NUM_LOOSE = String.raw`\d+`;
+const NON_NUM = String.raw`\d*[a-zA-Z-][a-zA-Z0-9-]*`;
+const MAIN = String.raw`(${NUM})\.(${NUM})\.(${NUM})`;
+const MAIN_LOOSE = String.raw`(${NUM_LOOSE})\.(${NUM_LOOSE})\.(${NUM_LOOSE})`;
+const PRE_ID = `(?:${NUM}|${NON_NUM})`;
+const PRE_ID_LOOSE = `(?:${NUM_LOOSE}|${NON_NUM})`;
+const PRERELEASE = String.raw`(?:-(${PRE_ID}(?:\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = String.raw`(?:-?(${PRE_ID_LOOSE}(?:\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = String.raw`(?:\+(${BUILD_ID}(?:\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = String.raw`[v=\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XR_ID = String.raw`${NUM}|x|X|\*`;
+const XRANGE_PLAIN = String.raw`[v=\s]*(${XR_ID})(?:\.(${XR_ID})(?:\.(${XR_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+const LONE_TILDE = "(?:~>?)";
+const LONE_CARET = String.raw`(?:\^)`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(String.raw`^${GTLT}\s*(${FULL_PLAIN})$|^$`);
+const COMPARATOR_TRIM_RE = new RegExp(String.raw`(\s*)${GTLT}\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = new RegExp(String.raw`(\s*)${LONE_TILDE}\s+`, "g");
+const CARET_TRIM_RE = new RegExp(String.raw`(\s*)${LONE_CARET}\s+`, "g");
+const TILDE_RE = new RegExp(`^${LONE_TILDE}${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^${LONE_CARET}${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(String.raw`^${GTLT}\s*${XRANGE_PLAIN}$`);
+const HYPHEN_RE = new RegExp(String.raw`^\s*(${XRANGE_PLAIN})\s+-\s+(${XRANGE_PLAIN})\s*$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = parseRange(range);
+  const parsed = parseVersion(version);
+  if (!sets || !parsed) return false;
+  return rangeTest(sets, parsed);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = parseRange(range);
+  if (!sets) return null;
+  let max: string | null = null;
+  let maxVersion: SemVer | null = null;
+  for (const version of versions) {
+    const parsed = parseVersion(version);
+    if (!parsed || !rangeTest(sets, parsed)) continue;
+    if (!maxVersion || compare(maxVersion, parsed) < 0) {
+      max = version;
+      maxVersion = parsed;
+    }
+  }
+  return max;
+}
+
+function parseVersion(version: string): SemVer | null {
+  if (version.length > MAX_LENGTH) return null;
+  const match = version.trim().match(FULL_RE);
+  if (!match) return null;
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) return null;
+  const prerelease = match[4] ? match[4].split(".").map(toIdentifier) : [];
+  return { major, minor, patch, prerelease };
+}
+
+function toIdentifier(id: string): Identifier {
+  if (!/^[0-9]+$/.test(id)) return id;
+  const num = Number(id);
+  return num < Number.MAX_SAFE_INTEGER ? num : id;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareNumbers(a.major, b.major) ||
+    compareNumbers(a.minor, b.minor) ||
+    compareNumbers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function compareNumbers(a: number, b: number): number {
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a[i];
+    const y = b[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) return compareNumbers(Number(a), Number(b));
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a < b ? -1 : 1;
+}
+
+function parseRange(range: string): ComparatorSet[] | null {
+  const raw = range.trim().replace(/\s+/g, " ");
+  const sets: ComparatorSet[] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    sets.push(set);
+  }
+  if (sets.length === 1) return sets;
+  const meaningful = sets.filter((set) => !isNullSet(set[0]));
+  if (meaningful.length === 0) return [sets[0]];
+  const anySet = meaningful.find((set) => set.length === 1 && set[0].value === "");
+  return anySet ? [anySet] : meaningful;
+}
+
+function isNullSet(comparator: Comparator): boolean {
+  return comparator.value === "<0.0.0-0";
+}
+
+function parseComparatorSet(range: string): ComparatorSet | null {
+  const desugared = range
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comps = desugared
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const comp of comps) {
+    const comparator = parseComparator(comp);
+    if (!comparator) return null;
+    byValue.set(comparator.value, comparator);
+  }
+  const nullSet = byValue.get("<0.0.0-0");
+  if (nullSet) return [nullSet];
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(comp: string): Comparator | null {
+  const match = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) return null;
+  const operator = match[1] === "=" || match[1] === undefined ? "" : match[1];
+  if (!match[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(match[2]);
+  if (!semver) return null;
+  return { operator, semver, value: operator + formatVersion(semver) };
+}
+
+function formatVersion(v: SemVer): string {
+  const main = `${v.major}.${v.minor}.${v.patch}`;
+  return v.prerelease.length ? `${main}-${v.prerelease.join(".")}` : main;
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.trim().split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+// node-semver 7.8 leaves `x.1` and `1.x.2` unexpanded, so they fail as comparators.
+function isInvalidXRangeOrder(M: string, m?: string, p?: string): boolean {
+  return (isX(M) && !isX(m)) || (isX(m) && !!p && !isX(p));
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m === "0") return `${from} <${M}.${m}.${+p! + 1}-0`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(XRANGE_RE, (whole, gtlt: string, M: string, m?: string, p?: string) => {
+    if (isInvalidXRangeOrder(M, m, p)) return comp;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (gtlt === "=" && anyX) gtlt = "";
+
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      let patch = 0;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) {
+          major += 1;
+          minor = 0;
+        } else {
+          minor += 1;
+        }
+        patch = 0;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      const pr = gtlt === "<" ? "-0" : "";
+      return `${gtlt}${major}.${minor}.${patch}${pr}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _whole: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  _fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function rangeTest(sets: ComparatorSet[], version: SemVer): boolean {
+  return sets.some((set) => testSet(set, version));
+}
+
+function testSet(set: ComparatorSet, version: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c.semver !== null &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function testComparator(c: Comparator, version: SemVer): boolean {
+  if (!c.semver) return true;
+  const order = compare(version, c.semver);
+  switch (c.operator) {
+    case "":
+      return order === 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    default:
+      throw new Error(`Invalid operator: ${c.operator}`);
+  }
 }
