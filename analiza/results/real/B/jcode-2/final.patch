--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,305 @@
+// Port of node-semver v7 range parsing (default options), regexes kept in its shape.
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NON_NUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const PRE_ID = `(?:${NUM}|${NON_NUM})`;
+const PRE_ID_LOOSE = `(?:${NUM_LOOSE}|${NON_NUM})`;
+const PRERELEASE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[0-9A-Za-z-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?(${NUM})\\.(${NUM})\\.(${NUM})${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const X_ID = `${NUM}|x|X|\\*`;
+const X_PLAIN = `[v=\\s]*(${X_ID})(?:\\.(${X_ID})(?:\\.(${X_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${X_PLAIN})\\s+-\\s+(${X_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${X_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${X_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${X_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${X_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD, "g");
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+const MAX_LENGTH = 256;
+
+type Identifier = string | number;
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: Identifier[];
+};
+
+// operator is what GTLT captured: "", "=", "<", "<=", ">" or ">=".
+type Comparator = { operator: string; semver: SemVer } | "any";
+
+function parseVersion(input: string): SemVer {
+  if (input.length > MAX_LENGTH) throw new TypeError(`Invalid Version: ${input}`);
+  const m = input.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${input}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) {
+    throw new TypeError(`Invalid Version: ${input}`);
+  }
+  const prerelease = m[4] ? m[4].split(".").map(parsePrereleaseId) : [];
+  return { major, minor, patch, prerelease };
+}
+
+function parsePrereleaseId(id: string): Identifier {
+  if (/^[0-9]+$/.test(id)) {
+    const num = +id;
+    if (num < Number.MAX_SAFE_INTEGER) return num;
+  }
+  return id;
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNumeric = /^[0-9]+$/.test(String(a));
+  const bNumeric = /^[0-9]+$/.test(String(b));
+  if (aNumeric && bNumeric) {
+    a = +a;
+    b = +b;
+  }
+  if (a === b) return 0;
+  if (aNumeric && !bNumeric) return -1;
+  if (bNumeric && !aNumeric) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  return (
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch) ||
+    comparePrerelease(a.prerelease, b.prerelease)
+  );
+}
+
+function comparePrerelease(a: Identifier[], b: Identifier[]): number {
+  if (a.length && !b.length) return -1;
+  if (!a.length && b.length) return 1;
+  for (let i = 0; ; i++) {
+    if (i >= a.length && i >= b.length) return 0;
+    if (i >= b.length) return 1;
+    if (i >= a.length) return -1;
+    const result = compareIdentifiers(a[i], b[i]);
+    if (result) return result;
+  }
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function replaceHyphen(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  fpr: string,
+  _fb: string,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string,
+): string {
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+  return `${from} ${to}`.trim();
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${lower} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${lower} <${M}.${+m + 1}.0-0`;
+    return `${lower} <${M}.${m}.${+p + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m: string, p: string, pr: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp
+    .trim()
+    .replace(XRANGE_RE, (whole, gtlt: string, M: string, m: string, p: string) => {
+      // `x.1` and `1.x.3` stay unchanged so the comparator parse rejects them.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return whole;
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const anyX = xm || isX(p);
+      if (gtlt === "=" && anyX) gtlt = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && anyX) {
+        let [major, minor] = [+M, xm ? 0 : +m];
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) major++;
+          else minor++;
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major++;
+          else minor++;
+        }
+        return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (anyX) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return whole;
+    });
+}
+
+function eachToken(comp: string, replace: (token: string) => string): string {
+  return comp.trim().split(/\s+/).map(replace).join(" ");
+}
+
+function desugarComparator(comp: string): string {
+  comp = eachToken(comp, replaceCaret);
+  comp = eachToken(comp, replaceTilde);
+  comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+  return comp.trim().replace(STAR_RE, "");
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.trim().match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  if (!m[2]) return "any";
+  return { operator: m[1], semver: parseVersion(m[2]) };
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range
+    .replace(BUILD_RE, "")
+    .replace(HYPHEN_RE, replaceHyphen)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comparators = range
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""))
+    .map(parseComparator);
+  const nullComparator = comparators.find(isNullComparator);
+  if (nullComparator) return [nullComparator];
+  const bounded = comparators.filter((comp) => comp !== "any");
+  return bounded.length ? bounded : [comparators[0]];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const normalized = range.trim().split(/\s+/).join(" ");
+  const sets = normalized.split("||").map((set) => parseComparatorSet(set.trim()));
+  if (sets.length === 1) return sets;
+  // node-semver drops `<0.0.0-0` sets and collapses to a lone `*` set, which changes prerelease results.
+  const nonNull = sets.filter((set) => !isNullComparator(set[0]));
+  if (nonNull.length === 0) return [sets[0]];
+  const anySet = nonNull.find((set) => set.length === 1 && set[0] === "any");
+  return anySet ? [anySet] : nonNull;
+}
+
+function isNullComparator(comp: Comparator): boolean {
+  if (comp === "any" || comp.operator !== "<") return false;
+  const { major, minor, patch, prerelease } = comp.semver;
+  return major === 0 && minor === 0 && patch === 0 && prerelease.length === 1 && prerelease[0] === 0;
+}
+
+function testComparator(comp: Comparator, version: SemVer): boolean {
+  if (comp === "any") return true;
+  const order = compare(version, comp.semver);
+  switch (comp.operator) {
+    case "":
+    case "=":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+    default:
+      throw new Error(`Unknown operator: ${comp.operator}`);
+  }
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((comp) => testComparator(comp, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (comp) =>
+      comp !== "any" &&
+      comp.semver.prerelease.length > 0 &&
+      comp.semver.major === version.major &&
+      comp.semver.minor === version.minor &&
+      comp.semver.patch === version.patch,
+  );
+}
+
+function testRange(sets: Comparator[][], version: string): boolean {
+  let parsed: SemVer;
+  try {
+    parsed = parseVersion(version);
+  } catch {
+    return false;
+  }
+  return sets.some((set) => testSet(set, parsed));
+}
+
+function tryParseRange(range: string): Comparator[][] | null {
+  try {
+    return parseRange(range);
+  } catch {
+    return null;
+  }
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParseRange(range);
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParseRange(range);
+  if (!sets) return null;
+  let max: { raw: string; semver: SemVer } | null = null;
+  for (const raw of versions) {
+    if (!testRange(sets, raw)) continue;
+    const semver = parseVersion(raw);
+    if (!max || compare(max.semver, semver) < 0) max = { raw, semver };
+  }
+  return max?.raw ?? null;
 }
