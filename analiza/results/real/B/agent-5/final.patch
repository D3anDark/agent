+// Port of node-semver v7 range matching with default options (not loose, no includePrerelease).
+
+const NUM = "0|[1-9]\\d*";
+const NUM_LOOSE = "\\d+";
+const NON_NUM = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUM})\\.(${NUM})\\.(${NUM})`;
+const MAIN_LOOSE = `(${NUM_LOOSE})\\.(${NUM_LOOSE})\\.(${NUM_LOOSE})`;
+const PRE_ID = `(?:${NON_NUM}|${NUM})`;
+const PRE_ID_LOOSE = `(?:${NON_NUM}|${NUM_LOOSE})`;
+const PRE = `(?:-(${PRE_ID}(?:\\.${PRE_ID})*))`;
+const PRE_LOOSE = `(?:-?(${PRE_ID_LOOSE}(?:\\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const X_ID = `${NUM}|x|X|\\*`;
+const X_PLAIN = `[v=\\s]*(${X_ID})(?:\\.(${X_ID})(?:\\.(${X_ID})(?:${PRE})?${BUILD}?)?)?`;
+
+// node-semver bounds its quantifiers against ReDoS, which also changes what matches:
+// `\s*` allows one space, so `1.0.0 +b - 2` (two spaces once `+b` is stripped) is not a hyphen range.
+function safeRegExp(source: string, flags?: string): RegExp {
+  const bounds: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", 256],
+    ["[a-zA-Z0-9-]", 250],
+  ];
+  for (const [token, max] of bounds) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return new RegExp(source, flags);
+}
+
+const FULL_RE = safeRegExp(`^${FULL_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD, "g");
+const HYPHEN_RE = safeRegExp(`^\\s*(${X_PLAIN})\\s+-\\s+(${X_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = safeRegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${X_PLAIN})`, "g");
+const TILDE_TRIM_RE = safeRegExp("(\\s*)~>?\\s+", "g");
+const CARET_TRIM_RE = safeRegExp("(\\s*)\\^\\s+", "g");
+const TILDE_RE = safeRegExp(`^~>?${X_PLAIN}$`);
+const CARET_RE = safeRegExp(`^\\^${X_PLAIN}$`);
+const XRANGE_RE = safeRegExp(`^${GTLT}\\s*${X_PLAIN}$`);
+const STAR_RE = safeRegExp("(<|>)?=?\\s*\\*");
+const GTE0_RE = safeRegExp("^\\s*>=\\s*0\\.0\\.0\\s*$");
+const COMPARATOR_RE = safeRegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+
+type SemVer = { major: number; minor: number; patch: number; prerelease: string[] };
+type Operator = "" | "<" | "<=" | ">" | ">=";
+type Comparator = { operator: Operator; semver: SemVer | null };
+type Range = Comparator[][];
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const parsedRange = parseRange(range);
+  const parsedVersion = parseSemVer(version);
+  if (!parsedRange || !parsedVersion) return false;
+  return testRange(parsedRange, parsedVersion);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const parsedRange = parseRange(range);
+  if (!parsedRange) return null;
+  let max: string | null = null;
+  let maxSemVer: SemVer | null = null;
+  for (const version of versions) {
+    const semver = parseSemVer(version);
+    if (!semver || !testRange(parsedRange, semver)) continue;
+    if (!maxSemVer || compare(maxSemVer, semver) < 0) {
+      max = version;
+      maxSemVer = semver;
+    }
+  }
+  return max;
+}
+
+function parseSemVer(version: string): SemVer | null {
+  if (version.length > 256) return null;
+  const match = version.trim().match(FULL_RE);
+  if (!match) return null;
+  const [major, minor, patch] = [match[1], match[2], match[3]].map(Number);
+  if ([major, minor, patch].some((n) => n > Number.MAX_SAFE_INTEGER)) return null;
+  return { major, minor, patch, prerelease: match[4] ? match[4].split(".") : [] };
+}
+
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const aNumeric = /^[0-9]+$/.test(String(a));
+  const bNumeric = /^[0-9]+$/.test(String(b));
+  if (aNumeric && bNumeric) {
+    a = Number(a);
+    b = Number(b);
+  }
+  if (a === b) return 0;
+  if (aNumeric && !bNumeric) return -1;
+  if (bNumeric && !aNumeric) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function parseRange(range: string): Range | null {
+  const normalized = range.trim().split(/\s+/).join(" ");
+  const set: Range = [];
+  for (const part of normalized.split("||")) {
+    const comparators = parseComparatorSet(part.trim());
+    if (!comparators) return null;
+    set.push(comparators);
+  }
+  // Like node-semver, `x || *` collapses to `*`, which then rejects every prerelease.
+  const anySet = set.find((comparators) => comparators.length === 1 && !comparators[0].semver);
+  return set.length > 1 && anySet ? [anySet] : set;
+}
+
+function parseComparatorSet(range: string): Comparator[] | null {
+  const desugared = range
+    .replace(BUILD_RE, "")
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^")
+    .split(" ")
+    .map(desugarComparator)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators: Comparator[] = [];
+  for (const comp of new Set(desugared)) {
+    const comparator = parseComparator(comp);
+    if (!comparator) return null;
+    comparators.push(comparator);
+  }
+  return comparators;
+}
+
+function parseComparator(comp: string): Comparator | null {
+  const match = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!match) return null;
+  const operator = (match[1] === "=" ? "" : (match[1] ?? "")) as Operator;
+  if (!match[2]) return { operator, semver: null };
+  const semver = parseSemVer(match[2]);
+  return semver ? { operator, semver } : null;
+}
+
+function desugarComparator(comp: string): string {
+  const carets = comp.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m: string, p: string, pr: string | undefined) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `>=${from} <${M}.${m}.${+p + 1}-0`;
+      return `>=${from} <${M}.${+m + 1}.0-0`;
+    }
+    return `>=${from} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m: string, p: string, pr: string | undefined) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m + 1}.0-0`;
+    const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+    return `>=${from} <${M}.${+m + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.trim().replace(
+    XRANGE_RE,
+    (whole, gtlt: string, M: string, m: string | undefined, p: string | undefined) => {
+      // semver 7.8 rejects a number after an x, like `x.1` or `1.x.2`.
+      if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp.trim();
+      const xM = isX(M);
+      const xm = xM || isX(m);
+      const xp = xm || isX(p);
+      if (gtlt === "=" && xp) gtlt = "";
+      if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+      if (gtlt && xp) {
+        let major = +M;
+        let minor = xm ? 0 : Number(m);
+        if (gtlt === ">") {
+          gtlt = ">=";
+          if (xm) major++;
+          else minor++;
+        } else if (gtlt === "<=") {
+          gtlt = "<";
+          if (xm) major++;
+          else minor++;
+        }
+        return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+      }
+      if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+      if (xp) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return whole;
+    },
+  );
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string,
+  fp: string,
+  _fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string,
+  tp: string,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+
+  return `${lower} ${upper}`.trim();
+}
+
+function testRange(range: Range, version: SemVer): boolean {
+  return range.some((set) => testSet(set, version));
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((c) => testComparator(c, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function testComparator({ operator, semver }: Comparator, version: SemVer): boolean {
+  if (!semver) return true;
+  const order = compare(version, semver);
+  switch (operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
 }
