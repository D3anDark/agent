+// Port of node-semver v7 Range/Comparator/SemVer with default options (not loose, no includePrerelease).
+const MAX_LENGTH = 256;
+
+// node-semver bounds quantifiers to avoid ReDoS; keeping the same bounds keeps the same accept set.
+function bounded(source: string): string {
+  const limits: [string, number][] = [
+    ["\\s", 1],
+    ["\\d", MAX_LENGTH],
+    ["[a-zA-Z0-9-]", MAX_LENGTH - 6],
+  ];
+  for (const [token, max] of limits) {
+    source = source
+      .split(`${token}*`)
+      .join(`${token}{0,${max}}`)
+      .split(`${token}+`)
+      .join(`${token}{1,${max}}`);
+  }
+  return source;
+}
+
+const NUMERIC = "0|[1-9]\\d*";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const PRERELEASE_ID = `(?:${NON_NUMERIC}|${NUMERIC})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*(\\d+)\\.(\\d+)\\.(\\d+)(?:-?((?:${NON_NUMERIC}|\\d+)(?:\\.(?:${NON_NUMERIC}|\\d+))*))?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XID})(?:\\.(${XID})(?:\\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const re = (source: string, flags?: string) => new RegExp(bounded(source), flags);
+const FULL_RE = re(`^${FULL_PLAIN}$`);
+const BUILD_STRIP_RE = new RegExp(BUILD, "g");
+const BUILD_RE = re(BUILD);
+const HYPHEN_RE = re(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = re(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = re("(\\s*)(?:~>?)\\s+", "g");
+const CARET_TRIM_RE = re("(\\s*)(?:\\^)\\s+", "g");
+const TILDE_RE = re(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = re(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = re(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = re("(<|>)?=?\\s*\\*");
+const GTE0_RE = re("^\\s*>=\\s*0\\.0\\.0\\s*$");
+const COMPARATOR_RE = re(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+
+type Identifier = string | number;
+type Version = { major: number; minor: number; patch: number; prerelease: Identifier[] };
+type Operator = "" | "<" | "<=" | ">" | ">=";
+type Comparator = { operator: Operator; semver: Version } | "any";
+
+function parseVersion(version: string): Version {
+  if (version.length > MAX_LENGTH) throw new TypeError(`version is longer than ${MAX_LENGTH} characters`);
+  const m = version.trim().match(FULL_RE);
+  if (!m) throw new TypeError(`Invalid Version: ${version}`);
+  const [major, minor, patch] = [+m[1], +m[2], +m[3]];
+  for (const part of [major, minor, patch]) {
+    if (part > Number.MAX_SAFE_INTEGER) throw new TypeError(`Invalid Version: ${version}`);
+  }
+  const prerelease = m[4]
+    ? m[4].split(".").map((id) => {
+        const num = /^[0-9]+$/.test(id) ? +id : NaN;
+        return num < Number.MAX_SAFE_INTEGER ? num : id;
+      })
+    : [];
+  return { major, minor, patch, prerelease };
+}
+
+function compareIdentifiers(a: Identifier, b: Identifier): number {
+  const aNumeric = typeof a === "number" || /^[0-9]+$/.test(a);
+  const bNumeric = typeof b === "number" || /^[0-9]+$/.test(b);
+  if (aNumeric && bNumeric) {
+    a = +a;
+    b = +b;
+  }
+  if (a === b) return 0;
+  if (aNumeric && !bNumeric) return -1;
+  if (bNumeric && !aNumeric) return 1;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: Version, b: Version): number {
+  const main = a.major - b.major || a.minor - b.minor || a.patch - b.patch;
+  if (main !== 0) return Math.sign(main);
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x !== y) return compareIdentifiers(x, y);
+  }
+}
+
+const isX = (id: string | undefined) => !id || id.toLowerCase() === "x" || id === "*";
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+    return `>=${from} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      return M === "0" ? `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0` : `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `${M}.${m}.${p}-${pr}` : `${M}.${m}.${p}`;
+    if (M !== "0") return `>=${from} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `>=${from} <${M}.${+m! + 1}.0-0`;
+    return `>=${from} <${M}.${m}.${+p! + 1}-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  comp = comp.trim();
+  return comp.replace(XRANGE_RE, (ret, gtlt: string, M: string, m?: string, p?: string) => {
+    if ((isX(M) && !isX(m)) || (isX(m) && p && !isX(p))) return comp;
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const anyX = xm || isX(p);
+    if (gtlt === "=" && anyX) gtlt = "";
+
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && anyX) {
+      let major = +M;
+      let minor = xm ? 0 : +m!;
+      if (gtlt === ">") {
+        gtlt = ">=";
+        if (xm) major += 1;
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        gtlt = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${gtlt}${major}.${minor}.0${gtlt === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (anyX) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    return ret;
+  });
+}
+
+function hyphenReplace(...groups: string[]): string {
+  let [, from, fM, fm, fp, , , to, tM, tm, tp, tpr] = groups;
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${from}`;
+
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${+tm + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${to}`;
+
+  return `${from} ${to}`.trim();
+}
+
+function rewriteEach(comp: string, rewrite: (c: string) => string): string {
+  return comp.trim().split(/\s+/).map(rewrite).join(" ");
+}
+
+function parseComparator(comp: string): Comparator {
+  const m = comp.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) throw new TypeError(`Invalid comparator: ${comp}`);
+  if (!m[2]) return "any";
+  const operator = m[1] === "=" ? "" : m[1];
+  return { operator: operator as Operator, semver: parseVersion(m[2]) };
+}
+
+function parseComparatorSet(range: string): Comparator[] {
+  range = range
+    .replace(BUILD_STRIP_RE, "")
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+
+  const desugared = range
+    .split(" ")
+    .map((comp) => {
+      comp = comp.replace(BUILD_RE, "");
+      comp = rewriteEach(comp, replaceCaret);
+      comp = rewriteEach(comp, replaceTilde);
+      comp = comp.split(/\s+/).map(replaceXRange).join(" ");
+      return comp.trim().replace(STAR_RE, "");
+    })
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const comparators = desugared.map(parseComparator);
+  const nullSet = comparators.find(isNullSet);
+  if (nullSet) return [nullSet];
+  const constraints = comparators.filter((c) => c !== "any");
+  return constraints.length ? constraints : ["any"];
+}
+
+function parseRange(range: string): Comparator[][] {
+  const raw = range.trim().replace(/\s+/g, " ");
+  const sets = raw.split("||").map((set) => parseComparatorSet(set.trim()));
+  if (sets.length === 1) return sets;
+  // node-semver drops `<0.0.0-0` sets, and a lone `*` set replaces the whole range (so it rejects prereleases).
+  const satisfiable = sets.filter((set) => !isNullSet(set[0]));
+  if (satisfiable.length === 0) return [sets[0]];
+  const anySet = satisfiable.find((set) => set.length === 1 && set[0] === "any");
+  return anySet ? [anySet] : satisfiable;
+}
+
+function isNullSet(c: Comparator): boolean {
+  return c !== "any" && c.operator === "<" && c.semver.prerelease.length === 1 && compare(c.semver, NULL_VERSION) === 0;
+}
+
+const NULL_VERSION: Version = { major: 0, minor: 0, patch: 0, prerelease: [0] };
+
+function testComparator(comparator: Comparator, version: Version): boolean {
+  if (comparator === "any") return true;
+  const order = compare(version, comparator.semver);
+  switch (comparator.operator) {
+    case "":
+      return order === 0;
+    case "<":
+      return order < 0;
+    case "<=":
+      return order <= 0;
+    case ">":
+      return order > 0;
+    case ">=":
+      return order >= 0;
+  }
+}
+
+function testSet(set: Comparator[], version: Version): boolean {
+  if (!set.every((comparator) => testComparator(comparator, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    (c) =>
+      c !== "any" &&
+      c.semver.prerelease.length > 0 &&
+      c.semver.major === version.major &&
+      c.semver.minor === version.minor &&
+      c.semver.patch === version.patch,
+  );
+}
+
+function tryParse<T>(parse: () => T): T | null {
+  try {
+    return parse();
+  } catch {
+    return null;
+  }
+}
+
+function testRange(sets: Comparator[][], version: string): boolean {
+  const parsed = tryParse(() => parseVersion(version));
+  return parsed !== null && sets.some((set) => testSet(set, parsed));
+}
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = tryParse(() => parseRange(range));
+  return sets !== null && testRange(sets, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = tryParse(() => parseRange(range));
+  if (sets === null) return null;
+  let max: string | null = null;
+  let maxVersion: Version | null = null;
+  for (const v of versions) {
+    if (!testRange(sets, v)) continue;
+    const parsed = parseVersion(v);
+    if (maxVersion === null || compare(maxVersion, parsed) < 0) {
+      max = v;
+      maxVersion = parsed;
+    }
+  }
+  return max;
 }
