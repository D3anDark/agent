+// Port of node-semver v7 range semantics with default options (not loose, no includePrerelease).
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: (string | number)[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+const MAX_LENGTH = 256;
+
+const NUMERIC = "0|[1-9]\\d*";
+const NON_NUMERIC = "\\d*[a-zA-Z-][a-zA-Z0-9-]*";
+const MAIN_VERSION = `(${NUMERIC})\\.(${NUMERIC})\\.(${NUMERIC})`;
+const PRERELEASE_ID = `(?:${NUMERIC}|${NON_NUMERIC})`;
+const PRERELEASE = `(?:-(${PRERELEASE_ID}(?:\\.${PRERELEASE_ID})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = `(?:\\+(${BUILD_ID}(?:\\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN_VERSION}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*(\\d+)\\.(\\d+)\\.(\\d+)(?:-?((?:\\d+|${NON_NUMERIC})(?:\\.(?:\\d+|${NON_NUMERIC}))*))?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XR_ID = `${NUMERIC}|x|X|\\*`;
+const XRANGE_PLAIN = `[v=\\s]*(${XR_ID})(?:\\.(${XR_ID})(?:\\.(${XR_ID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const COMPARATOR_RE = new RegExp(`^${GTLT}\\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(`^\\s*(${XRANGE_PLAIN})\\s+-\\s+(${XRANGE_PLAIN})\\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(`(\\s*)${GTLT}\\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const BUILD_RE = new RegExp(BUILD);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(`^${GTLT}\\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+const NULL_SET = "<0.0.0-0";
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const sets = parseRange(range);
+  const parsed = parseVersion(version);
+  if (!sets || !parsed) return false;
+  return sets.some((set) => testSet(set, parsed));
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const sets = parseRange(range);
+  if (!sets) return null;
+  let max: SemVer | null = null;
+  let maxRaw: string | null = null;
+  for (const raw of versions) {
+    const version = parseVersion(raw);
+    if (!version || !sets.some((set) => testSet(set, version))) continue;
+    if (max && compare(max, version) !== -1) continue;
+    max = version;
+    maxRaw = raw;
+  }
+  return maxRaw;
+}
+
+function parseVersion(input: string): SemVer | null {
+  if (input.length > MAX_LENGTH) return null;
+  const m = input.trim().match(FULL_RE);
+  if (!m) return null;
+  const [major, minor, patch] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  if (![major, minor, patch].every(Number.isSafeInteger)) return null;
+  const prerelease: (string | number)[] = [];
+  for (const id of m[4] ? m[4].split(".") : []) {
+    if (!/^[0-9]+$/.test(id)) {
+      prerelease.push(id);
+      continue;
+    }
+    const n = Number(id);
+    if (!Number.isSafeInteger(n)) return null;
+    prerelease.push(n);
+  }
+  const pre = prerelease.length ? `-${prerelease.join(".")}` : "";
+  return { major, minor, patch, prerelease, version: `${major}.${minor}.${patch}${pre}` };
+}
+
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const aNum = typeof a === "number";
+  const bNum = typeof b === "number";
+  if (aNum && !bNum) return -1;
+  if (bNum && !aNum) return 1;
+  if (a === b) return 0;
+  return a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    const c = compareIdentifiers(x, y);
+    if (c) return c;
+  }
+}
+
+function testComparator(comp: Comparator, version: SemVer): boolean {
+  if (!comp.semver) return true;
+  const c = compare(version, comp.semver);
+  switch (comp.operator) {
+    case "":
+      return c === 0;
+    case "<":
+      return c < 0;
+    case "<=":
+      return c <= 0;
+    case ">":
+      return c > 0;
+    case ">=":
+      return c >= 0;
+  }
+  throw new Error(`Unknown operator: ${comp.operator}`);
+}
+
+function testSet(set: Comparator[], version: SemVer): boolean {
+  if (!set.every((comp) => testComparator(comp, version))) return false;
+  if (!version.prerelease.length) return true;
+  return set.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function parseRange(range: string): Comparator[][] | null {
+  const raw = range.trim().split(/\s+/).join(" ");
+  let sets: Comparator[][] = [];
+  for (const part of raw.split("||")) {
+    const set = parseComparatorSet(part.trim());
+    if (!set) return null;
+    if (set.length) sets.push(set);
+  }
+  if (!sets.length) return null;
+  if (sets.length > 1) {
+    const first = sets[0]!;
+    sets = sets.filter((set) => set[0]!.value !== NULL_SET);
+    if (!sets.length) return [first];
+    const any = sets.find((set) => set.length === 1 && set[0]!.value === "");
+    if (any) return [any];
+  }
+  return sets;
+}
+
+function parseComparatorSet(input: string): Comparator[] | null {
+  const range = input
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^");
+  const comps = range
+    .split(" ")
+    .map(desugar)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const text of comps) {
+    const comp = parseComparator(text);
+    if (!comp) return null;
+    if (comp.value === NULL_SET) return [comp];
+    byValue.set(comp.value, comp);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(input: string): Comparator | null {
+  const m = input.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) return null;
+  const operator = m[1] === "=" || m[1] === undefined ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseVersion(m[2]);
+  if (!semver) return null;
+  return { operator, semver, value: operator + semver.version };
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function desugar(comp: string): string {
+  const stripped = comp.replace(BUILD_RE, "");
+  const carets = stripped.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const from = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M !== "0") return `${from} <${+M + 1}.0.0-0`;
+    if (m !== "0") return `${from} <${M}.${+m! + 1}.0-0`;
+    return `${from} <${M}.${m}.${+p! + 1}-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${+m! + 1}.0-0`;
+    if (pr) return `>=${M}.${m}.${p}-${pr} <${M}.${+m! + 1}.0-0`;
+    return `>=${M}.${m}.${p} <${M}.${+m! + 1}.0-0`;
+  });
+}
+
+function replaceXRange(input: string): string {
+  const comp = input.trim();
+  return comp.replace(XRANGE_RE, (whole, op: string, M: string, mRaw?: string, pRaw?: string) => {
+    const xM = isX(M);
+    const xm = xM || isX(mRaw);
+    const xp = xm || isX(pRaw);
+    const gtlt = op === "=" && xp ? "" : op;
+    if (xM) return gtlt === ">" || gtlt === "<" ? NULL_SET : "*";
+    if (gtlt && xp) {
+      let major = +M;
+      let minor = xm ? 0 : +mRaw!;
+      if (gtlt === ">") {
+        if (xm) major++;
+        else minor++;
+        return `>=${major}.${minor}.0`;
+      }
+      if (gtlt === "<=") {
+        if (xm) major++;
+        else minor++;
+        return `<${major}.${minor}.0-0`;
+      }
+      return gtlt === "<" ? `<${major}.${minor}.0-0` : `${gtlt}${major}.${minor}.0`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${mRaw}.0 <${M}.${+mRaw! + 1}.0-0`;
+    return whole;
+  });
+}
+
+function hyphenReplace(
+  _: string,
+  from: string,
+  fM: string,
+  fm: string | undefined,
+  fp: string | undefined,
+  _fpr: string | undefined,
+  _fb: string | undefined,
+  to: string,
+  tM: string,
+  tm: string | undefined,
+  tp: string | undefined,
+  tpr: string | undefined,
+): string {
+  let lower: string;
+  if (isX(fM)) lower = "";
+  else if (isX(fm)) lower = `>=${fM}.0.0`;
+  else if (isX(fp)) lower = `>=${fM}.${fm}.0`;
+  else lower = `>=${from}`;
+
+  let upper: string;
+  if (isX(tM)) upper = "";
+  else if (isX(tm)) upper = `<${+tM + 1}.0.0-0`;
+  else if (isX(tp)) upper = `<${tM}.${+tm! + 1}.0-0`;
+  else if (tpr) upper = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else upper = `<=${to}`;
+  return `${lower} ${upper}`.trim();
 }
