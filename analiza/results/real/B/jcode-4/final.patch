--- a/src/semver.ts
+++ b/src/semver.ts
@@ -1,8 +1,288 @@
+// Port of node-semver v7 range semantics with default options (not loose, no includePrerelease).
+
+type SemVer = {
+  major: number;
+  minor: number;
+  patch: number;
+  prerelease: (string | number)[];
+  version: string;
+};
+
+type Comparator = { operator: string; semver: SemVer | null; value: string };
+
+const NUM = String.raw`0|[1-9]\d*`;
+const NUM_LOOSE = String.raw`\d+`;
+const NON_NUM = String.raw`\d*[a-zA-Z-][a-zA-Z0-9-]*`;
+const MAIN = String.raw`(${NUM})\.(${NUM})\.(${NUM})`;
+const MAIN_LOOSE = String.raw`(${NUM_LOOSE})\.(${NUM_LOOSE})\.(${NUM_LOOSE})`;
+const PRE_ID = `(?:${NUM}|${NON_NUM})`;
+const PRE_ID_LOOSE = `(?:${NUM_LOOSE}|${NON_NUM})`;
+const PRERELEASE = String.raw`(?:-(${PRE_ID}(?:\.${PRE_ID})*))`;
+const PRERELEASE_LOOSE = String.raw`(?:-?(${PRE_ID_LOOSE}(?:\.${PRE_ID_LOOSE})*))`;
+const BUILD_ID = "[a-zA-Z0-9-]+";
+const BUILD = String.raw`(?:\+(${BUILD_ID}(?:\.${BUILD_ID})*))`;
+const FULL_PLAIN = `v?${MAIN}${PRERELEASE}?${BUILD}?`;
+const LOOSE_PLAIN = `[v=\\s]*${MAIN_LOOSE}${PRERELEASE_LOOSE}?${BUILD}?`;
+const GTLT = "((?:<|>)?=?)";
+const XID = `${NUM}|x|X|\\*`;
+const XRANGE_PLAIN = String.raw`[v=\s]*(${XID})(?:\.(${XID})(?:\.(${XID})(?:${PRERELEASE})?${BUILD}?)?)?`;
+
+const FULL_RE = new RegExp(`^${FULL_PLAIN}$`);
+const BUILD_RE = new RegExp(BUILD);
+const COMPARATOR_RE = new RegExp(String.raw`^${GTLT}\s*(${FULL_PLAIN})$|^$`);
+const HYPHEN_RE = new RegExp(String.raw`^\s*(${XRANGE_PLAIN})\s+-\s+(${XRANGE_PLAIN})\s*$`);
+const COMPARATOR_TRIM_RE = new RegExp(String.raw`(\s*)${GTLT}\s*(${LOOSE_PLAIN}|${XRANGE_PLAIN})`, "g");
+const TILDE_TRIM_RE = /(\s*)(?:~>?)\s+/g;
+const CARET_TRIM_RE = /(\s*)(?:\^)\s+/g;
+const TILDE_RE = new RegExp(`^(?:~>?)${XRANGE_PLAIN}$`);
+const CARET_RE = new RegExp(`^(?:\\^)${XRANGE_PLAIN}$`);
+const XRANGE_RE = new RegExp(String.raw`^${GTLT}\s*${XRANGE_PLAIN}$`);
+const STAR_RE = /(<|>)?=?\s*\*/;
+const GTE0_RE = /^\s*>=\s*0\.0\.0\s*$/;
+
+const MAX_LENGTH = 256;
+
 export function satisfies(version: string, range: string): boolean {
-  return version === range;
+  const set = parseRangeSet(range);
+  return set !== null && testRange(set, version);
 }
 
 export function maxSatisfying(versions: string[], range: string): string | null {
-  const matching = versions.filter((v) => satisfies(v, range));
-  return matching.sort().at(-1) ?? null;
+  const set = parseRangeSet(range);
+  if (set === null) return null;
+  let max: string | null = null;
+  let maxSemver: SemVer | null = null;
+  for (const version of versions) {
+    if (!testRange(set, version)) continue;
+    const semver = parseSemver(version);
+    if (semver && (maxSemver === null || compare(maxSemver, semver) === -1)) {
+      max = version;
+      maxSemver = semver;
+    }
+  }
+  return max;
+}
+
+function parseSemver(version: string): SemVer | null {
+  if (version.length > MAX_LENGTH) return null;
+  const m = version.trim().match(FULL_RE);
+  if (!m) return null;
+  const [major, minor, patch] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  if (major > Number.MAX_SAFE_INTEGER || minor > Number.MAX_SAFE_INTEGER || patch > Number.MAX_SAFE_INTEGER) {
+    return null;
+  }
+  const prerelease = m[4]
+    ? m[4].split(".").map((id) => {
+        if (/^[0-9]+$/.test(id)) {
+          const num = Number(id);
+          if (num < Number.MAX_SAFE_INTEGER) return num;
+        }
+        return id;
+      })
+    : [];
+  const base = `${major}.${minor}.${patch}`;
+  const version_ = prerelease.length ? `${base}-${prerelease.join(".")}` : base;
+  return { major, minor, patch, prerelease, version: version_ };
+}
+
+function compareIdentifiers(a: string | number, b: string | number): number {
+  const aNum = /^[0-9]+$/.test(String(a));
+  const bNum = /^[0-9]+$/.test(String(b));
+  if (aNum && bNum) {
+    const [x, y] = [Number(a), Number(b)];
+    return x === y ? 0 : x < y ? -1 : 1;
+  }
+  if (aNum) return -1;
+  if (bNum) return 1;
+  return a === b ? 0 : a < b ? -1 : 1;
+}
+
+function compare(a: SemVer, b: SemVer): number {
+  const main =
+    compareIdentifiers(a.major, b.major) ||
+    compareIdentifiers(a.minor, b.minor) ||
+    compareIdentifiers(a.patch, b.patch);
+  if (main !== 0) return main;
+  if (a.prerelease.length && !b.prerelease.length) return -1;
+  if (!a.prerelease.length && b.prerelease.length) return 1;
+  for (let i = 0; ; i++) {
+    const x = a.prerelease[i];
+    const y = b.prerelease[i];
+    if (x === undefined && y === undefined) return 0;
+    if (y === undefined) return 1;
+    if (x === undefined) return -1;
+    if (x === y) continue;
+    return compareIdentifiers(x, y);
+  }
+}
+
+function parseRangeSet(range: string): Comparator[][] | null {
+  const raw = range.trim().split(/\s+/).join(" ");
+  const set: Comparator[][] = [];
+  for (const part of raw.split("||")) {
+    const comparators = parseAndSet(part.trim());
+    if (comparators === null) return null;
+    set.push(comparators);
+  }
+  if (set.length <= 1) return set;
+  const nonNull = set.filter((c) => c[0].value !== "<0.0.0-0");
+  if (nonNull.length === 0) return [set[0]];
+  const any = nonNull.find((c) => c.length === 1 && c[0].value === "");
+  return any ? [any] : nonNull;
+}
+
+function parseAndSet(range: string): Comparator[] | null {
+  const expanded = range
+    .replace(HYPHEN_RE, hyphenReplace)
+    .replace(COMPARATOR_TRIM_RE, "$1$2$3")
+    .replace(TILDE_TRIM_RE, "$1~")
+    .replace(CARET_TRIM_RE, "$1^")
+    .split(" ")
+    .map(parseComparatorSugar)
+    .join(" ")
+    .split(/\s+/)
+    .map((comp) => comp.trim().replace(GTE0_RE, ""));
+
+  const byValue = new Map<string, Comparator>();
+  for (const text of expanded) {
+    const comparator = parseComparator(text);
+    if (comparator === null) return null;
+    if (comparator.value === "<0.0.0-0") return [comparator];
+    byValue.set(comparator.value, comparator);
+  }
+  if (byValue.size > 1) byValue.delete("");
+  return [...byValue.values()];
+}
+
+function parseComparator(text: string): Comparator | null {
+  const m = text.trim().split(/\s+/).join(" ").match(COMPARATOR_RE);
+  if (!m) return null;
+  const operator = m[1] === undefined || m[1] === "=" ? "" : m[1];
+  if (!m[2]) return { operator, semver: null, value: "" };
+  const semver = parseSemver(m[2]);
+  if (semver === null) return null;
+  return { operator, semver, value: operator + semver.version };
+}
+
+function isX(id: string | undefined): boolean {
+  return !id || id.toLowerCase() === "x" || id === "*";
+}
+
+function hyphenReplace(...g: (string | undefined)[]): string {
+  const [, fromRaw = "", fM, fm, fp, fpr, , toRaw = "", tM, tm, tp, tpr] = g;
+  let from: string;
+  if (isX(fM)) from = "";
+  else if (isX(fm)) from = `>=${fM}.0.0`;
+  else if (isX(fp)) from = `>=${fM}.${fm}.0`;
+  else from = `>=${fromRaw}`;
+
+  let to: string;
+  if (isX(tM)) to = "";
+  else if (isX(tm)) to = `<${Number(tM) + 1}.0.0-0`;
+  else if (isX(tp)) to = `<${tM}.${Number(tm) + 1}.0-0`;
+  else if (tpr) to = `<=${tM}.${tm}.${tp}-${tpr}`;
+  else to = `<=${toRaw}`;
+  return `${from} ${to}`.trim();
+}
+
+function parseComparatorSugar(comp: string): string {
+  const noBuild = comp.replace(BUILD_RE, "");
+  const carets = noBuild.trim().split(/\s+/).map(replaceCaret).join(" ");
+  const tildes = carets.trim().split(/\s+/).map(replaceTilde).join(" ");
+  const xranges = tildes.trim().split(/\s+/).map(replaceXRange).join(" ");
+  return xranges.trim().replace(STAR_RE, "");
+}
+
+function replaceCaret(comp: string): string {
+  return comp.replace(CARET_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) {
+      if (M === "0") return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+      return `>=${M}.${m}.0 <${+M + 1}.0.0-0`;
+    }
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    if (M === "0") {
+      if (m === "0") return `${lower} <${M}.${m}.${Number(p) + 1}-0`;
+      return `${lower} <${M}.${Number(m) + 1}.0-0`;
+    }
+    return `${lower} <${+M + 1}.0.0-0`;
+  });
+}
+
+function replaceTilde(comp: string): string {
+  return comp.replace(TILDE_RE, (_, M: string, m?: string, p?: string, pr?: string) => {
+    if (isX(M)) return "";
+    if (isX(m)) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (isX(p)) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+    const lower = pr ? `>=${M}.${m}.${p}-${pr}` : `>=${M}.${m}.${p}`;
+    return `${lower} <${M}.${Number(m) + 1}.0-0`;
+  });
+}
+
+function replaceXRange(comp: string): string {
+  return comp.replace(XRANGE_RE, (whole: string, op: string, M: string, m?: string, p?: string) => {
+    const xM = isX(M);
+    const xm = xM || isX(m);
+    const xp = xm || isX(p);
+    const gtlt = op === "=" && xp ? "" : op;
+
+    if (xM) return gtlt === ">" || gtlt === "<" ? "<0.0.0-0" : "*";
+    if (gtlt && xp) {
+      let [major, minor] = [Number(M), xm ? 0 : Number(m)];
+      let operator = gtlt;
+      if (gtlt === ">") {
+        operator = ">=";
+        if (xm) [major, minor] = [major + 1, 0];
+        else minor += 1;
+      } else if (gtlt === "<=") {
+        operator = "<";
+        if (xm) major += 1;
+        else minor += 1;
+      }
+      return `${operator}${major}.${minor}.0${operator === "<" ? "-0" : ""}`;
+    }
+    if (xm) return `>=${M}.0.0 <${+M + 1}.0.0-0`;
+    if (xp) return `>=${M}.${m}.0 <${M}.${Number(m) + 1}.0-0`;
+    return whole;
+  });
+}
+
+function testRange(set: Comparator[][], version: string): boolean {
+  if (!version) return false;
+  const semver = parseSemver(version);
+  if (semver === null) return false;
+  return set.some((comparators) => testAndSet(comparators, semver));
+}
+
+function testAndSet(comparators: Comparator[], version: SemVer): boolean {
+  if (!comparators.every((c) => testComparator(c, version))) return false;
+  if (version.prerelease.length === 0) return true;
+  return comparators.some(
+    ({ semver }) =>
+      semver !== null &&
+      semver.prerelease.length > 0 &&
+      semver.major === version.major &&
+      semver.minor === version.minor &&
+      semver.patch === version.patch,
+  );
+}
+
+function testComparator({ operator, semver }: Comparator, version: SemVer): boolean {
+  if (semver === null) return true;
+  const c = compare(version, semver);
+  switch (operator) {
+    case "":
+      return c === 0;
+    case ">":
+      return c > 0;
+    case ">=":
+      return c >= 0;
+    case "<":
+      return c < 0;
+    case "<=":
+      return c <= 0;
+    default:
+      throw new Error(`Unexpected operator ${operator}`);
+  }
 }
