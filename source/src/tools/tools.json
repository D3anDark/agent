[
  {
    "name": "read",
    "description": "Read a text file, or several files or line ranges with `paths`, as `anchor│content` rows; an anchor is 4 case-sensitive letters. Edit by anchor, never by content or line number. One file pages at 400 lines unless `limit` says otherwise; continue with `offset` (line number or anchor) from the hint. A stale anchor is refused: read again. Binary, image, UTF-16/32 and >64MB files are rejected.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file to read (relative or absolute)"
        },
        "paths": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "offset": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": ["path"]
              }
            ]
          },
          "description": "Several files, each under a `== path` header: a path reads the whole file, {path, offset, limit} one range. Use instead of `cat` or a chain of `sed -n`."
        },
        "offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string"
            }
          ],
          "description": "Line number (1-indexed) or a served anchor to start reading from"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "description": "Lines from offset, default 400"
        }
      }
    }
  },
  {
    "name": "bash",
    "description": "Run a bash command in the cwd, stderr merged into stdout, no stdin. Output keeps the last 2000 lines or 12KB (50KB with rtk off); a truncated run names its full log.",
    "eager_input_streaming": true,
    "strict": true,
    "input_schema": {
      "type": "object",
      "required": [
        "command",
        "timeout"
      ],
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to execute"
        },
        "timeout": {
          "anyOf": [
            {
              "type": "number",
              "description": "Seconds; null for none"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "write",
    "description": "Create or overwrite a file; creates parent directories.",
    "eager_input_streaming": true,
    "strict": true,
    "input_schema": {
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file to write (relative or absolute)"
        },
        "content": {
          "type": "string",
          "description": "Content to write to the file"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "replace",
    "description": "Replace the lines from anchor `remove_from` to anchor `remove_to` (the same anchor for one line) with `text`. Emptying a file returns its empty-line anchor for a follow-up replace. To change part of a line, use `replace_match`.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "remove_from": {
          "type": "string",
          "description": "Anchor of the first line."
        },
        "remove_to": {
          "type": "string",
          "description": "Anchor of the last line."
        },
        "text": {
          "type": "string",
          "description": "Exact new text; \"\" deletes. A trailing newline ends the last line, it adds no blank line."
        }
      },
      "required": [
        "remove_from",
        "remove_to",
        "text"
      ]
    }
  },
  {
    "name": "replace_match",
    "description": "Replace every `old_string` inside the lines from anchor `replace_from` to anchor `replace_to` (the same anchor for one line); the rest stays byte-for-byte. Send only the smallest changing fragment; for a whole-line rewrite use `replace`.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "replace_from": {
          "type": "string",
          "description": "Anchor of the first line."
        },
        "replace_to": {
          "type": "string",
          "description": "Anchor of the last line."
        },
        "old_string": {
          "type": "string",
          "description": "Exact text to find, copied from the served rows; only the part that changes. Line breaks are LF."
        },
        "new_string": {
          "type": "string",
          "description": "Replacement for every match; \"\" deletes."
        }
      },
      "required": [
        "replace_from",
        "replace_to",
        "old_string",
        "new_string"
      ]
    }
  },
  {
    "name": "insert",
    "description": "Insert `text` after or before the line at `anchor`.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string",
          "description": "Anchor of the line to insert next to."
        },
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "const": "after"
            },
            {
              "type": "string",
              "const": "before"
            }
          ]
        },
        "text": {
          "type": "string",
          "description": "Exact text, without the anchor line; \"\" inserts one blank line. A trailing newline ends the last line, it adds no blank line."
        }
      },
      "required": [
        "anchor",
        "direction",
        "text"
      ]
    }
  },
  {
    "name": "move",
    "description": "Move the lines from `source_from` to `source_to` after or before `anchor`, in this or another file. In one file the destination must sit outside the source range.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "source_from": {
          "type": "string",
          "description": "Anchor of the first source line."
        },
        "source_to": {
          "type": "string",
          "description": "Anchor of the last source line."
        },
        "anchor": {
          "type": "string",
          "description": "Anchor of the destination line."
        },
        "direction": {
          "anyOf": [
            {
              "type": "string",
              "const": "after"
            },
            {
              "type": "string",
              "const": "before"
            }
          ]
        }
      },
      "required": [
        "source_from",
        "source_to",
        "anchor",
        "direction"
      ]
    }
  },
  {
    "name": "undo_last_change",
    "description": "Undo the last replace, replace_match, insert or move on a file. Refused if the file changed since.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file to undo"
        }
      },
      "required": [
        "path"
      ]
    }
  },
  {
    "name": "context_tree_query",
    "description": "Get back the original outputs of tool calls a pruner summary replaced, by the short refs it lists (e.g. [\"t12\", \"t3\"]).",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "toolCallIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short refs or raw tool call ids."
        }
      },
      "required": [
        "toolCallIds"
      ]
    }
  },
  {
    "name": "todo",
    "description": "Task list for multi-step work. Status: pending, in_progress, completed; delete leaves a tombstone.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "list",
            "get",
            "delete",
            "clear"
          ]
        },
        "subject": {
          "type": "string",
          "description": "Required for create"
        },
        "description": {
          "type": "string",
          "description": "Long-form task description"
        },
        "activeForm": {
          "type": "string",
          "description": "Spinner label while in_progress, e.g. 'writing tests'"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "deleted"
          ],
          "description": "New status (update) or filter (list)"
        },
        "blockedBy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "create only"
        },
        "addBlockedBy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "update only"
        },
        "removeBlockedBy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "update only"
        },
        "owner": {
          "type": "string",
          "description": "Agent/owner assigned to this task"
        },
        "metadata": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          },
          "description": "A null value deletes its key on update"
        },
        "id": {
          "type": "number",
          "description": "Required for update, get, delete"
        },
        "includeDeleted": {
          "type": "boolean",
          "description": "list: include deleted tasks"
        }
      },
      "required": [
        "action"
      ]
    }
  },
  {
    "name": "create_goal",
    "description": "Only on explicit user request: set a goal the agent keeps working toward across turns until update_goal marks it complete.",
    "input_schema": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string", "description": "Full objective; preserve ordered steps and done criteria." },
        "token_budget": { "type": "integer", "minimum": 1, "description": "Whole-token budget, only if supplied by the user." }
      }
    }
  },
  {
    "name": "get_goal",
    "description": "Read the goal: objective, status, tokens used and budget.",
    "input_schema": { "type": "object", "properties": {} }
  },
  {
    "name": "update_goal",
    "description": "Mark the goal complete once its done criteria are met, with the evidence that shows it.",
    "input_schema": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["complete"] },
        "evidence": { "type": "string", "description": "Commands and results that prove the done criteria are met." }
      }
    }
  },
  {
    "name": "subagent",
    "description": "Spawn child agents as separate processes with their own context and no subagent, terminal, web or ask_user_question tools; an `explore: true` child only gets read and rg. Pass {label, prompt} for one child or {tasks: [...]} for several in parallel. Returns each child's final answer; with background: true, run ids now and answers later as messages.",
    "input_schema": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "minLength": 1, "description": "Chip label, e.g. 'api reviewer'" },
        "prompt": { "type": "string", "description": "Self-contained task; the child does not see this conversation" },
        "model": { "type": "string", "description": "Omit or 'inherit' for yours" },
        "effort": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"], "description": "Omit for yours" },
        "explore": { "type": "boolean", "description": "Context gathering: only read and rg, cheaper" },
        "tasks": {
          "type": "array",
          "description": "Parallel children",
          "items": {
            "type": "object",
            "required": ["label", "prompt"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "prompt": { "type": "string" },
              "model": { "type": "string" },
              "effort": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
              "explore": { "type": "boolean" }
            }
          }
        },
        "cwd": { "type": "string", "description": "Default: current directory" },
        "background": { "type": "boolean" }
      }
    }
  },
  {
    "name": "bg_wait",
    "description": "Wait for background subagents (default: all running) and return their answers, which then do not arrive again as messages.",
    "input_schema": {
      "type": "object",
      "properties": {
        "ids": { "type": "array", "items": { "type": "string" }, "description": "e.g. ['sa-1']" },
        "timeout": { "type": "integer", "description": "Seconds, default 600" }
      }
    }
  },
  {
    "name": "bg_start",
    "description": "Start a long-running `sh -c` command in the background and return its id at once; its final output arrives as a message when it exits. No stdin. Output is tail-truncated and names its full log. Max 8 at once; killed when the agent exits.",
    "input_schema": {
      "type": "object",
      "required": ["command", "title"],
      "properties": {
        "command": { "type": "string" },
        "title": { "type": "string", "description": "Short name for listings" },
        "working_dir": { "type": "string", "description": "Default: current directory" }
      }
    }
  },
  {
    "name": "bg_status",
    "description": "A background terminal's status and output tail, without blocking.",
    "input_schema": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "description": "Terminal id, e.g. \"bt-1\"" } }
    }
  },
  {
    "name": "bg_list",
    "description": "List background terminals with pid, elapsed time, exit status and output sizes.",
    "input_schema": { "type": "object", "properties": {} }
  },
  {
    "name": "bg_kill",
    "description": "Stop background terminals: SIGTERM to the process group, SIGKILL after 2s. Returns each final state.",
    "input_schema": {
      "type": "object",
      "required": ["ids"],
      "properties": { "ids": { "type": "array", "items": { "type": "string" }, "description": "Terminal ids to stop, e.g. [\"bt-1\"]" } }
    }
  },
  {
    "name": "ask_user_question",
    "description": "Ask the user structured questions for preferences, unclear instructions or decisions. A \"Type something.\" row for a custom answer is added to every question; never write \"Other\", \"Next\" or \"Type something.\" labels yourself. Put a recommended option first with \"(Recommended)\" at the end of its label. Use `preview` (markdown in a monospace box, single-select only) only to compare concrete artifacts such as mockups or code.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question",
              "header",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string",
                "description": "Clear, specific question ending with a question mark"
              },
              "header": {
                "type": "string",
                "maxLength": 16,
                "description": "Short chip, e.g. \"Auth method\""
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "description"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 60,
                      "description": "1-5 words"
                    },
                    "description": {
                      "type": "string",
                      "description": "What choosing it means, trade-offs"
                    },
                    "preview": {
                      "type": "string",
                      "description": "Shown when the option is focused"
                    }
                  }
                },
                "minItems": 2,
                "maxItems": 4,
                "description": "Distinct choices, mutually exclusive unless multiSelect"
              },
              "multiSelect": {
                "type": "boolean",
                "default": false,
                "description": "Allow several answers"
              }
            }
          },
          "minItems": 1,
          "maxItems": 4
        }
      },
      "required": [
        "questions"
      ]
    }
  },
  {
    "name": "rg",
    "description": "Search file contents with ripgrep: smart-case, respects .gitignore, at most 100 matches per file by default. Rows are `path:anchor│line` (match) and `path-anchor│line` (context); the anchors work in the edit tools without a read. Output is capped at 2000 lines or 50KB.",
    "eager_input_streaming": true,
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regex, or literal with fixed_strings."
        },
        "path": {
          "type": "string",
          "description": "Default: current directory."
        },
        "glob": {
          "type": "string",
          "description": "e.g. '*.ts' or 'src/**'."
        },
        "file_type": {
          "type": "string",
          "description": "ripgrep type, e.g. 'ts', 'rust'."
        },
        "case_sensitive": {
          "type": "boolean",
          "description": "Default: smart-case."
        },
        "fixed_strings": {
          "type": "boolean",
          "description": "Literal pattern."
        },
        "hidden": {
          "type": "boolean",
          "description": "Include hidden files."
        },
        "context": {
          "type": "integer",
          "description": "Context lines around each match.",
          "maximum": 20,
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "description": "Max matches per file, default 100.",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "pattern"
      ]
    }
  },
  {
    "name": "web_search",
    "description": "Search the web and return bounded, source-linked results or provider answers. Full results are stored for retrieval with get_search_content using the returned responseId.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": { "type": "string" },
        "queries": { "type": "array", "items": { "type": "string" }, "maxItems": 8, "description": "Up to 8, searched concurrently; vary the angles." },
        "numResults": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Per query, default 5." },
        "includeContent": { "type": "boolean", "description": "Also fetch the result pages." },
        "recencyFilter": { "type": "string", "enum": ["day", "week", "month", "year"] },
        "domainFilter": { "type": "array", "items": { "type": "string" }, "description": "Prefix - to exclude." },
        "category": { "type": "string", "description": "Exa only, e.g. news, research paper." },
        "provider": {
          "anyOf": [
            { "type": "string", "enum": ["auto", "all", "xai", "exa", "brave", "tavily", "perplexity", "jina"] },
            { "type": "array", "items": { "type": "string", "enum": ["xai", "exa", "brave", "tavily", "perplexity", "jina"] }, "minItems": 1 }
          ],
          "description": "Omit for the configured one; all or a list searches several."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "fetch_content",
    "description": "Fetch web pages or GitHub repositories; full content is kept for get_search_content by the returned responseId.",
    "input_schema": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "urls": { "type": "array", "items": { "type": "string" }, "description": "Fetched in parallel." },
        "mode": { "type": "string", "enum": ["readable", "raw"], "description": "readable (default) extracts markdown; raw returns the body via direct HTTP." },
        "forceClone": { "type": "boolean", "description": "Re-clone a cached GitHub repository." }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_search_content",
    "description": "Page through stored content of a web_search, fetch_content or source_check call, or find passages with findText.",
    "input_schema": {
      "type": "object",
      "properties": {
        "responseId": { "type": "string" },
        "query": { "type": "string", "description": "Select by search query." },
        "queryIndex": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "description": "Select by URL." },
        "urlIndex": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0, "description": "Characters; ignored with findText." },
        "limit": { "type": "integer", "minimum": 1, "maximum": 30000, "description": "Characters, default 30000; ignored with findText." },
        "findText": {
          "anyOf": [
            { "type": "string", "minLength": 1, "maxLength": 500 },
            { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "minItems": 1, "maxItems": 10 }
          ]
        },
        "findMode": { "type": "string", "enum": ["exact", "case-insensitive", "fuzzy"], "description": "Default case-insensitive." }
      },
      "required": ["responseId"],
      "additionalProperties": false
    }
  },
  {
    "name": "source_check",
    "description": "Gather web sources for a claim; returns exact passage citations for manual review.",
    "input_schema": {
      "type": "object",
      "properties": {
        "claim": { "type": "string" },
        "queries": { "type": "array", "items": { "type": "string" }, "maxItems": 8, "description": "Up to 8; default: the claim." },
        "numResults": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Per query, default 5." },
        "fetchContent": { "type": "boolean", "description": "Fetch up to 5 pages for exact passages." },
        "recencyFilter": { "type": "string", "enum": ["day", "week", "month", "year"] },
        "domainFilter": { "type": "array", "items": { "type": "string" }, "description": "Prefix - to exclude." },
        "provider": {
          "anyOf": [
            { "type": "string", "enum": ["auto", "all", "xai", "exa", "brave", "tavily", "perplexity", "jina"] },
            { "type": "array", "items": { "type": "string", "enum": ["xai", "exa", "brave", "tavily", "perplexity", "jina"] }, "minItems": 1 }
          ],
          "description": "Omit for the configured one; all or a list searches several."
        }
      },
      "required": ["claim"],
      "additionalProperties": false
    }
  }
]
